# Only the pack's own work is published: everything else (mods, servers, worlds, tools with passwords, the Java
# runtime, logs) stays on this computer. The work journal (ПРОГРЕС.md) and the Crafty deploy helpers are published.
/*
!/.gitignore
!/README.md
!/ПРОГРЕС.md
!/pack/
!/mods-src/
!/docs/
!/launcher/
!/AGENTS.md
!/CLAUDE.md
!/PROJECT_MAP.md
!/.graphifyignore
!/graphify-out/

# copies of other mods' English texts and leftovers of removed mods
/pack/_removed/
/pack/i18n/src/
/pack/i18n/ref/
/pack/i18n/batches/
# other mods' structure templates with fixed attribute names, for servers only (pack/tools/fix_structure_attributes.py)
/pack/overrides-server/

# generated and cached
**/__pycache__/
**/.cache/
/mods-src/*/build/
/launcher/dist/
**/bin/
**/obj/
*.jar
*.log


# the knowledge graph: only the graph and its report are shared (graph.html is big and made locally, the rest is per-machine)
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
