<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>WildsAndWanderers</AssemblyName>
    <RootNamespace>Wilds.Launcher</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>Wilds &amp; Wanderers</Product>
    <AssemblyTitle>Wilds &amp; Wanderers — встановлення й оновлення збірки</AssemblyTitle>
    <Description>Встановлює й оновлює збірку Wilds &amp; Wanderers для офіційного лаунчера Minecraft</Description>
    <Company>Volodymyr Holovan</Company>
    <Authors>Volodymyr Holovan</Authors>
    <Copyright>© 2026 Volodymyr Holovan</Copyright>
    <NeutralLanguage>uk-UA</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>uk</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\background.png" />
  </ItemGroup>
</Project>
