<Window x:Class="Wilds.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wilds &amp; Wanderers" Width="1040" Height="640" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" WindowStyle="None"
        Background="#0B1013" Icon="Assets/icon.png" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid TextElement.Foreground="{StaticResource Text}">
        <Image Source="Assets/background.png" Stretch="UniformToFill" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <Image Source="Assets/icon.png" Width="22" Height="22" Margin="14,0,8,0" DockPanel.Dock="Left" />
                <TextBlock Text="Wilds &amp; Wanderers" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <Button Style="{StaticResource CloseButton}" Content="✕" DockPanel.Dock="Right" Click="OnClose"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Закрити" />
                <Button Style="{StaticResource ChromeButton}" Content="—" DockPanel.Dock="Right" Click="OnMinimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Згорнути" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <!-- the pack, the news, the button -->
                <Grid Margin="56,18,32,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PackTitle" Text="Wilds &amp; Wanderers" FontFamily="{StaticResource Serif}" FontSize="48"
                               Foreground="{StaticResource Gold}">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.6" Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Grid.Row="1" Text="Українська збірка пригод · Minecraft 1.21.1 · NeoForge" FontSize="15"
                               Foreground="{StaticResource Muted}" Margin="2,4,0,0" />

                    <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                            CornerRadius="10" Padding="20,16" Margin="0,24,40,24" VerticalAlignment="Top" x:Name="NewsCard" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="НОВИНИ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,0,0,8" />
                            <ItemsControl x:Name="News">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="•" Foreground="{StaticResource Gold}" FontSize="14" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="14" LineHeight="20" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3">
                        <TextBlock x:Name="StatusText" Text="Перевірка збірки…" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Minimum="0" Maximum="1" IsIndeterminate="True" Margin="0,0,40,18" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="ГРАТИ" Height="62" MinWidth="260"
                                    IsEnabled="False" Click="OnPlay" />
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="VerifyButton" Style="{StaticResource LinkButton}" Content="⟳  Перевірити всі файли" Click="OnVerify" IsEnabled="False"
                                        ToolTip="Звірити кожен файл збірки й завантажити пошкоджені чи відсутні" />
                                <Button Style="{StaticResource LinkButton}" Content="📁  Відкрити теку гри" Click="OnOpenFolder"
                                        ToolTip="Тека зі світами, знімками екрана, налаштуваннями й модами" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- settings -->
                <Border Grid.Column="1" Background="{StaticResource Card}" BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                        CornerRadius="12" Margin="0,18,26,26" Padding="22,18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ГРАФІКА" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,0,0,10" />
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="ПАМ'ЯТЬ ДЛЯ ГРИ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,8,0,6" />
                            <DockPanel>
                                <TextBlock x:Name="MemoryText" DockPanel.Dock="Right" Text="6 ГБ" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Right" />
                                <Slider x:Name="MemorySlider" Style="{StaticResource Slim}" Minimum="3" Maximum="16" Value="6" VerticalAlignment="Center"
                                        ValueChanged="OnMemoryChanged" />
                            </DockPanel>
                            <TextBlock x:Name="MemoryHint" FontSize="12" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,14,0,10" />
                            <Button x:Name="ServerButton" Style="{StaticResource LinkButton}" Click="OnCopyServer" Padding="0" Margin="-10,0,0,0"
                                    ToolTip="Сервер уже додано в список серверів гри. Клацніть, щоб скопіювати адресу." />
                        </StackPanel>
                        <StackPanel x:Name="PresetList" />
                    </DockPanel>
                </Border>
            </Grid>

            <DockPanel Grid.Row="2" Margin="56,0,26,10" LastChildFill="False">
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource Faint}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                           Text="Входьте у грі через свій акаунт Minecraft" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
