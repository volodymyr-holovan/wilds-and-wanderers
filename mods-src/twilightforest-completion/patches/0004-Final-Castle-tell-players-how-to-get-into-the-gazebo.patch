diff --git a/src/main/java/twilightforest/world/components/structures/finalcastle/FinalCastleHints.java b/src/main/java/twilightforest/world/components/structures/finalcastle/FinalCastleHints.java
new file mode 100644
index 000000000..024330ab8
--- /dev/null
+++ b/src/main/java/twilightforest/world/components/structures/finalcastle/FinalCastleHints.java
@@ -0,0 +1,224 @@
+package twilightforest.world.components.structures.finalcastle;
+
+import com.mojang.brigadier.exceptions.CommandSyntaxException;
+import net.minecraft.ChatFormatting;
+import net.minecraft.advancements.AdvancementHolder;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.particles.ParticleTypes;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.TagParser;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.chat.MutableComponent;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.sounds.SoundEvents;
+import net.minecraft.sounds.SoundSource;
+import net.minecraft.world.entity.Display;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.levelgen.structure.Structure;
+import net.minecraft.world.phys.AABB;
+import net.neoforged.neoforge.event.entity.player.AdvancementEvent;
+import net.neoforged.neoforge.event.entity.player.PlayerInteractEvent;
+import twilightforest.TwilightForestMod;
+import twilightforest.block.ForceFieldBlock;
+import twilightforest.init.TFBlocks;
+import twilightforest.init.TFItems;
+import twilightforest.init.TFSounds;
+import twilightforest.init.TFStructures;
+import twilightforest.util.landmarks.LandmarkUtil;
+
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Tells players how to get into the Rune Sovereign's gazebo (Wilds &amp; Wanderers completion of the castle).
+ * <p>
+ * The way in is a chain: the Forge Harbinger in the forge gives a Talisman of the Cube, the talisman catches a Roving
+ * Cube standing in a circle of redstone and turns it into a Cube of Annihilation, and only that cube erases the violet
+ * force field. Nothing in the castle said so, so players stood at the field with no idea what to do. Now:
+ * <ul>
+ *     <li>text above the gazebo's spawner names the chain (placed by {@link #tickSpawner}, gone once the boss wakes);</li>
+ *     <li>coming up to the gazebo, or clicking any force field of the castle, gives the player's own next step in the
+ *     action bar and in chat, with a sound and a puff of particles;</li>
+ *     <li>entering the castle for the first time explains the whole way in chat.</li>
+ * </ul>
+ */
+public final class FinalCastleHints {
+
+	public static final String HINT_TAG = "twilightforest_final_castle_hint";
+	private static final String KEY = "gui.twilightforest.final_castle.";
+
+	/** Game time until which a player hears nothing more in the action bar / in chat. */
+	private static final Map<UUID, Long> BAR_QUIET = new ConcurrentHashMap<>();
+	private static final Map<UUID, Long> CHAT_QUIET = new ConcurrentHashMap<>();
+	/** Players near a gazebo at the last look, to speak once on arrival rather than every second. */
+	private static final Map<UUID, Long> NEAR_GAZEBO = new ConcurrentHashMap<>();
+
+	private static final int BAR_COOLDOWN = 40, CHAT_COOLDOWN = 20 * 60;
+
+	private FinalCastleHints() {
+	}
+
+	/** What a player still has to do to get into the gazebo. */
+	public enum Step {
+		FORGE, CUBE, BREAK;
+
+		MutableComponent chat() {
+			return Component.translatable(KEY + "step." + this.name().toLowerCase(Locale.ROOT));
+		}
+	}
+
+	public static Step stepFor(Player player) {
+		if (carries(player, TFItems.CUBE_OF_ANNIHILATION.get())) return Step.BREAK;
+		if (carries(player, TFItems.CUBE_TALISMAN.get())) return Step.CUBE;
+		return Step.FORGE;
+	}
+
+	private static boolean carries(Player player, Item item) {
+		return player.getInventory().hasAnyMatching(stack -> stack.is(item));
+	}
+
+	private static boolean hasAdvancement(ServerPlayer player, String name) {
+		AdvancementHolder holder = player.server.getAdvancements().get(TwilightForestMod.prefix(name));
+		return holder != null && player.getAdvancements().getOrStartProgress(holder).isDone();
+	}
+
+	/**
+	 * Says the player's next step: a short line in the action bar (every couple of seconds at most) and the full step
+	 * in chat (once a minute at most).
+	 */
+	private static void tell(ServerPlayer player, Component bar) {
+		long now = player.level().getGameTime();
+		UUID id = player.getUUID();
+		if (BAR_QUIET.getOrDefault(id, Long.MIN_VALUE) <= now) {
+			BAR_QUIET.put(id, now + BAR_COOLDOWN);
+			player.displayClientMessage(bar.copy().withStyle(ChatFormatting.LIGHT_PURPLE), true);
+		}
+		if (CHAT_QUIET.getOrDefault(id, Long.MIN_VALUE) <= now) {
+			CHAT_QUIET.put(id, now + CHAT_COOLDOWN);
+			player.sendSystemMessage(stepFor(player).chat().withStyle(ChatFormatting.LIGHT_PURPLE));
+		}
+	}
+
+	// ---- force fields
+
+	public static void onRightClickBlock(PlayerInteractEvent.RightClickBlock event) {
+		// throwing the cube at the field is the right thing to do: say nothing over it
+		if (event.getItemStack().is(TFItems.CUBE_OF_ANNIHILATION.get())) return;
+		touchedField(event.getEntity(), event.getPos());
+	}
+
+	public static void onLeftClickBlock(PlayerInteractEvent.LeftClickBlock event) {
+		if (event.getAction() != PlayerInteractEvent.LeftClickBlock.Action.START) return;
+		touchedField(event.getEntity(), event.getPos());
+	}
+
+	private static void touchedField(Player who, BlockPos pos) {
+		if (!(who instanceof ServerPlayer player) || !(player.level() instanceof ServerLevel level)) return;
+		BlockState state = level.getBlockState(pos);
+		if (!(state.getBlock() instanceof ForceFieldBlock) || !inCastle(level, pos)) return;
+
+		long now = level.getGameTime();
+		if (BAR_QUIET.getOrDefault(player.getUUID(), Long.MIN_VALUE) > now) return;
+
+		boolean gazebo = state.is(TFBlocks.VIOLET_FORCE_FIELD.get());
+		level.playSound(null, pos, TFSounds.DOOR_ACTIVATED.get(), SoundSource.BLOCKS, 0.8F, 0.3F);
+		level.sendParticles(player, gazebo ? ParticleTypes.WITCH : ParticleTypes.ENCHANT, false,
+			pos.getX() + 0.5D, pos.getY() + 0.5D, pos.getZ() + 0.5D, 12, 0.4D, 0.4D, 0.4D, 0.05D);
+
+		if (gazebo) {
+			tell(player, Component.translatable(KEY + "hint.field"));
+		} else {
+			// the other fields are walls and windows: the way on is through the castle's doors
+			BAR_QUIET.put(player.getUUID(), now + BAR_COOLDOWN);
+			player.displayClientMessage(Component.translatable(KEY + "field.door").withStyle(ChatFormatting.LIGHT_PURPLE), true);
+		}
+	}
+
+	private static boolean inCastle(ServerLevel level, BlockPos pos) {
+		Structure castle = LandmarkUtil.structureForKey(level, TFStructures.FINAL_CASTLE);
+		return castle != null && level.structureManager().getStructureWithPieceAt(pos, castle).isValid();
+	}
+
+	// ---- entering the castle
+
+	public static void onAdvancement(AdvancementEvent.AdvancementEarnEvent event) {
+		if (event.getAdvancement().id().equals(TwilightForestMod.prefix("progress_castle")) && event.getEntity() instanceof ServerPlayer player) {
+			player.sendSystemMessage(Component.translatable(KEY + "entered").withStyle(ChatFormatting.GRAY, ChatFormatting.ITALIC));
+		}
+	}
+
+	// ---- the gazebo
+
+	/** Called by the gazebo's spawner on the server every tick while it waits for a player. */
+	public static void tickSpawner(ServerLevel level, BlockPos spawner) {
+		long now = level.getGameTime();
+		if (now % 20L != Math.floorMod(spawner.asLong(), 20L)) return;
+		// entities of a chunk come a moment after it; looking for the text before that would place it twice
+		if (!level.areEntitiesLoaded(ChunkPos.asLong(spawner))) return;
+
+		if (now % 200L < 20L && hints(level, spawner).isEmpty()) placeHints(level, spawner);
+
+		for (ServerPlayer player : level.players()) {
+			if (player.isSpectator() || !player.isAlive()) continue;
+			double dx = Math.abs(player.getX() - (spawner.getX() + 0.5D));
+			double dz = Math.abs(player.getZ() - (spawner.getZ() + 0.5D));
+			double dy = player.getY() - spawner.getY();
+			boolean near = dx < 22.0D && dz < 22.0D && dy > -6.0D && dy < 14.0D && (dx >= 9.5D || dz >= 9.5D);
+			UUID id = player.getUUID();
+			if (!near) {
+				NEAR_GAZEBO.remove(id);
+				continue;
+			}
+			if (NEAR_GAZEBO.put(id, now) != null) continue;
+			if (hasAdvancement(player, "progress_final")) continue;
+			player.playNotifySound(SoundEvents.BEACON_AMBIENT, SoundSource.BLOCKS, 0.6F, 0.6F);
+			tell(player, Component.translatable(KEY + "hint.field"));
+		}
+	}
+
+	private static List<Entity> hints(ServerLevel level, BlockPos spawner) {
+		AABB box = new AABB(spawner).inflate(1.0D, 0.0D, 1.0D).expandTowards(0.0D, 4.0D, 0.0D);
+		return level.getEntities((Entity) null, box, e -> e instanceof Display.TextDisplay && e.getTags().contains(HINT_TAG));
+	}
+
+	/** The text of the hint, as one display: separate ones wrap at their own width and run into each other. */
+	private static final String DISPLAY_NBT = "{id:\"minecraft:text_display\",billboard:\"vertical\",line_width:330,background:-1342177280,"
+		+ "brightness:{sky:15,block:15},view_range:0.75f,transformation:{left_rotation:[0f,0f,0f,1f],right_rotation:[0f,0f,0f,1f],"
+		+ "translation:[0f,0f,0f],scale:[1.4f,1.4f,1.4f]}}";
+
+	private static void placeHints(ServerLevel level, BlockPos spawner) {
+		// siblings take the style of the component they are appended to: the title is a sibling too, not the root
+		MutableComponent text = Component.empty();
+		text.append(Component.translatable(KEY + "hint.title").withStyle(ChatFormatting.LIGHT_PURPLE, ChatFormatting.BOLD));
+		for (String line : new String[]{"hint.field", "hint.cube", "hint.talisman"}) {
+			text.append("\n").append(Component.translatable(KEY + line));
+		}
+		CompoundTag tag;
+		try {
+			tag = TagParser.parseTag(DISPLAY_NBT);
+		} catch (CommandSyntaxException e) {
+			throw new IllegalStateException(e);
+		}
+		tag.putString("text", Component.Serializer.toJson(text, level.registryAccess()));
+		EntityType.create(tag, level).ifPresent(display -> {
+			display.addTag(HINT_TAG);
+			// the text grows upwards from here: four lines at this scale reach about two blocks up
+			display.moveTo(spawner.getX() + 0.5D, spawner.getY() + 1.4D, spawner.getZ() + 0.5D, 0.0F, 0.0F);
+			level.addFreshEntity(display);
+		});
+	}
+
+	/** The boss is awake: the text has done its job. */
+	public static void removeHints(ServerLevel level, BlockPos spawner) {
+		hints(level, spawner).forEach(Entity::discard);
+	}
+}
