+/**
+ * The Rune Sovereign (Wilds &amp; Wanderers completion of the Final Castle): a floating figure in a white robe that widens
+ * to a hem above the ground, gold pauldrons, a deep hood with glowing eyes, a violet cape, a ring of rune cubes above
+ * its head and a rune staff. The geometry is written by mods-src/twilightforest-completion/tools/make_models.py together
+ * with the texture, so the two always match.
+ * <p>
+ * Poses: it floats with its arms a little apart and the halo turning; it raises the staff to cast; with its wards up it
+ * spreads its arms and the halo spins fast; stunned, it slumps forward with its arms hanging.
+ */
+public class RuneSovereignModel extends HierarchicalModel<PlateauBoss> {
+
+	private final ModelPart root;
+	private final ModelPart body;
+	private final ModelPart hem;
+	private final ModelPart cape;
