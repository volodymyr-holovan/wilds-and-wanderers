+		PartDefinition right_arm = body.addOrReplaceChild("right_arm", CubeListBuilder.create()
+				.texOffs(20, 51).addBox(-4.0F, -2.5F, -4.0F, 6.0F, 4.0F, 8.0F)
+				.texOffs(98, 32).addBox(-3.5F, 1.0F, -2.5F, 5.0F, 12.0F, 5.0F)
