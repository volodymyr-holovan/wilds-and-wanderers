+package twilightforest.client.model.entity;
+
+import net.minecraft.client.model.HierarchicalModel;
+import net.minecraft.client.model.geom.ModelPart;
+import net.minecraft.client.model.geom.PartPose;
+import net.minecraft.client.model.geom.builders.CubeListBuilder;
+import net.minecraft.client.model.geom.builders.LayerDefinition;
+import net.minecraft.client.model.geom.builders.MeshDefinition;
+import net.minecraft.client.model.geom.builders.PartDefinition;
+import net.minecraft.util.Mth;
+import twilightforest.entity.boss.ForgeHarbinger;
+
+/**
+ * The Forge Harbinger (Wilds &amp; Wanderers completion of the Final Castle): a walking forge. A charred iron body with
+ * molten seams, riveted side plates, a fire grate for a mouth, an anvil for a back with a chimney, four stumpy clawed
+ * legs. Drawn at half size (the renderer doubles it). Geometry from make_models.py, like the texture.
+ * <p>
+ * Poses: a heavy walk; before a charge it crouches with its legs braced; charging it leans in; stunned it sags to one
+ * side with its legs splayed.
+ */
+public class ForgeHarbingerModel extends HierarchicalModel<ForgeHarbinger> {
+
+	private final ModelPart root;
+	private final ModelPart body;
+	private final ModelPart chimney;
+	private final ModelPart frontRight;
+	private final ModelPart frontLeft;
+	private final ModelPart backRight;
+	private final ModelPart backLeft;
+
+	public ForgeHarbingerModel(ModelPart root) {
+		this.root = root;
+		this.body = root.getChild("body");
+		this.chimney = this.body.getChild("anvil").getChild("chimney");
+		this.frontRight = root.getChild("leg_front_right");
+		this.frontLeft = root.getChild("leg_front_left");
+		this.backRight = root.getChild("leg_back_right");
+		this.backLeft = root.getChild("leg_back_left");
+	}
+
+	public static LayerDefinition create() {
+		// ---- generated by make_models.py
+		MeshDefinition mesh = new MeshDefinition();
+		PartDefinition root = mesh.getRoot();
+		PartDefinition body = root.addOrReplaceChild("body", CubeListBuilder.create()
+				.texOffs(0, 0).addBox(-13.0F, -20.0F, -13.0F, 26.0F, 20.0F, 26.0F),
+			PartPose.offset(0.0F, 16.0F, 0.0F));
+		PartDefinition mouth = body.addOrReplaceChild("mouth", CubeListBuilder.create()
+				.texOffs(204, 46).addBox(-10.0F, -7.0F, -1.0F, 20.0F, 11.0F, 1.0F),
+			PartPose.offset(0.0F, -9.0F, -13.0F));
+		PartDefinition plates = body.addOrReplaceChild("plates", CubeListBuilder.create()
+				.texOffs(216, 0).addBox(-14.0F, -17.0F, -9.0F, 1.0F, 12.0F, 18.0F)
+				.texOffs(0, 46).mirror().addBox(13.0F, -17.0F, -9.0F, 1.0F, 12.0F, 18.0F)
+				.texOffs(166, 46).addBox(-9.0F, -17.0F, 13.0F, 18.0F, 12.0F, 1.0F),
+			PartPose.offset(0.0F, 0.0F, 0.0F));
+		PartDefinition anvil = body.addOrReplaceChild("anvil", CubeListBuilder.create()
+				.texOffs(104, 0).addBox(-14.0F, -3.0F, -14.0F, 28.0F, 3.0F, 28.0F),
+			PartPose.offset(0.0F, -20.0F, 0.0F));
+		PartDefinition chimney = anvil.addOrReplaceChild("chimney", CubeListBuilder.create()
+				.texOffs(0, 76).addBox(-3.0F, -4.0F, -3.0F, 6.0F, 4.0F, 6.0F),
+			PartPose.offset(6.0F, -3.0F, 7.0F));
+		PartDefinition horn = anvil.addOrReplaceChild("horn", CubeListBuilder.create()
+				.texOffs(24, 76).addBox(-2.0F, -3.0F, -2.0F, 4.0F, 3.0F, 4.0F),
+			PartPose.offset(-8.0F, -3.0F, 8.0F));
+		PartDefinition leg_front_right = root.addOrReplaceChild("leg_front_right", CubeListBuilder.create()
+				.texOffs(38, 46).addBox(-4.0F, 0.0F, -4.0F, 8.0F, 8.0F, 8.0F),
+			PartPose.offset(-9.0F, 16.0F, -9.0F));
+		PartDefinition leg_front_left = root.addOrReplaceChild("leg_front_left", CubeListBuilder.create()
+				.texOffs(70, 46).addBox(-4.0F, 0.0F, -4.0F, 8.0F, 8.0F, 8.0F),
+			PartPose.offset(9.0F, 16.0F, -9.0F));
+		PartDefinition leg_back_right = root.addOrReplaceChild("leg_back_right", CubeListBuilder.create()
+				.texOffs(102, 46).addBox(-4.0F, 0.0F, -4.0F, 8.0F, 8.0F, 8.0F),
+			PartPose.offset(-9.0F, 16.0F, 9.0F));
+		PartDefinition leg_back_left = root.addOrReplaceChild("leg_back_left", CubeListBuilder.create()
+				.texOffs(134, 46).addBox(-4.0F, 0.0F, -4.0F, 8.0F, 8.0F, 8.0F),
+			PartPose.offset(9.0F, 16.0F, 9.0F));
+		return LayerDefinition.create(mesh, 256, 128);
+		// ---- end of generated
+	}
+
+	@Override
+	public ModelPart root() {
+		return this.root;
+	}
+
+	@Override
+	public void setupAnim(ForgeHarbinger entity, float limbSwing, float limbSwingAmount, float ageInTicks, float netHeadYaw, float headPitch) {
+		this.root().getAllParts().forEach(ModelPart::resetPose);
+		float swing = Mth.cos(limbSwing * 0.5F) * 0.9F * limbSwingAmount;
+		this.frontRight.xRot = swing;
+		this.backLeft.xRot = swing;
+		this.frontLeft.xRot = -swing;
+		this.backRight.xRot = -swing;
+		// the heavy body rolls with each step
+		this.body.zRot = Mth.sin(limbSwing * 0.5F) * 0.04F * limbSwingAmount;
+		this.body.y += Math.abs(Mth.sin(limbSwing * 0.5F)) * 0.8F * limbSwingAmount;
+		this.chimney.y += Mth.sin(ageInTicks * 0.3F) * 0.15F;
+
+		ForgeHarbinger.AnimState state = entity.getAnimState();
+		float blow = entity.getAttackAnim(ageInTicks - (int) ageInTicks);
+		float ember = entity.getEmberFlash(ageInTicks - (int) ageInTicks);
+		DebugPose pose = DebugPose.of(entity);
+		if (pose != null) {
+			switch (pose.name()) {
+				case "attack" -> blow = pose.progress();
+				case "ember" -> ember = pose.progress();
+				default -> {
+					try {
+						state = ForgeHarbinger.AnimState.valueOf(pose.name().toUpperCase(java.util.Locale.ROOT));
+					} catch (IllegalArgumentException ignored) {
+					}
+				}
+			}
+		}
+		// a melee blow: the body lunges, the front legs come up
+		if (blow > 0.0F) {
+			float k = Mth.sin(blow * Mth.PI);
+			this.body.xRot += 0.25F * k;
+			this.frontRight.xRot -= 0.8F * k;
+			this.frontLeft.xRot -= 0.8F * k;
+		}
+		// embers: the body recoils from its own fire
+		this.body.xRot -= 0.15F * ember;
+
+		switch (state) {
+			case TELEGRAPH -> {
+				this.body.y += 1.5F;
+				this.body.xRot = 0.08F;
+				this.frontRight.zRot = 0.2F;
+				this.backRight.zRot = 0.2F;
+				this.frontLeft.zRot = -0.2F;
+				this.backLeft.zRot = -0.2F;
+			}
+			case CHARGE -> this.body.xRot = 0.2F;
+			case STUNNED -> {
+				this.body.y += 2.0F;
+				this.body.zRot = 0.2F;
+				this.body.xRot = -0.05F;
+				this.frontRight.zRot = 0.4F;
+				this.backRight.zRot = 0.4F;
+				this.frontLeft.zRot = -0.4F;
+				this.backLeft.zRot = -0.4F;
+			}
+			default -> {
+			}
+		}
+	}
+}
