+	@Override
+	public void setupAnim(PlateauBoss entity, float limbSwing, float limbSwingAmount, float ageInTicks, float netHeadYaw, float headPitch) {
+		this.root().getAllParts().forEach(ModelPart::resetPose);
+		float t = ageInTicks;
+		float partial = t - (int) t;
+		PlateauBoss.Gesture gesture = entity.getGesture();
+		float a = entity.getCastAmount(partial);
+		float p = entity.getGestureProgress(partial);
+		boolean shielded = entity.isShielded();
+		boolean stunned = entity.isStunned();
+		DebugPose pose = DebugPose.of(entity);
+		if (pose != null) {
+			switch (pose.name()) {
+				case "shield" -> shielded = true;
+				case "stunned" -> stunned = true;
+				default -> {
+					try {
+						gesture = PlateauBoss.Gesture.valueOf(pose.name().toUpperCase(java.util.Locale.ROOT));
+						p = pose.progress();
+						a = p < 0.25F ? p / 0.25F : p > 0.75F ? (1.0F - p) / 0.25F : 1.0F;
+					} catch (IllegalArgumentException ignored) {
+					}
+				}
+			}
+		}
+
+		this.head.yRot = netHeadYaw * Mth.DEG_TO_RAD;
+		this.head.xRot = headPitch * Mth.DEG_TO_RAD * 0.5F;
+
+		// floating: the robe and cape stir, the arms drift, the halo turns
+		this.hem.xRot = Mth.sin(t * 0.07F) * 0.06F;
+		this.hem.zRot = Mth.cos(t * 0.05F) * 0.04F;
+		this.cape.xRot = 0.08F + Mth.sin(t * 0.06F) * 0.05F;
+		this.rightArm.zRot = 0.12F + Mth.sin(t * 0.08F) * 0.05F;
+		this.leftArm.zRot = -0.12F - Mth.sin(t * 0.08F) * 0.05F;
+		this.rightArm.xRot = -0.15F;
+		this.leftArm.xRot = Mth.sin(t * 0.06F) * 0.08F;
+		this.halo.yRot = t * 0.05F;
+
+		if (shielded) {
+			// arms spread, holding the wards in their orbit
+			this.rightArm.zRot = 1.0F + Mth.sin(t * 0.2F) * 0.05F;
+			this.leftArm.zRot = -1.0F - Mth.sin(t * 0.2F) * 0.05F;
+			this.rightArm.xRot = -0.35F;
+			this.leftArm.xRot = -0.35F;
+			this.halo.yRot = t * 0.25F;
+		}
+
+		switch (gesture) {
+			case VOLLEY -> {
+				// the staff levelled at the target like a wand, the other hand pushing the runes after it
+				this.rightArm.xRot = Mth.lerp(a, this.rightArm.xRot, -Mth.HALF_PI);
+				this.rightArm.zRot = Mth.lerp(a, this.rightArm.zRot, 0.0F);
+				this.staff.xRot = (Mth.PI - 0.3F) * a;
+				float push = p > 0.35F && p < 0.6F ? Mth.sin((p - 0.35F) / 0.25F * Mth.PI) : 0.0F;
+				this.leftArm.xRot = Mth.lerp(a, this.leftArm.xRot, -1.25F - push * 0.3F);
+				this.leftArm.zRot = Mth.lerp(a, this.leftArm.zRot, 0.25F);
+				this.body.xRot = 0.12F * a + push * 0.08F;
+				this.head.xRot += 0.15F * a;
+			}
+			case CIRCLE -> {
+				// both hands raise the staff overhead, then strike it down at the ground
+				float strike = p < 0.5F ? 0.0F : Math.min(1.0F, (p - 0.5F) / 0.15F);
+				float arm = Mth.lerp(strike, -2.9F, -0.6F);
+				this.rightArm.xRot = Mth.lerp(a, this.rightArm.xRot, arm);
+				this.leftArm.xRot = Mth.lerp(a, this.leftArm.xRot, arm);
+				this.rightArm.zRot = Mth.lerp(a, this.rightArm.zRot, -0.25F);
+				this.leftArm.zRot = Mth.lerp(a, this.leftArm.zRot, 0.25F);
+				this.staff.xRot = Mth.PI * a;
+				this.body.xRot = Mth.lerp(strike, -0.12F, 0.3F) * a;
+				this.head.xRot += 0.3F * strike * a;
+			}
+			case SUMMON -> {
+				// arms flung up and apart, head back, the halo racing
+				this.rightArm.zRot = Mth.lerp(a, this.rightArm.zRot, 2.3F);
+				this.leftArm.zRot = Mth.lerp(a, this.leftArm.zRot, -2.3F);
+				this.rightArm.xRot = Mth.lerp(a, this.rightArm.xRot, -0.3F);
+				this.leftArm.xRot = Mth.lerp(a, this.leftArm.xRot, -0.3F);
+				this.body.xRot = -0.15F * a;
+				this.head.xRot -= 0.4F * a;
+				this.halo.yRot = t * (0.05F + 0.4F * a);
+			}
+			default -> {
+				// drifting: lean into the movement
+				float dx = (float) (entity.getX() - entity.xo), dz = (float) (entity.getZ() - entity.zo);
+				float yaw = entity.yBodyRot * Mth.DEG_TO_RAD;
+				float forward = -Mth.sin(yaw) * dx + Mth.cos(yaw) * dz;
+				float side = Mth.cos(yaw) * dx + Mth.sin(yaw) * dz;
+				this.body.xRot = Mth.clamp(forward * 1.5F, -0.2F, 0.2F);
+				this.body.zRot = Mth.clamp(-side * 1.5F, -0.15F, 0.15F);
+			}
+		}
+
+		if (stunned) {
+			this.body.xRot = 0.38F;
+			this.head.xRot = 0.55F;
+			this.head.yRot = 0.0F;
+			this.rightArm.xRot = -0.25F;
+			this.leftArm.xRot = -0.25F;
+			this.rightArm.zRot = 0.05F;
+			this.leftArm.zRot = -0.05F;
+			this.halo.y += 3.0F;
+			this.halo.xRot = 0.3F;
+			this.halo.yRot = t * 0.01F;
+		}
+	}
+}
