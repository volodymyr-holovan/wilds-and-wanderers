+
+	public RuneSovereignModel(ModelPart root) {
+		this.root = root;
+		this.body = root.getChild("body");
+		this.hem = this.body.getChild("skirt").getChild("hem");
+		this.cape = this.body.getChild("cape");
+		this.head = this.body.getChild("head");
+		this.halo = this.head.getChild("halo");
+		this.rightArm = this.body.getChild("right_arm");
+		this.staff = this.rightArm.getChild("staff");
+		this.leftArm = this.body.getChild("left_arm");
+	}
+
+	public static LayerDefinition create() {
+		// ---- generated by make_models.py
+		MeshDefinition mesh = new MeshDefinition();
+		PartDefinition root = mesh.getRoot();
+		PartDefinition body = root.addOrReplaceChild("body", CubeListBuilder.create()
+				.texOffs(74, 0).addBox(-6.0F, -14.0F, -3.5F, 12.0F, 12.0F, 7.0F)
+				.texOffs(0, 68).addBox(-6.5F, -3.0F, -4.0F, 13.0F, 2.0F, 8.0F)
