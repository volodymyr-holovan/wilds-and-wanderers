+		PartDefinition hem = skirt.addOrReplaceChild("hem", CubeListBuilder.create()
+				.texOffs(46, 32).addBox(-8.0F, 0.0F, -5.0F, 16.0F, 9.0F, 10.0F),
+			PartPose.offset(0.0F, 10.0F, 0.0F));
+		PartDefinition cape = body.addOrReplaceChild("cape", CubeListBuilder.create()
+				.texOffs(8, 0).addBox(-6.0F, 0.0F, 0.0F, 12.0F, 29.0F, 1.0F),
+			PartPose.offset(0.0F, -14.0F, 3.5F));
+		PartDefinition head = body.addOrReplaceChild("head", CubeListBuilder.create()
+				.texOffs(34, 0).addBox(-5.0F, -11.0F, -5.0F, 10.0F, 11.0F, 10.0F)
+				.texOffs(42, 68).addBox(-2.0F, -13.0F, -1.0F, 4.0F, 3.0F, 6.0F)
+				.texOffs(72, 78).addBox(-5.5F, -11.5F, -6.0F, 11.0F, 3.0F, 2.0F),
+			PartPose.offset(0.0F, -14.0F, 0.0F));
