+				.texOffs(36, 0).addBox(4.0F, -5.0F, 4.0F, 1.0F, 10.0F, 1.0F)
+				.texOffs(0, 21).addBox(-4.0F, -5.0F, -5.0F, 8.0F, 1.0F, 1.0F)
+				.texOffs(18, 21).addBox(-4.0F, -5.0F, 4.0F, 8.0F, 1.0F, 1.0F)
+				.texOffs(40, 0).addBox(-5.0F, -5.0F, -4.0F, 1.0F, 1.0F, 8.0F)
+				.texOffs(0, 12).addBox(4.0F, -5.0F, -4.0F, 1.0F, 1.0F, 8.0F)
+				.texOffs(36, 21).addBox(-4.0F, 4.0F, -5.0F, 8.0F, 1.0F, 1.0F)
+				.texOffs(0, 23).addBox(-4.0F, 4.0F, 4.0F, 8.0F, 1.0F, 1.0F)
+				.texOffs(18, 12).addBox(-5.0F, 4.0F, -4.0F, 1.0F, 1.0F, 8.0F)
+				.texOffs(36, 12).addBox(4.0F, 4.0F, -4.0F, 1.0F, 1.0F, 8.0F),
+			PartPose.offset(0.0F, 17.0F, 0.0F));
+		PartDefinition core = root.addOrReplaceChild("core", CubeListBuilder.create()
+				.texOffs(0, 0).addBox(-3.0F, -3.0F, -3.0F, 6.0F, 6.0F, 6.0F),
+			PartPose.offset(0.0F, 17.0F, 0.0F));
+		return LayerDefinition.create(mesh, 64, 64);
+		// ---- end of generated
+	}
+
+	@Override
+	public ModelPart root() {
+		return this.root;
+	}
+
+	@Override
+	public void setupAnim(RuneWard entity, float limbSwing, float limbSwingAmount, float ageInTicks, float netHeadYaw, float headPitch) {
+		this.core.yRot = ageInTicks * 0.2F;
+		this.core.xRot = ageInTicks * 0.13F;
+		this.frame.yRot = -ageInTicks * 0.05F;
+		this.frame.zRot = Mth.sin(ageInTicks * 0.04F) * 0.3F;
+	}
+}
