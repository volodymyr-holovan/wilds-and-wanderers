+package twilightforest.client.model.entity;
+
+import net.minecraft.world.entity.Entity;
+import org.jetbrains.annotations.Nullable;
+
+/**
+ * A test hook for the models of the Final Castle completion: with the JVM flag {@code -Dtwilightforest.debugPoses=true},
+ * a mob without AI named {@code pose:<name>@<0..1>} holds that pose (for example {@code pose:volley@0.5}), so every
+ * gesture can be looked at and photographed from any side. Without the flag nothing changes.
+ */
+public record DebugPose(String name, float progress) {
+
+	private static final boolean ENABLED = Boolean.getBoolean("twilightforest.debugPoses");
+
+	@Nullable
+	public static DebugPose of(Entity entity) {
+		if (!ENABLED || entity.getCustomName() == null) return null;
+		String text = entity.getCustomName().getString();
+		if (!text.startsWith("pose:")) return null;
+		String[] parts = text.substring(5).split("@");
+		float progress = 0.5F;
+		try {
+			if (parts.length > 1) progress = Float.parseFloat(parts[1]);
+		} catch (NumberFormatException ignored) {
+		}
+		return new DebugPose(parts[0], progress);
+	}
+}
