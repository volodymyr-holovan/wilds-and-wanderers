+			PartPose.offset(-7.0F, -12.0F, 0.0F));
+		PartDefinition staff = right_arm.addOrReplaceChild("staff", CubeListBuilder.create()
+				.texOffs(0, 0).addBox(-1.0F, -20.0F, -1.0F, 2.0F, 30.0F, 2.0F)
