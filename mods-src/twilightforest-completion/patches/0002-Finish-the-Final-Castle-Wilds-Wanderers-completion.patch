+/**
+ * The Forge Harbinger: the mini-boss in the forge at the bottom of the Final Castle's dungeon, where Benimatic's sign
+ * said "Mini-boss 2 / Gives talisman" (Wilds &amp; Wanderers completion of the castle). It drops the Talisman of the
+ * Cube.
+ * <p>
+ * It hits hard in melee and every 8-10 s rams: one second of warning (it stops, smokes and rumbles), then a straight
+ * dash. A dash into a wall stuns it, and a stunned Harbinger takes half again as much damage. From half health it
+ * also throws embers, and once it calls two Harbinger Cubes.
+ */
+public class ForgeHarbinger extends BaseTFBoss {
+
+	public static final float MAX_HEALTH = 220.0F;
+	public static final float HEALTH_PER_EXTRA_PLAYER = 0.4F;
+	public static final int MAX_EXTRA_PLAYERS = 4;
+	private static final int TELEGRAPH_TICKS = 20;
+	private static final int CHARGE_TICKS = 40;
+	private static final int STUN_TICKS = 50;
+	private static final double CHARGE_SPEED = 0.85D;
+	public static final float CHARGE_DAMAGE = 12.0F;
+
+	private enum State { WALK, TELEGRAPH, CHARGE, STUNNED }
+
+	private State state = State.WALK;
+	private int stateTicks;
+	private int chargeCooldown = 160;
+	private int emberCooldown = 120;
+	private long lastEngaged;
+	private boolean calledHelp;
+	private boolean healthScaled;
+	private Vec3 chargeDirection = Vec3.ZERO;
+	private final Set<UUID> participants = new HashSet<>();
+	private final Set<Integer> hitThisCharge = new HashSet<>();
+
+	public ForgeHarbinger(EntityType<? extends ForgeHarbinger> type, Level level) {
+		super(type, level);
+		this.xpReward = 200;
+	}
+
+	/** A wide cube: the default melee reach (made for mobs the size of a player) would leave it a block short. */
+	@Override
+	protected net.minecraft.world.phys.AABB getAttackBoundingBox() {
+		return super.getAttackBoundingBox().inflate(1.2D, 0.0D, 1.2D);
+	}
+
+	public static AttributeSupplier.Builder registerAttributes() {
+		return Monster.createMonsterAttributes()
+			.add(Attributes.MAX_HEALTH, MAX_HEALTH)
+			.add(Attributes.ARMOR, 10.0D)
+			.add(Attributes.KNOCKBACK_RESISTANCE, 1.0D)
+			.add(Attributes.ATTACK_DAMAGE, 7.0D)
+			.add(Attributes.ATTACK_KNOCKBACK, 1.5D)
+			.add(Attributes.MOVEMENT_SPEED, 0.27D)
+			.add(Attributes.FOLLOW_RANGE, 32.0D)
+			.add(Attributes.STEP_HEIGHT, 1.5D);
+	}
+
+	@Override
+	protected void registerGoals() {
+		this.goalSelector.addGoal(0, new FloatGoal(this));
+		this.goalSelector.addGoal(2, new MeleeAttackGoal(this, 1.0D, true) {
+			@Override
+			public boolean canUse() {
+				return ForgeHarbinger.this.state == State.WALK && super.canUse();
+			}
+
+			@Override
+			public boolean canContinueToUse() {
+				return ForgeHarbinger.this.state == State.WALK && super.canContinueToUse();
+			}
+
+			// a heavy blow every 1.5 s rather than every second
+			@Override
+			protected int getAttackInterval() {
+				return this.adjustedTickDelay(30);
+			}
+		});
+		this.goalSelector.addGoal(6, new LookAtPlayerGoal(this, Player.class, 16.0F));
+		this.goalSelector.addGoal(7, new RandomLookAroundGoal(this));
+		this.targetSelector.addGoal(1, new HurtByTargetGoal(this));
+		this.targetSelector.addGoal(2, new NearestAttackableTargetGoal<>(this, Player.class, false));
+		this.addRestrictionGoals(this, this.goalSelector);
+	}
+
+	@Override
+	public SpawnGroupData finalizeSpawn(ServerLevelAccessor accessor, DifficultyInstance difficulty, MobSpawnType type, @Nullable SpawnGroupData data) {
+		SpawnGroupData result = super.finalizeSpawn(accessor, difficulty, type, data);
+		if (!this.healthScaled) {
+			this.healthScaled = true;
+			int extra = Math.min(MAX_EXTRA_PLAYERS, Math.max(0, CastleBossRules.engagedPlayers(this, this.blockPosition()).size() - 1));
+			var health = this.getAttribute(Attributes.MAX_HEALTH);
+			if (extra > 0 && health != null) {
+				health.addPermanentModifier(new AttributeModifier(TwilightForestMod.prefix("harbinger_group"), HEALTH_PER_EXTRA_PLAYER * extra, AttributeModifier.Operation.ADD_MULTIPLIED_BASE));
+				this.setHealth(this.getMaxHealth());
+			}
+		}
+		return result;
+	}
+
+	@Override
+	public int getHomeRadius() {
+		return 24;
+	}
+
+	@Override
+	public ResourceKey<Structure> getHomeStructure() {
+		return TFStructures.FINAL_CASTLE;
+	}
+
+	@Override
+	public Block getDeathContainer(RandomSource random) {
+		return TFBlocks.CANOPY_CHEST.get();
+	}
+
+	@Override
+	public Block getBossSpawner() {
+		return TFBlocks.FORGE_HARBINGER_BOSS_SPAWNER.get();
+	}
+
+	@Override
+	public int getBossBarColor() {
+		return 0xFF7A1A;
+	}
+
+	public boolean isTelegraphing() {
+		return this.state == State.TELEGRAPH;
+	}
+
+	private BlockPos homePos() {
+		GlobalPos home = this.getRestrictionPoint();
+		return home != null && home.dimension() == this.level().dimension() ? home.pos() : this.blockPosition();
+	}
+
+	@Override
+	protected void customServerAiStep() {
+		super.customServerAiStep();
+		if (!(this.level() instanceof ServerLevel server)) return;
+		if (this.getRestrictionPoint() == null) this.setRestrictionPoint(GlobalPos.of(this.level().dimension(), this.blockPosition()));
+
+		long now = server.getGameTime();
+		if (this.tickCount > 40 && CastleBossRules.abandoned(now, this.lastEngaged)) this.resetFight();
+		if (CastleBossRules.engagedPlayers(this, this.homePos()).isEmpty()) return;
+		this.lastEngaged = now;
+
+		LivingEntity target = this.getTarget();
+		if (target != null && (!target.isAlive() || !this.isMobWithinHomeArea(target))) {
+			this.setTarget(null);
+			target = null;
+		}
+
+		if (!this.calledHelp && this.getHealth() <= this.getMaxHealth() * 0.5F) {
+			this.calledHelp = true;
+			for (int i = 0; i < 2; i++) this.callHarbingerCube(server, target);
+		}
+
+		switch (this.state) {
+			case WALK -> {
+				if (target == null) return;
+				if (--this.chargeCooldown <= 0 && this.distanceToSqr(target) > 16.0D && this.distanceToSqr(target) < 400.0D && this.hasLineOfSight(target)) {
+					this.state = State.TELEGRAPH;
+					this.stateTicks = TELEGRAPH_TICKS;
+					this.getNavigation().stop();
+					this.playSound(SoundEvents.RAVAGER_ROAR, 1.5F, 0.6F);
+				}
+				if (this.getHealth() <= this.getMaxHealth() * 0.5F && --this.emberCooldown <= 0) {
+					this.throwEmbers(server, target);
+					this.emberCooldown = 120;
+				}
+			}
+			case TELEGRAPH -> {
+				this.getNavigation().stop();
+				if (target != null) {
+					this.getLookControl().setLookAt(target, 30.0F, 30.0F);
+					this.chargeDirection = target.position().subtract(this.position()).multiply(1.0D, 0.0D, 1.0D).normalize();
+				}
+				server.sendParticles(ParticleTypes.LARGE_SMOKE, this.getX(), this.getY() + 0.3D, this.getZ(), 4, 1.0D, 0.2D, 1.0D, 0.02D);
+				if (--this.stateTicks <= 0) {
+					this.state = State.CHARGE;
+					this.stateTicks = CHARGE_TICKS;
+					this.hitThisCharge.clear();
+					if (this.chargeDirection.lengthSqr() < 1.0E-4D) this.chargeDirection = this.getLookAngle().multiply(1.0D, 0.0D, 1.0D).normalize();
+				}
+			}
+			case CHARGE -> {
+				this.setDeltaMovement(this.chargeDirection.x * CHARGE_SPEED, this.getDeltaMovement().y, this.chargeDirection.z * CHARGE_SPEED);
+				this.setYRot((float) (Math.atan2(this.chargeDirection.z, this.chargeDirection.x) * (180.0D / Math.PI)) - 90.0F);
+				AABB reach = this.getBoundingBox().inflate(0.5D);
+				for (LivingEntity hit : server.getEntitiesOfClass(LivingEntity.class, reach, e -> e != this && e.isAlive() && !(e instanceof HarbingerCube))) {
+					if (this.hitThisCharge.add(hit.getId()) && hit.hurt(this.damageSources().mobAttack(this), CHARGE_DAMAGE)) {
+						hit.knockback(2.5D, -this.chargeDirection.x, -this.chargeDirection.z);
+						hit.hurtMarked = true;
+					}
+				}
+				if (this.horizontalCollision && this.stateTicks < CHARGE_TICKS - 2) {
+					this.state = State.STUNNED;
+					this.stateTicks = STUN_TICKS;
+					this.setDeltaMovement(Vec3.ZERO);
+					this.playSound(SoundEvents.ANVIL_LAND, 1.5F, 0.5F);
+					server.sendParticles(ParticleTypes.EXPLOSION, this.getX(), this.getY() + 1.0D, this.getZ(), 2, 0.5D, 0.5D, 0.5D, 0.0D);
+				} else if (--this.stateTicks <= 0) {
+					this.endCharge();
+				}
+			}
+			case STUNNED -> {
+				this.getNavigation().stop();
+				if (this.stateTicks % 5 == 0) server.sendParticles(ParticleTypes.CRIT, this.getX(), this.getY() + this.getBbHeight(), this.getZ(), 6, 0.6D, 0.2D, 0.6D, 0.05D);
+				if (--this.stateTicks <= 0) this.endCharge();
+			}
+		}
+	}
+
+	private void endCharge() {
+		this.state = State.WALK;
+		this.chargeCooldown = 160 + this.random.nextInt(40);
+	}
+
+	private void throwEmbers(ServerLevel server, LivingEntity target) {
+		Vec3 from = this.position().add(0.0D, this.getBbHeight() * 0.6D, 0.0D);
+		for (int i = 0; i < 3; i++) {
+			Vec3 aim = target.getBoundingBox().getCenter().subtract(from).add(this.random.nextGaussian() * 0.8D, 0.0D, this.random.nextGaussian() * 0.8D);
+			SmallFireball ember = new SmallFireball(server, this, aim.normalize());
+			ember.setPos(from.x, from.y, from.z);
+			server.addFreshEntity(ember);
+		}
+		this.playSound(SoundEvents.BLAZE_SHOOT, 1.5F, 0.7F);
+	}
+
+	private void callHarbingerCube(ServerLevel server, @Nullable LivingEntity target) {
+		HarbingerCube cube = new HarbingerCube(TFEntities.HARBINGER_CUBE.get(), server);
+		for (int attempt = 0; attempt < 10; attempt++) {
+			double angle = this.random.nextDouble() * Math.PI * 2.0D;
+			cube.moveTo(this.getX() + Math.cos(angle) * 5.0D, this.getY(), this.getZ() + Math.sin(angle) * 5.0D, this.random.nextFloat() * 360.0F, 0.0F);
+			if (server.noCollision(cube)) {
+				cube.finalizeSpawn(server, server.getCurrentDifficultyAt(cube.blockPosition()), MobSpawnType.MOB_SUMMONED, null);
+				cube.setPersistenceRequired();
+				cube.addTag(PlateauBoss.MINION_TAG);
+				if (target != null) cube.setTarget(target);
+				server.addFreshEntity(cube);
+				server.sendParticles(ParticleTypes.FLAME, cube.getX(), cube.getY() + 1.0D, cube.getZ(), 20, 0.6D, 0.6D, 0.6D, 0.02D);
+				return;
+			}
+		}
+	}
+
+	private void resetFight() {
+		this.state = State.WALK;
+		this.lastEngaged = 0;
+		this.calledHelp = false;
+		this.participants.clear();
+		CastleBossRules.discardMinions(this, this.getBoundingBox().inflate(this.getHomeRadius() + 8.0D));
+		this.setHealth(this.getMaxHealth());
+		this.setTarget(null);
+		BlockPos home = this.homePos();
+		this.teleportTo(home.getX() + 0.5D, home.getY(), home.getZ() + 0.5D);
+	}
+
+	@Override
+	public boolean hurt(DamageSource source, float amount) {
+		if (this.level().isClientSide() || this.isInvulnerableTo(source)) return false;
+		Entity attacker = source.getEntity();
+		if (attacker != null && attacker.getTags().contains(PlateauBoss.MINION_TAG)) return false;
+		float adjusted = CastleBossRules.adjust(this, source, this.state == State.STUNNED ? amount * 1.5F : amount, null);
+		if (adjusted <= 0.0F) return false;
+		boolean hurt = super.hurt(source, adjusted);
+		if (hurt) {
+			Player player = CastleBossRules.realPlayer(source);
+			if (player != null) this.participants.add(player.getUUID());
+		}
+		return hurt;
+	}
+
+	@Override
+	public void die(DamageSource cause) {
+		Player killer = CastleBossRules.realPlayer(cause);
+		if (killer != null) this.participants.add(killer.getUUID());
+		super.die(cause);
+	}
+
+	@Override
+	protected void postmortem(ServerLevel serverLevel, DamageSource cause) {
+		super.postmortem(serverLevel, cause);
+		// a talisman for every extra player who fought, so each can make a Cube of Annihilation
+		int extra = Math.min(MAX_EXTRA_PLAYERS, Math.max(0, this.participants.size() - 1));
+		for (int i = 0; i < extra; i++) {
+			for (int slot = 0; slot < this.getItemStacks().size(); slot++) {
+				if (this.getItemStacks().get(slot).isEmpty()) {
+					this.getItemStacks().set(slot, new ItemStack(TFItems.CUBE_TALISMAN.get()));
+					break;
+				}
+			}
+		}
+	}
+
+	@Override
+	public boolean causeFallDamage(float distance, float multiplier, DamageSource source) {
+		return false;
+	}
+
+	@Override
+	protected SoundEvent getAmbientSound() {
+		return SoundEvents.BLAZE_BURN;
+	}
+
+	@Override
+	protected SoundEvent getHurtSound(DamageSource source) {
+		return SoundEvents.IRON_GOLEM_HURT;
+	}
+
+	@Override
+	protected SoundEvent getDeathSound() {
+		return SoundEvents.IRON_GOLEM_DEATH;
+	}
+
+	@Override
+	protected float getSoundVolume() {
+		return 1.2F;
+	}
+
+	@Override
+	public void addAdditionalSaveData(CompoundTag tag) {
+		super.addAdditionalSaveData(tag);
+		tag.putBoolean("HarbingerCalledHelp", this.calledHelp);
+		tag.putBoolean("HarbingerScaled", this.healthScaled);
+		tag.putLong("HarbingerLastEngaged", this.lastEngaged);
+		tag.putUUID("HarbingerSession", CastleBossRules.SESSION);
+		ListTag list = new ListTag();
+		for (UUID id : this.participants) list.add(NbtUtils.createUUID(id));
+		tag.put("HarbingerParticipants", list);
+	}
+
+	@Override
+	public void readAdditionalSaveData(CompoundTag tag) {
+		super.readAdditionalSaveData(tag);
+		this.calledHelp = tag.getBoolean("HarbingerCalledHelp");
+		this.healthScaled = tag.getBoolean("HarbingerScaled");
+		this.lastEngaged = tag.hasUUID("HarbingerSession") && tag.getUUID("HarbingerSession").equals(CastleBossRules.SESSION) ? tag.getLong("HarbingerLastEngaged") : 0L;
+		this.participants.clear();
+		for (Tag id : tag.getList("HarbingerParticipants", Tag.TAG_INT_ARRAY)) this.participants.add(NbtUtils.loadUUID(id));
+	}
+}
