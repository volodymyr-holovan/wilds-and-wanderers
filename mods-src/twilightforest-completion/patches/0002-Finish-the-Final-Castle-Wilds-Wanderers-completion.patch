+package twilightforest.client.renderer.entity;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import net.minecraft.client.renderer.entity.EntityRendererProvider;
+import net.minecraft.client.renderer.entity.MobRenderer;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.util.Mth;
+import twilightforest.TwilightForestMod;
+import twilightforest.client.model.TFModelLayers;
+import twilightforest.client.model.entity.HarbingerCubeModel;
+import twilightforest.entity.boss.ForgeHarbinger;
+
+/**
+ * The Forge Harbinger: a Harbinger Cube twice the size, glowing like metal in a forge (texture derived from TF's
+ * apocalypse2.png, CC BY-NC-SA 4.0). It shudders while it gathers itself for a charge.
+ */
+public class ForgeHarbingerRenderer extends MobRenderer<ForgeHarbinger, HarbingerCubeModel<ForgeHarbinger>> {
+
+	private static final ResourceLocation TEXTURE = TwilightForestMod.getModelTexture("forge_harbinger.png");
+	public static final float SCALE = 2.0F;
+
+	public ForgeHarbingerRenderer(EntityRendererProvider.Context context) {
+		super(context, new HarbingerCubeModel<>(context.bakeLayer(TFModelLayers.HARBINGER_CUBE)), 2.0F);
+	}
+
+	@Override
+	protected void scale(ForgeHarbinger entity, PoseStack stack, float partialTicks) {
+		stack.scale(SCALE, SCALE, SCALE);
+		if (entity.isTelegraphing()) {
+			float shake = Mth.sin((entity.tickCount + partialTicks) * 2.5F) * 0.03F;
+			stack.translate(shake, 0.0F, -shake);
+		}
+	}
+
+	@Override
+	public ResourceLocation getTextureLocation(ForgeHarbinger entity) {
+		return TEXTURE;
+	}
+}
