+package twilightforest.client.renderer.entity;
+
+import com.mojang.blaze3d.vertex.PoseStack;
+import net.minecraft.client.renderer.entity.EntityRendererProvider;
+import net.minecraft.util.Mth;
+import twilightforest.client.model.TFModelLayers;
+import twilightforest.client.model.entity.AdherentModel;
+import twilightforest.entity.boss.PlateauBoss;
+
+/**
+ * The Rune Sovereign: an Adherent grown half again as tall, in white and violet robes (texture derived from TF's
+ * adherent.png, CC BY-NC-SA 4.0 like the rest of TF's art). It bobs while it floats and sinks when stunned.
+ */
+public class RuneSovereignRenderer extends TFBipedRenderer<PlateauBoss, AdherentModel<PlateauBoss>> {
+
+	public static final float SCALE = 1.5F;
+
+	public RuneSovereignRenderer(EntityRendererProvider.Context context) {
+		super(context, new AdherentModel<>(context.bakeLayer(TFModelLayers.ADHERENT)), 0.9F, "rune_sovereign.png");
+	}
+
+	@Override
+	protected void scale(PlateauBoss entity, PoseStack stack, float partialTicks) {
+		stack.scale(SCALE, SCALE, SCALE);
+		float bounce = entity.tickCount + partialTicks;
+		stack.translate(0.0F, -0.125F - Mth.sin(bounce * 0.1F) * 0.08F, 0.0F);
+	}
+}
