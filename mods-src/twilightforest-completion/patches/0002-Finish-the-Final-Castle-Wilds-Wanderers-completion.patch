diff --git a/src/main/java/twilightforest/world/components/structures/finalcastle/FinalCastleUpgrade.java b/src/main/java/twilightforest/world/components/structures/finalcastle/FinalCastleUpgrade.java
new file mode 100644
index 000000000..17c81173b
--- /dev/null
+++ b/src/main/java/twilightforest/world/components/structures/finalcastle/FinalCastleUpgrade.java
@@ -0,0 +1,180 @@
+package twilightforest.world.components.structures.finalcastle;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.SectionPos;
+import net.minecraft.resources.ResourceKey;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Display;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.Interaction;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.entity.SignBlockEntity;
+import net.minecraft.world.level.levelgen.structure.StructurePiece;
+import net.minecraft.world.level.levelgen.structure.StructureStart;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.minecraft.world.level.levelgen.structure.Structure;
+import net.neoforged.neoforge.event.entity.EntityJoinLevelEvent;
+import net.neoforged.neoforge.event.level.ChunkEvent;
+import net.neoforged.neoforge.event.tick.LevelTickEvent;
+import twilightforest.TwilightForestMod;
+import twilightforest.init.TFBlocks;
+import twilightforest.init.TFStructures;
+import twilightforest.util.landmarks.LandmarkUtil;
+import twilightforest.world.components.structures.start.TFStructureStart;
+
+import java.util.ArrayDeque;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentLinkedQueue;
+
+/**
+ * Finishes Final Castles in place (Wilds &amp; Wanderers completion of the castle).
+ * <p>
+ * Every castle's gazebo comes with a tagged {@link Interaction} ({@link FinalCastleBossGazeboComponent#INTERACTION_TAG})
+ * under "Final Castle WIP" text. When that entity first loads, the castle is brought up to date, once:
+ * <ul>
+ *     <li>the Rune Sovereign's spawner goes where the gazebo's jigsaw was (unless the castle is already conquered);</li>
+ *     <li>a forge generated before the completion still has Benimatic's "Mini-boss 2" sign: it becomes the Forge
+ *     Harbinger's spawner (forges generated after it get the spawner from {@link FinalCastleDungeonForgeRoomComponent});
+ *     a castle whose forge was laid out out of reach (see {@link FinalCastleDungeonExitComponent}) gets the spawner in
+ *     its deepest dungeon room instead;</li>
+ *     <li>the WIP text and the Interaction go, so this never runs twice for a castle.</li>
+ * </ul>
+ * The marker is found two ways: its join event, when a chunk comes from disk; and, since a freshly generated chunk
+ * brings its entities without that event, a look a second after any chunk of a Final Castle loads. The work itself is
+ * done on a later tick of that level (the events fire while a chunk is loading, when changing blocks is unsafe), one
+ * castle per tick.
+ */
+public final class FinalCastleUpgrade {
+
+	private static final Map<ResourceKey<Level>, ArrayDeque<BlockPos>> PENDING = new HashMap<>();
+	/** Chunks of a Final Castle that loaded, with the game time to look into them (entities come a moment later). */
+	private static final Map<ResourceKey<Level>, ConcurrentLinkedQueue<long[]>> SCANS = new ConcurrentHashMap<>();
+	/** Castles (dimension and start chunk) already looked at in this run of the server. */
+	private static final Set<String> CHECKED = ConcurrentHashMap.newKeySet();
+
+	private FinalCastleUpgrade() {
+	}
+
+	public static void onEntityJoin(EntityJoinLevelEvent event) {
+		if (event.getLevel().isClientSide()) return;
+		if (event.getEntity() instanceof Interaction interaction && interaction.getTags().contains(FinalCastleBossGazeboComponent.INTERACTION_TAG)) {
+			PENDING.computeIfAbsent(event.getLevel().dimension(), key -> new ArrayDeque<>()).add(interaction.blockPosition());
+		}
+	}
+
+	public static void onChunkLoad(ChunkEvent.Load event) {
+		if (!(event.getLevel() instanceof ServerLevel level) || !(event.getChunk() instanceof LevelChunk chunk)) return;
+		Structure castle = LandmarkUtil.structureForKey(level, TFStructures.FINAL_CASTLE);
+		if (castle == null || chunk.getReferencesForStructure(castle).isEmpty()) return;
+		SCANS.computeIfAbsent(level.dimension(), key -> new ConcurrentLinkedQueue<>()).add(new long[]{chunk.getPos().toLong(), level.getGameTime() + 20L});
+	}
+
+	private static void scanLoadedChunks(ServerLevel level) {
+		ConcurrentLinkedQueue<long[]> scans = SCANS.get(level.dimension());
+		if (scans == null) return;
+		for (int done = 0; done < 8; done++) {
+			long[] scan = scans.peek();
+			if (scan == null || scan[1] > level.getGameTime()) return;
+			scans.poll();
+			ChunkPos chunk = new ChunkPos(scan[0]);
+			if (!level.hasChunk(chunk.x, chunk.z)) continue;
+			Optional<StructureStart> start = LandmarkUtil.locateNearestLandmarkStart(level, TFStructures.FINAL_CASTLE, chunk.x, chunk.z);
+			if (start.isEmpty()) continue;
+			String key = level.dimension().location() + "@" + start.get().getChunkPos().toLong();
+			if (CHECKED.contains(key)) continue;
+			for (StructurePiece piece : start.get().getPieces()) {
+				if (!(piece instanceof FinalCastleBossGazeboComponent gazebo)) continue;
+				var box = gazebo.getBoundingBox();
+				// look once the chunk holding the middle of the gazebo is here
+				if (SectionPos.blockToSectionCoord(box.getCenter().getX()) != chunk.x || SectionPos.blockToSectionCoord(box.getCenter().getZ()) != chunk.z) continue;
+				CHECKED.add(key);
+				for (Interaction marker : level.getEntitiesOfClass(Interaction.class, AABB.of(box).inflate(2.0D),
+					e -> e.getTags().contains(FinalCastleBossGazeboComponent.INTERACTION_TAG))) {
+					PENDING.computeIfAbsent(level.dimension(), k -> new ArrayDeque<>()).add(marker.blockPosition());
+				}
+			}
+		}
+	}
+
+	public static void onLevelTick(LevelTickEvent.Post event) {
+		if (!(event.getLevel() instanceof ServerLevel level)) return;
+		scanLoadedChunks(level);
+		ArrayDeque<BlockPos> queue = PENDING.get(level.dimension());
+		if (queue == null || queue.isEmpty()) return;
+		BlockPos pos = queue.poll();
+		try {
+			upgrade(level, pos);
+		} catch (RuntimeException e) {
+			TwilightForestMod.LOGGER.error("Could not finish the Final Castle at {}", pos, e);
+		}
+	}
+
+	private static void upgrade(ServerLevel level, BlockPos interactionPos) {
+		List<Interaction> markers = level.getEntitiesOfClass(Interaction.class, new AABB(interactionPos).inflate(1.0D),
+			e -> e.getTags().contains(FinalCastleBossGazeboComponent.INTERACTION_TAG));
+		if (markers.isEmpty()) return; // already done
+		Interaction marker = markers.getFirst();
+
+		Optional<StructureStart> start = LandmarkUtil.locateNearestLandmarkStart(level, TFStructures.FINAL_CASTLE, interactionPos);
+		boolean conquered = start.isPresent() && start.get() instanceof TFStructureStart tfStart && tfStart.isConquered();
+
+		if (!conquered) {
+			// the gazebo template's jigsaw sits one block above its marker
+			BlockPos spawner = marker.blockPosition().above();
+			if (level.getBlockState(spawner).isAir()) {
+				level.setBlock(spawner, TFBlocks.FINAL_BOSS_BOSS_SPAWNER.get().defaultBlockState(), Block.UPDATE_ALL);
+				TwilightForestMod.LOGGER.info("Final Castle at {}: the Rune Sovereign now waits in the gazebo", spawner);
+			}
+			start.ifPresent(s -> upgradeForge(level, s));
+		}
+
+		AABB texts = new AABB(marker.blockPosition()).inflate(2.0D, 0.0D, 2.0D).expandTowards(0.0D, 5.0D, 0.0D);
+		level.getEntities((Entity) null, texts, e -> e instanceof Display.TextDisplay).forEach(Entity::discard);
+		marker.discard();
+	}
+
+	private static void upgradeForge(ServerLevel level, StructureStart start) {
+		ChunkPos origin = start.getChunkPos();
+		FinalCastleDungeonForgeRoomComponent forge = null;
+		FinalCastleDungeonExitComponent lastExit = null;
+		for (StructurePiece piece : start.getPieces()) {
+			if (piece instanceof FinalCastleDungeonForgeRoomComponent room) forge = room;
+			if (piece instanceof FinalCastleDungeonExitComponent exit && canGenerate(origin, exit.getCentreFloorPos())
+				&& (lastExit == null || exit.getBoundingBox().minY() < lastExit.getBoundingBox().minY())) lastExit = exit;
+		}
+
+		if (forge != null && canGenerate(origin, forge.getSpawnerPos())) {
+			// a forge generated before the completion still has Benimatic's sign
+			BlockPos pos = forge.getSpawnerPos();
+			level.getChunk(SectionPos.blockToSectionCoord(pos.getX()), SectionPos.blockToSectionCoord(pos.getZ()));
+			if (level.getBlockEntity(pos) instanceof SignBlockEntity sign && sign.getFrontText().getMessage(1, false).getString().equals("Mini-boss 2")) {
+				level.setBlock(pos, TFBlocks.FORGE_HARBINGER_BOSS_SPAWNER.get().defaultBlockState(), Block.UPDATE_ALL);
+				TwilightForestMod.LOGGER.info("Final Castle forge at {}: the Forge Harbinger now waits there", pos);
+			}
+		} else if (lastExit != null) {
+			// Castles generated before the completion have their forge out of reach (the DungeonExit bug fixed in this
+			// completion): the deepest dungeon room that did generate takes the Forge Harbinger instead, so the
+			// Talisman of the Cube can still be won.
+			BlockPos pos = lastExit.getCentreFloorPos();
+			level.getChunk(SectionPos.blockToSectionCoord(pos.getX()), SectionPos.blockToSectionCoord(pos.getZ()));
+			if (level.getBlockState(pos).isAir()) {
+				level.setBlock(pos, TFBlocks.FORGE_HARBINGER_BOSS_SPAWNER.get().defaultBlockState(), Block.UPDATE_ALL);
+				TwilightForestMod.LOGGER.info("Final Castle at {}: its forge never generated, the Forge Harbinger waits in the last dungeon room at {}", origin, pos);
+			}
+		}
+	}
+
+	/** A structure places pieces only in chunks within 8 chunks of its start (vanilla structure references). */
+	private static boolean canGenerate(ChunkPos origin, BlockPos pos) {
+		return Math.abs(SectionPos.blockToSectionCoord(pos.getX()) - origin.x) <= 8
+			&& Math.abs(SectionPos.blockToSectionCoord(pos.getZ()) - origin.z) <= 8;
+	}
+}
