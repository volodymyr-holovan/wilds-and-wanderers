+		this.discardHelpers(server);
+		this.circles.clear();
+
+		AdvancementHolder advancement = server.getServer().getAdvancements().get(FINAL_ADVANCEMENT.location());
+		Set<ServerPlayer> told = new HashSet<>();
+		for (UUID id : this.participants) {
+			ServerPlayer player = server.getServer().getPlayerList().getPlayer(id);
+			if (player == null) continue;
+			if (advancement != null) player.getAdvancements().award(advancement, DEFEATED_CRITERION);
+			told.add(player);
+		}
+		told.addAll(server.getEntitiesOfClass(ServerPlayer.class, this.getArena().inflate(32.0D)));
+		for (ServerPlayer player : told) {
+			player.connection.send(new ClientboundSetTitlesAnimationPacket(10, 80, 30));
+			player.connection.send(new ClientboundSetTitleTextPacket(Component.translatable("gui.twilightforest.final_castle.end.title").withStyle(ChatFormatting.LIGHT_PURPLE)));
+			player.connection.send(new ClientboundSetSubtitleTextPacket(Component.translatable("gui.twilightforest.final_castle.end.subtitle")));
+			player.sendSystemMessage(Component.translatable("gui.twilightforest.final_castle.end.message").withStyle(ChatFormatting.GRAY, ChatFormatting.ITALIC));
+		}
+	}
+
+	@Override
+	protected void postmortem(ServerLevel serverLevel, DamageSource cause) {
+		super.postmortem(serverLevel, cause);
+		// one more scepter for every extra player who fought (TF's own multiplayer loot can be switched off in its config)
+		int extra = Math.min(MAX_EXTRA_PLAYERS, Math.max(0, this.participants.size() - 1));
+		for (int i = 0; i < extra; i++) this.addToDyingInventory(new ItemStack(TFItems.RUNE_SCEPTER.get()));
+	}
+
+	private void addToDyingInventory(ItemStack stack) {
+		for (int slot = 0; slot < this.getItemStacks().size(); slot++) {
+			if (this.getItemStacks().get(slot).isEmpty()) {
+				this.getItemStacks().set(slot, stack);
+				return;
+			}
+		}
+	}
+
+	@Override
+	public boolean isDeathAnimationFinished() {
+		return this.deathTime >= DEATH_TICKS;
+	}
+
+	@Override
+	public void tickDeathAnimation() {
+		for (int i = 0; i < 4; i++) {
+			this.level().addParticle(TFParticleType.ANNIHILATE.get(), this.getRandomX(1.2D), this.getRandomY(), this.getRandomZ(1.2D), 0.0D, 0.08D, 0.0D);
+		}
+		if (this.deathTime % 10 == 0) {
+			this.level().addParticle(ParticleTypes.FLASH, this.getX(), this.getY() + 1.6D, this.getZ(), 0.0D, 0.0D, 0.0D);
+		}
+	}
+
+	@Override
+	public void remove(RemovalReason reason) {
+		if (reason.shouldDestroy() && this.level() instanceof ServerLevel server) this.discardHelpers(server);
+		super.remove(reason);
+	}
+
+	// ---- saving --------------------------------------------------------------------------------------------------
+
+	@Override
+	public void addAdditionalSaveData(CompoundTag tag) {
+		super.addAdditionalSaveData(tag);
+		tag.putInt("SovereignPhase", this.getPhase());
+		tag.putBoolean("SovereignShielded", this.isShielded());
+		tag.putInt("SovereignWardWaves", this.wardWaves);
+		tag.putBoolean("SovereignHarbinger", this.harbingerCalled);
+		tag.putInt("SovereignStun", this.stunTicks);
+		tag.putLong("SovereignLastEngaged", this.lastEngaged);
+		tag.putUUID("SovereignSession", CastleBossRules.SESSION);
+		tag.putBoolean("SovereignScaled", this.healthScaled);
+		tag.put("SovereignWards", uuids(this.wards));
+		tag.put("SovereignMinions", uuids(this.minions));
+		tag.put("SovereignParticipants", uuids(this.participants));
+	}
+
+	@Override
+	public void readAdditionalSaveData(CompoundTag tag) {
+		super.readAdditionalSaveData(tag);
+		this.getEntityData().set(PHASE, Math.max(1, tag.getInt("SovereignPhase")));
+		this.getEntityData().set(SHIELDED, tag.getBoolean("SovereignShielded"));
+		this.wardWaves = tag.getInt("SovereignWardWaves");
+		this.harbingerCalled = tag.getBoolean("SovereignHarbinger");
+		this.stunTicks = tag.getInt("SovereignStun");
+		// saved in an earlier run of the server: the fight goes on once players are back
+		this.lastEngaged = tag.hasUUID("SovereignSession") && tag.getUUID("SovereignSession").equals(CastleBossRules.SESSION) ? tag.getLong("SovereignLastEngaged") : 0L;
+		this.healthScaled = tag.getBoolean("SovereignScaled");
+		readUuids(tag.getList("SovereignWards", Tag.TAG_INT_ARRAY), this.wards);
+		readUuids(tag.getList("SovereignMinions", Tag.TAG_INT_ARRAY), this.minions);
+		readUuids(tag.getList("SovereignParticipants", Tag.TAG_INT_ARRAY), this.participants);
+		// wards load with their own chunk; give them two seconds before deciding they are gone
+		this.relinkTicks = 40;
+	}
+
+	private static ListTag uuids(Iterable<UUID> ids) {
+		ListTag list = new ListTag();
+		for (UUID id : ids) list.add(NbtUtils.createUUID(id));
+		return list;
+	}
+
+	private static void readUuids(ListTag list, Collection<UUID> into) {
+		into.clear();
+		for (Tag tag : list) into.add(NbtUtils.loadUUID(tag));
+	}
+
+	/** A rune circle marked under a player: it bursts when {@link #ticks} runs out. */
+	private static final class RuneCircle {
+		static final double RADIUS = 3.0D;
+		final Vec3 centre;
+		int ticks;
+
+		RuneCircle(Vec3 centre, int ticks) {
+			this.centre = centre;
+			this.ticks = ticks;
+		}
 	}
 }
