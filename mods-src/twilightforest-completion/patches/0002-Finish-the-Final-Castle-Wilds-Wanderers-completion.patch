@@ -0,0 +1,38 @@
+package twilightforest.block.entity.spawner;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.particles.ParticleOptions;
+import net.minecraft.core.particles.ParticleTypes;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.state.BlockState;
+import twilightforest.entity.boss.ForgeHarbinger;
+import twilightforest.init.TFBlockEntities;
+import twilightforest.init.TFEntities;
+
+/**
+ * The spawner in the middle of the Final Castle's forge (Wilds &amp; Wanderers completion of the castle). It wakes the
+ * Forge Harbinger when a player comes within 16 blocks on the forge floor, not through the floor or ceiling.
+ */
+public class ForgeHarbingerSpawnerBlockEntity extends BossSpawnerBlockEntity<ForgeHarbinger> {
+
+	public ForgeHarbingerSpawnerBlockEntity(BlockPos pos, BlockState state) {
+		super(TFBlockEntities.FORGE_HARBINGER_SPAWNER.get(), TFEntities.FORGE_HARBINGER.get(), pos, state);
+	}
+
+	@Override
+	public boolean anyPlayerInRange(Level level) {
+		Player closest = level.getNearestPlayer(this.getBlockPos().getX() + 0.5D, this.getBlockPos().getY() + 0.5D, this.getBlockPos().getZ() + 0.5D, this.getRange(), false);
+		return closest != null && Math.abs(closest.getY() - this.getBlockPos().getY()) < 6.0D;
+	}
+
+	@Override
+	protected int getRange() {
+		return 16;
+	}
+
+	@Override
+	public ParticleOptions getSpawnerParticle() {
+		return ParticleTypes.FLAME;
+	}
+}
