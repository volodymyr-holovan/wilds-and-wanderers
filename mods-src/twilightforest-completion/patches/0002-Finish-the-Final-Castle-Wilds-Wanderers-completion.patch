diff --git a/src/main/java/twilightforest/entity/projectile/RuneBolt.java b/src/main/java/twilightforest/entity/projectile/RuneBolt.java
new file mode 100644
index 000000000..4bf24ff5b
--- /dev/null
+++ b/src/main/java/twilightforest/entity/projectile/RuneBolt.java
@@ -0,0 +1,171 @@
+package twilightforest.entity.projectile;
+
+import net.minecraft.core.particles.ColorParticleOption;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.sounds.SoundSource;
+import net.minecraft.world.damagesource.DamageSource;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntityEvent;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.world.phys.EntityHitResult;
+import net.minecraft.world.phys.Vec3;
+import org.jetbrains.annotations.Nullable;
+import twilightforest.entity.boss.PlateauBoss;
+import twilightforest.entity.boss.RuneWard;
+import twilightforest.init.TFEntities;
+import twilightforest.init.TFParticleType;
+import twilightforest.init.TFSounds;
+
+/**
+ * A violet rune of the Final Castle: shot by the Rune Sovereign and by the Rune Scepter. It bends gently towards its
+ * target (never sharper than {@link #MAX_TURN} per tick, so it can be sidestepped) and fades after
+ * {@link #LIFETIME} ticks. Like a Twilight Scepter bolt, a hit sends it back where the hitter looks.
+ */
+public class RuneBolt extends TFThrowable {
+
+	public static final int LIFETIME = 100;
+	private static final double MAX_TURN = 0.06D;
+
+	private float damage = 5.0F;
+	@Nullable
+	private Entity target;
+	private int targetId = -1;
+
+	public RuneBolt(EntityType<? extends RuneBolt> type, Level level) {
+		super(type, level);
+	}
+
+	public RuneBolt(Level level, LivingEntity owner, @Nullable Entity target, float damage) {
+		super(TFEntities.RUNE_BOLT.get(), level, owner);
+		this.damage = damage;
+		this.setTarget(target);
+	}
+
+	public void setTarget(@Nullable Entity target) {
+		this.target = target;
+		this.targetId = target != null ? target.getId() : -1;
+	}
+
+	@Override
+	public void tick() {
+		super.tick();
+		if (this.level().isClientSide()) {
+			this.makeRuneTrail();
+			return;
+		}
+		if (this.tickCount > LIFETIME) {
+			this.level().broadcastEntityEvent(this, EntityEvent.DEATH);
+			this.discard();
+			return;
+		}
+		if (this.target == null && this.targetId >= 0) this.target = this.level().getEntity(this.targetId);
+		if (this.target != null && this.target.isAlive() && this.tickCount > 4) {
+			Vec3 motion = this.getDeltaMovement();
+			double speed = motion.length();
+			Vec3 wanted = this.target.getBoundingBox().getCenter().subtract(this.position()).normalize().scale(speed);
+			Vec3 turn = wanted.subtract(motion);
+			if (turn.length() > MAX_TURN) turn = turn.normalize().scale(MAX_TURN);
+			this.setDeltaMovement(motion.add(turn).normalize().scale(speed));
+		}
+	}
+
+	private void makeRuneTrail() {
+		for (int i = 0; i < 3; i++) {
+			double dx = this.getX() + 0.25D * (this.random.nextDouble() - this.random.nextDouble());
+			double dy = this.getY() + 0.25D * (this.random.nextDouble() - this.random.nextDouble());
+			double dz = this.getZ() + 0.25D * (this.random.nextDouble() - this.random.nextDouble());
+			float shade = this.random.nextFloat() * 0.3F + 0.7F;
+			this.level().addParticle(ColorParticleOption.create(TFParticleType.MAGIC_EFFECT.get(), 0.62F * shade, 0.24F * shade, 0.95F * shade), dx, dy, dz, 0.0D, 0.0D, 0.0D);
+		}
+	}
+
+	@Override
+	protected double getDefaultGravity() {
+		return 0.0D;
+	}
+
+	@Override
+	protected boolean canHitEntity(Entity entity) {
+		Entity owner = this.getOwner();
+		if (owner != null && (entity == owner || entity.isAlliedTo(owner))) return false;
+		// the Sovereign's runes pass through its own wards and the minions it called
+		if (owner instanceof PlateauBoss && (entity instanceof RuneWard || entity.getTags().contains(PlateauBoss.MINION_TAG))) return false;
+		return super.canHitEntity(entity) && !(entity instanceof RuneBolt);
+	}
+
+	@Override
+	public void handleEntityEvent(byte id) {
+		if (id == EntityEvent.DEATH) {
+			for (int i = 0; i < 8; i++) {
+				this.level().addParticle(TFParticleType.ANNIHILATE.get(), false, this.getX(), this.getY(), this.getZ(), this.random.nextGaussian() * 0.05D, this.random.nextDouble() * 0.2D, this.random.nextGaussian() * 0.05D);
+			}
+		} else {
+			super.handleEntityEvent(id);
+		}
+	}
+
+	@Override
+	protected void onHitEntity(EntityHitResult result) {
+		super.onHitEntity(result);
+		if (!this.level().isClientSide()) {
+			Entity hit = result.getEntity();
+			if (hit instanceof LivingEntity) {
+				// a player's runes are magic; the Sovereign's are blunt force, so armour counts against them
+				Entity owner = this.getOwner();
+				hit.hurt(owner instanceof net.minecraft.world.entity.player.Player || !(owner instanceof LivingEntity living)
+					? this.damageSources().indirectMagic(this, owner)
+					: this.damageSources().mobProjectile(this, living), this.damage);
+			}
+			this.level().playSound(null, hit.blockPosition(), TFSounds.TWILIGHT_SCEPTER_HIT.get(), SoundSource.HOSTILE, 0.8F, 0.7F);
+			this.level().broadcastEntityEvent(this, EntityEvent.DEATH);
+			this.discard();
+		}
+	}
+
+	@Override
+	protected void onHitBlock(BlockHitResult result) {
+		super.onHitBlock(result);
+		if (!this.level().isClientSide()) {
+			this.level().broadcastEntityEvent(this, EntityEvent.DEATH);
+			this.discard();
+		}
+	}
+
+	@Override
+	public boolean isPickable() {
+		return true;
+	}
+
+	@Override
+	public float getPickRadius() {
+		return 1.0F;
+	}
+
+	@Override
+	public boolean hurt(DamageSource source, float amount) {
+		if (!this.level().isClientSide() && source.getEntity() instanceof LivingEntity hitter && hitter != this.getOwner()) {
+			// batted back: it now flies where the hitter looks and hunts nobody
+			Vec3 look = hitter.getLookAngle();
+			this.shoot(look.x(), look.y(), look.z(), 1.2F, 0.1F);
+			this.setOwner(hitter);
+			this.setTarget(null);
+			return true;
+		}
+		return false;
+	}
+
+	@Override
+	protected void addAdditionalSaveData(CompoundTag tag) {
+		super.addAdditionalSaveData(tag);
+		tag.putFloat("RuneDamage", this.damage);
+	}
+
+	@Override
+	protected void readAdditionalSaveData(CompoundTag tag) {
+		super.readAdditionalSaveData(tag);
+		if (tag.contains("RuneDamage")) this.damage = tag.getFloat("RuneDamage");
+	}
+}
