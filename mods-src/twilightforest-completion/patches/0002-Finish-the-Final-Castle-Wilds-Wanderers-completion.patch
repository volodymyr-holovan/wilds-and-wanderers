+import org.jetbrains.annotations.Nullable;
+import twilightforest.init.TFParticleType;
+import twilightforest.init.TFSounds;
+
+import java.util.UUID;
+
+/**
+ * A rune ward: a small cube of annihilation the Rune Sovereign keeps circling around itself. While any ward of the
+ * Sovereign stands, the Sovereign takes no damage. Wards do not attack, do not move on their own and vanish when
+ * their Sovereign is gone.
+ */
+public class RuneWard extends Mob {
+
+	public static final float MAX_HEALTH = 30.0F;
+	private static final int ORPHAN_TICKS = 60;
+
+	@Nullable
+	private UUID ownerId;
+	private int orphanTicks;
+
+	public RuneWard(EntityType<? extends RuneWard> type, Level level) {
+		super(type, level);
+		this.setNoGravity(true);
+		this.setPersistenceRequired();
+	}
+
+	public static AttributeSupplier.Builder registerAttributes() {
+		return Mob.createMobAttributes()
+			.add(Attributes.MAX_HEALTH, MAX_HEALTH)
+			.add(Attributes.KNOCKBACK_RESISTANCE, 1.0D)
+			.add(Attributes.MOVEMENT_SPEED, 0.0D);
+	}
+
+	public void setOwner(PlateauBoss owner) {
+		this.ownerId = owner.getUUID();
+	}
+
+	@Nullable
+	public UUID getOwnerId() {
+		return this.ownerId;
+	}
+
+	@Nullable
+	private PlateauBoss findOwner() {
+		if (this.ownerId != null && this.level() instanceof ServerLevel server && server.getEntity(this.ownerId) instanceof PlateauBoss boss && boss.isAlive()) {
+			return boss;
+		}
+		return null;
+	}
+
+	@Override
+	public void tick() {
+		super.tick();
+		if (this.level().isClientSide()) {
+			if (this.random.nextInt(3) == 0) {
+				this.level().addParticle(TFParticleType.ANNIHILATE.get(), this.getRandomX(0.6D), this.getRandomY(), this.getRandomZ(0.6D), 0.0D, 0.0D, 0.0D);
+			}
+			return;
+		}
+		if (this.findOwner() == null) {
+			if (++this.orphanTicks > ORPHAN_TICKS) this.discard();
+		} else {
+			this.orphanTicks = 0;
+		}
+	}
+
+	@Override
+	public boolean hurt(DamageSource source, float amount) {
+		PlateauBoss owner = this.findOwner();
+		float adjusted = owner != null ? CastleBossRules.adjust(this, source, amount, owner.getArena()) : amount;
+		if (adjusted <= 0.0F) return false;
+		return super.hurt(source, adjusted);
+	}
+
+	@Override
+	public void die(DamageSource cause) {
+		super.die(cause);
+		PlateauBoss owner = this.findOwner();
+		if (owner != null) owner.onWardDestroyed(this);
+	}
+
+	@Override
+	protected void tickDeath() {
+		// a ward shatters at once, it has no body to fall over
+		if (!this.level().isClientSide() && !this.isRemoved()) {
+			this.level().broadcastEntityEvent(this, (byte) 60);
+			this.remove(RemovalReason.KILLED);
+		}
+	}
+
+	@Override
+	public boolean isPushable() {
+		return false;
+	}
+
+	@Override
+	protected void doPush(Entity entity) {
+	}
+
+	@Override
+	public boolean causeFallDamage(float distance, float multiplier, DamageSource source) {
+		return false;
+	}
+
+	@Override
+	public boolean removeWhenFarAway(double distance) {
+		return false;
+	}
+
+	@Override
+	protected boolean shouldDropLoot() {
+		return false;
+	}
+
+	@Override
+	protected SoundEvent getHurtSound(DamageSource source) {
+		return SoundEvents.AMETHYST_BLOCK_HIT;
+	}
+
+	@Override
+	protected SoundEvent getDeathSound() {
+		return TFSounds.BLOCK_ANNIHILATED.get();
+	}
+
+	@Override
+	public void addAdditionalSaveData(CompoundTag tag) {
+		super.addAdditionalSaveData(tag);
+		if (this.ownerId != null) tag.putUUID("Sovereign", this.ownerId);
+	}
+
+	@Override
+	public void readAdditionalSaveData(CompoundTag tag) {
+		super.readAdditionalSaveData(tag);
+		if (tag.hasUUID("Sovereign")) this.ownerId = tag.getUUID("Sovereign");
+	}
+}
