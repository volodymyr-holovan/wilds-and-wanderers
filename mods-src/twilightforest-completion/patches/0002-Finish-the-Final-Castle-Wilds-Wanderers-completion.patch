@@ -0,0 +1,92 @@
+package twilightforest.entity.boss;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.tags.DamageTypeTags;
+import net.minecraft.world.damagesource.DamageSource;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntitySelector;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.phys.AABB;
+import net.neoforged.neoforge.common.util.FakePlayer;
+import org.jetbrains.annotations.Nullable;
+
+import java.util.List;
+
+/**
+ * Fair-fight rules shared by the bosses of the Final Castle (Wilds &amp; Wanderers completion of the castle).
+ * <p>
+ * A boss of the castle is meant to be fought by players standing in its arena. These rules keep the fight that way
+ * in a pack full of other mods: one hit never deals more than {@link #MAX_DAMAGE_PER_HIT}, damage with no living
+ * player behind it (lava, cacti, machines, turrets, fake players) counts for a quarter, and an attacker outside the
+ * arena or far away deals nothing.
+ */
+public final class CastleBossRules {
+
+	/** The most one hit may take from a castle boss, whatever the weapon. */
+	public static final float MAX_DAMAGE_PER_HIT = 30.0F;
+	/** Share of the damage that has no real player behind it. */
+	public static final float NON_PLAYER_SHARE = 0.25F;
+	/** An attacker further than this from the boss deals no damage. */
+	public static final double MAX_ATTACK_DISTANCE = 24.0D;
+	/**
+	 * With nobody fighting for this long (game time, so it also counts while the boss's chunk sleeps after its
+	 * players died or left), the boss goes home and heals. A server restart does not move game time.
+	 */
+	public static final int RESET_AFTER_TICKS = 30 * 20;
+	/** Players this close (and not in creative or spectator) keep the fight going. */
+	public static final double ENGAGED_RANGE = 40.0D;
+
+	/**
+	 * This run of the server. A boss saved in another run forgets when it was last fought: players need time to
+	 * reconnect after a restart, and a fight should survive one.
+	 */
+	public static final java.util.UUID SESSION = java.util.UUID.randomUUID();
+
+	private CastleBossRules() {
+	}
+
+	/** The player behind this damage, or null when there is none (or it is a fake player of a machine). */
+	@Nullable
+	public static Player realPlayer(DamageSource source) {
+		Entity attacker = source.getEntity();
+		return attacker instanceof Player player && !(attacker instanceof FakePlayer) ? player : null;
+	}
+
+	/**
+	 * The damage the boss should take, or 0 to ignore the hit.
+	 *
+	 * @param arena the arena the attacker must stand in, or null if anywhere within {@link #MAX_ATTACK_DISTANCE} is fine
+	 */
+	public static float adjust(LivingEntity boss, DamageSource source, float amount, @Nullable AABB arena) {
+		if (source.is(DamageTypeTags.BYPASSES_INVULNERABILITY)) return amount; // /kill and the void
+		Entity attacker = source.getEntity();
+		if (attacker == boss) return 0.0F;
+		if (attacker != null) {
+			if (attacker.distanceToSqr(boss) > MAX_ATTACK_DISTANCE * MAX_ATTACK_DISTANCE) return 0.0F;
+			if (arena != null && !arena.contains(attacker.position())) return 0.0F;
+		}
+		if (realPlayer(source) == null) amount *= NON_PLAYER_SHARE;
+		return Math.min(amount, MAX_DAMAGE_PER_HIT);
+	}
+
+	/**
+	 * Whether the fight has been abandoned: nobody fought for {@link #RESET_AFTER_TICKS} of game time. A boss calls
+	 * this every tick with whether players are engaged and the game time they last were (0: never).
+	 */
+	public static boolean abandoned(long now, long lastEngaged) {
+		return lastEngaged > 0 && now - lastEngaged > RESET_AFTER_TICKS;
+	}
+
+	/** Removes the minions a castle boss called (tagged {@link PlateauBoss#MINION_TAG}) around its arena. */
+	public static void discardMinions(LivingEntity boss, AABB area) {
+		boss.level().getEntitiesOfClass(net.minecraft.world.entity.Mob.class, area, e -> e.getTags().contains(PlateauBoss.MINION_TAG)).forEach(net.minecraft.world.entity.Entity::discard);
+	}
+
+	/** Living players near the arena that are really fighting (not in creative or spectator). */
+	public static List<ServerPlayer> engagedPlayers(LivingEntity boss, BlockPos home) {
+		AABB box = new AABB(home).inflate(ENGAGED_RANGE);
+		return boss.level().getEntitiesOfClass(ServerPlayer.class, box, p -> EntitySelector.NO_CREATIVE_OR_SPECTATOR.test(p) && p.isAlive());
+	}
+}
