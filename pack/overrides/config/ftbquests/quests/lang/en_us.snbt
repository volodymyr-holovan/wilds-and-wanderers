	]
	quest.5A58857FD0D63BB0.title: "Автокрафт"
	quest.5B2012F494AA9FD1.quest_desc: [
		"&aЗбагачувальна камера&r робить з однієї руди два шматки пилу; &aенергетична плавильня&r — злитки з пилу. Руда ×2."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.enrichment_chamber\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.energized_smelter\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
