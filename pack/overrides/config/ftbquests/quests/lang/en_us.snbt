		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanismgenerators:fusion_reactor_controller\"}}]"
	]
	quest.418978ACFC21C8F0.title: "Термоядерний реактор"
	quest.41DDF6384AE8A872.quest_desc: [
		"&aОкуляри інженера&r показують швидкість і навантаження. &aКлюч&r повертає блоки й миттєво розбирає механізми (присядьте + ПКМ)."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.create.goggles\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.create.wrench\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.create.goggles\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.create.wrench\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:goggles\"}}]"
	]
	quest.41DDF6384AE8A872.title: "Окуляри й ключ"
	quest.41FBF525341CAAEF.quest_desc: [
		"Мантії Ars збільшують ману й її відновлення. Найкращі — з &aтканини магоцвіту&r (рослина, що росте на землі, политій джерелом)."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.magebloom_fiber\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.sorcerer_robes\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ars_nouveau.magebloom_fiber\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ars_nouveau.sorcerer_robes\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"ars_nouveau: dye, Ars: зачаровувальний апарат\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:magebloom_fiber\"}}]"
	]
	quest.41FBF525341CAAEF.title: "Мантія чарівника"
	quest.424B8F8834C8B61F.quest_desc: [
		"&6Король-вигнанець Мстислав&r, король без королівства &8(доручення 5 з 5)&r:"
		"&o«Дракон спалив мою столицю. Мої лицарі загинули, мій народ розбрівся. Я поклявся не вдягати корону, поки звір живий.»&r"
		"&o«Мені не потрібна його голова — мені потрібен лише знак, що його більше нема. А все, що лишилося в моїй скарбниці, — ваше.»&r"
		"&fПодолайте вогняного дракона — щонайменше третьої стадії. Зілля вогнестійкості, лук і рухливість — ваша надія."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.netherite_ingot\", \"color\": \"aqua\"}, {\"text\": \" ×2\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.enchanted_golden_apple\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.diamond\", \"color\": \"aqua\"}, {\"text\": \" ×10\", \"color\": \"gray\"}, {\"text\": \", 1000 досвіду, скриня здобичі, 400 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.iceandfire.fire_dragon\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:iceandfire:fire_dragon\"}}]"
	]
	quest.424B8F8834C8B61F.title: "Убивця драконів"
	quest.426A1D5C1725A5FE.quest_desc: [
		"Орки ставлять самотні хатини на рівнинах і в лісах. Вони сильні й живучі, але повільні. Нагорода — скриня орка з усім, що він награбував."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.orc_hut.orc\", \"color\": \"red\"}, {\"text\": \" ×3\"}]"
		""
		"&6Де:&r рівнини й ліси."
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Як знайти:&r Компас дослідника → «orc_hut»."
		"&6Порада:&r стріляйте з лука і відходьте — орк не встигає наздогнати."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:orc_hut:orc\"}}]"
	]
	quest.426A1D5C1725A5FE.title: "Хатина орків"
	quest.43043663512BAACC.quest_desc: [ ]
	quest.43043663512BAACC.title: "Пір'я воронів"
	quest.4332297DBDD8288C.quest_desc: [
		"Поставте &aнарізну дошку&r, покладіть на неї продукт (правою кнопкою) і клацніть ножем."
		"Так з однієї курки виходить кілька шматків м'яса, а з капусти — листя для салатів."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.farmersdelight.cutting_board\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.farmersdelight.cutting_board\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki farmersdelight:cutting_board\"}}]"
	]
	quest.4332297DBDD8288C.title: "Нарізна дошка"
	quest.43602039D80CECD1.quest_desc: [
		"Незер у цьому світі переписано: вісім нових біомів &6Incendium&r, маєтки й катакомби &6Eternal Nether&r, перебудовані фортеці, живі лавові моря й фрукти в кожному лісі."
		""
		"Складіть рамку з &aобсидіану&r 4×5 (кути можна пропустити) і підпаліть її кресалом. Обсидіан дає вода, вилита на лаву; добувають його алмазним кайлом."
		""
		"&6Перед дорогою:&r золота броня (хоча б одна частина) — пігліни не нападуть; вогнестійкість, блоки й кресало, щоб запалити портал назад."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Потрапити у вимір: \", \"color\": \"gray\"}, {\"text\": \"Незер\", \"color\": \"light_purple\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:obsidian\"}}]"
	]
	quest.43602039D80CECD1.title: "Брама в Незер"
	quest.4395B0DE22956292.quest_desc: [
		"&aНезеритова книга заклинань&r — найбільше місць для заклять. Разом з легендарними чорнилами — вершина Iron's Spells."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.irons_spellbooks.netherite_spell_book\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.irons_spellbooks.legendary_ink\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.irons_spellbooks.netherite_spell_book\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.irons_spellbooks.legendary_ink\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: наповнювач, Iron's: казан алхіміка\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki irons_spellbooks:netherite_spell_book\"}}]"
	]
	quest.4395B0DE22956292.title: "Незеритова книга"
	quest.43A0497E42EE7260.quest_desc: [
		"&aКнига учня&r — друга книга заклинань Ars Nouveau. Вона відкриває гліфи другого рівня, вміщує довші закляття й більше слотів для них. Стару книгу кладуть у рецепт — вивчені гліфи й закляття не губляться."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.apprentice_spell_book\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ars_nouveau.apprentice_spell_book\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"ars_nouveau: book upgrade, ars_nouveau: dye\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:apprentice_spell_book\"}}]"
	]
	quest.43A0497E42EE7260.title: "Книга учня"
	quest.43CDFE0D36955627.quest_desc: [
		"&aМеханічний прес&r розплющує злитки в листи (&aзалізні листи&r — основа машин) і пресує предмети в чані. Поставте його над конвеєром чи стійкою (депо) й крутіть від вала — він оброблятиме все, що проїжджає під ним."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.mechanical_press\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.depot\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.create.iron_sheet\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.mechanical_press\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.depot\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.create.iron_sheet\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: прес\", \"color\": \"white\"}]"
		""
		"&6Як:"
		"&71.&r Поставте прес над &aстендом&r (depot) або над конвеєром."
		"&72.&r Подайте обертання, покладіть злитки на стенд — прес зробить листи."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:mechanical_press\"}}]"
	]
	quest.43CDFE0D36955627.title: "Механічний прес"
	quest.4419BAEE2267E7DA.quest_desc: [
		"Перебудований монумент — справжнє підводне підземелля з крилами, скарбницями і трьома старшими вартовими."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.elder_guardian\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r глибокий океан."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r молоко від втоми, зілля підводного дихання, тризуб або «Спритність у воді»"
		"&6Як знайти:&r Компас дослідника → «ocean_monument» (Better Ocean Monuments)."
		"&6Порада:&r &aокеанська кухня&r (Ocean's Delight) готує м'ясо вартових — сушіть і смажте їх."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:elder_guardian\"}}]"
	]
	quest.4419BAEE2267E7DA.title: "Океанський монумент"
	quest.4426FE841F4EE5CE.quest_desc: [
		"&6Пілігрим Савва&r, пілігрим:"
		"&o«Я дав обітницю пройти п'ять тисяч блоків пішки до святого місця. Пройшов половину і зламав ногу. Обітниця не може чекати.»&r"
		"&o«Пройдіть за мене решту — ваші кроки зарахуються мені, бо дорога пам'ятає, хто її просив.»&r"
		"&fПройдіть п'ять тисяч блоків пішки (рахується від прийняття завдання в книзі квестів)."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.diamond_boots\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×20\", \"color\": \"gray\"}, {\"text\": \", 500 досвіду, 200 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Пройти пішки: \", \"color\": \"gray\"}, {\"text\": \"5000 блоків\", \"color\": \"yellow\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:leather_boots\"}}]"
	]
	quest.4426FE841F4EE5CE.title: "Довга дорога"
	quest.447DACEC13F05C6B.quest_desc: [
		"Проклятий воїн-привид із крижаної в'язниці. Літає, кидає списи й закликає мерців. Нагорода — &aкурсій&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.cataclysm.maledictus\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aКрижана в'язниця&r у засніжених краях."
		"&6Складність:&r &c★★★★★&8&r — смертельно"
		"&6Спорядження:&r незеритова або драконяча броня, «Небесна кара» на мечі"
		"&6Як знайти:&r &aПрокляте око&r (золото, кістка, мембрана фантома, гнила плоть, око Енду) або Компас дослідника → «frosted_prison»."
		"&6Порада:&r у польоті він вразливий до стріл."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:cataclysm:maledictus\"}}]"
	]
	quest.447DACEC13F05C6B.title: "Маледиктус"
	quest.44ED1F2F0B642A12.quest_desc: [
		"&6Устим&r, конюх:"
		"&o«Я розводжу коней для гінців, а гінці скаржаться: коні ліниві, бігають тільки до стайні. Треба їх об'їздити — довго, далеко, щодня.»&r"
		"&o«Але я впав і вже не сяду в сідло. Пропоную угоду: беріть будь-якого дикого коня, проїдьте на ньому п'ятсот блоків — і він ваш назавжди, а з мене ще й сідло.»&r"
		"&fПроїдьте верхи п'ятсот блоків. Дикого коня осідлаєте після кількох спроб — сідайте, поки він не скоряється."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.saddle\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.golden_carrot\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.iron_horse_armor\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", 120 досвіду, 50 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Проїхати верхи: \", \"color\": \"gray\"}, {\"text\": \"500 блоків\", \"color\": \"yellow\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:saddle\"}}]"
	]
	quest.44ED1F2F0B642A12.title: "Утеклий кінь"
	quest.44FEBB24FB1C3393.quest_desc: [
		"&aЗаводський датчик&r планує виробництво: ви кажете «тримай 64 точні механізми», і він сам замовляє сировину зі складу, відправляє на машини й складає готове."
		"Це вершина Create: завод, що працює без вас."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.factory_gauge\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.factory_gauge\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:factory_gauge\"}}]"
	]
	quest.44FEBB24FB1C3393.title: "Автоматичний завод"
	quest.450FD4F2B4192C24.quest_desc: [
		"&aРеактор поділу&r палить ядерне паливо (з урану) й гріє натрій або воду в пару. Небезпечно: перегрів — вибух і радіація. Стежте за охолодженням і ставте логічний адаптер на аварійне вимкнення!"
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanismgenerators.fission_reactor_casing\", \"color\": \"aqua\"}, {\"text\": \" ×24\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanismgenerators.fission_fuel_assembly\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanismgenerators.control_rod_assembly\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanismgenerators.fission_reactor_port\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanismgenerators.fission_reactor_logic_adapter\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.mekanismgenerators.fission_reactor_casing\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.mekanismgenerators.fission_fuel_assembly\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.mekanismgenerators.control_rod_assembly\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Порада:&r починайте зі швидкості горіння 0,1 мБ/т і завжди майте охолодження із запасом."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanismgenerators:fission_reactor_casing\"}}]"
	]
	quest.450FD4F2B4192C24.title: "Ядерний реактор"
	quest.454CF63929EC1CFD.quest_desc: [
		"Коли будівель багато, ресурси треба розвозити. &aСклад&r збирає все добро колонії, а &aкур'єри&r носять його туди, де бракує."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecolonies.blockhutwarehouse\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecolonies.blockhutdeliveryman\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecolonies.blockhutwarehouse\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.minecolonies.blockhutdeliveryman\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Порада:&r у склад можна скидати й власні ресурси: будівельник візьме звідти сам."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecolonies:blockhutwarehouse\"}}]"
	]
	quest.454CF63929EC1CFD.title: "Склад і кур'єр"
	quest.45E52B7BEEC45241.quest_desc: [ ]
	quest.45E52B7BEEC45241.title: "Водяні колеса"
	quest.45EE77007A516A2C.quest_desc: [
		"Міста Енду перебудовано: у них стоять &5випробувальні породжувачі Енду&r. Переможіть їхніх істот — випаде &aключ від міста Енду&r. Він відмикає &5сховище Енду&r: дзеркала, небуліт, платівки й шаблон оздоблення «Стазис»."
		""
		"На кораблі міста — окреме сховище з &aелітрами&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.enderscape.end_city_key\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r відро води й повільне падіння: шалкери підкидають у повітря"
		"&6Як знайти:&r Компас дослідника → «end_city»."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki enderscape:end_city_key\"}}]"
	]
	quest.45EE77007A516A2C.title: "Ключ від сховища"
	quest.46C87D2FEBB383BF.quest_desc: [
		"Намет, спальник, їжа й факели — все вміщається в &aрюкзак&r. Покращення рюкзака: підбирач, магніт, годувальник, вогнище для готування на ходу."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.sophisticatedbackpacks.backpack\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.sophisticatedbackpacks.backpack\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"sophisticatedbackpacks: basic backpack\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki sophisticatedbackpacks:backpack\"}}]"
	]
	quest.46C87D2FEBB383BF.title: "Рюкзак мандрівника"
	quest.46D334DCD21AD77A.quest_desc: [
		"Гармату ставлять на борт через верф. Набої:"
		" • &aядро&r — звичайний постріл;"
		" • &aланцюгове ядро&r — рве вітрила;"
		" • &aкартеч&r — близько, але страшно для екіпажу;"
		" • &aдрібний порох&r — +50% дальності при перезарядці."
		""
		"&dЗв'язок світу:&r піратські кораблі Seven Seas і нежиті пірати теж мають гармати — тепер ви на рівних."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.smallships.cannon\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.smallships.cannon_ball\", \"color\": \"aqua\"}, {\"text\": \" ×16\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.smallships.cannon\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.smallships.cannon_ball\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki smallships:cannon\"}}]"
	]
	quest.46D334DCD21AD77A.title: "Гармати"
	quest.46D9BA6A550DD1BB.quest_desc: [
		"Альфа-єті кидає крижані брили й оглушує ударом об землю. Коли він утомлюється і сідає — ваш час."
		"Нагорода: &aхутро альфа-єті&r для теплої броні, яка сповільнює ворогів."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.twilightforest.alpha_yeti\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aПечера єті&r — великий пагорб у &aСніжному лісі&r з печерою всередині."
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Спорядження:&r лук, зілля швидкості, щит"
		"&6Як знайти:&r Магічна мапа (значок єті) або Компас дослідника → «yeti_cave»."
		"&6Порада:&r тікайте від брил убік, а не назад — вони летять по дузі."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:twilightforest:alpha_yeti\"}}]"
	]
	quest.46D9BA6A550DD1BB.title: "Альфа-єті"
	quest.470770840ED2623E.quest_desc: [ ]
	quest.470770840ED2623E.title: "Магнітна загадка"
	quest.471AAFD53ED3CF06.quest_desc: [ ]
	quest.471AAFD53ED3CF06.title: "Навколо світу"
	quest.4720862DF6AF0F4B.quest_desc: [
		"&6Майстер Гервасій&r, вигнаний чарівник:"
		"&o«Ліч, що сидить у вежі, — мій колишній учень. Він знайшов книгу безсмертя і прочитав її до кінця. Я встиг утекти, а мою вежу він забрав собі.»&r"
		"&o«Принесіть мені його трофей — голову, що лишається після поразки. Тоді я знатиму, що він більше не прочитає жодної книги.»&r"
		"&fПодолайте ліча на вершині його вежі й принесіть його трофей. Відбивайте його вогняні кулі мечем — так збиваються щити."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.enchanted_golden_apple\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.experience_bottle\", \"color\": \"aqua\"}, {\"text\": \" ×16\", \"color\": \"gray\"}, {\"text\": \", 400 досвіду, скриня здобичі, 150 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.twilightforest.lich_trophy\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.twilightforest.lich_trophy\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.twilightforest.lich\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki twilightforest:lich_trophy\"}}]"
	]
	quest.4720862DF6AF0F4B.title: "Вежа ліча"
	quest.47292410B032CA71.quest_desc: [
		"&aСпальник&r дозволяє проспати ніч будь-де, &eне змінюючи точку відродження&r. &aГамак&r — те саме вдень: проспіть до вечора. Гамак вішають між двома &aмотузками з цвяхом&r на стовпах чи стінах."
		"Обидва згортаються в предмет, тож завжди їдуть у рюкзаку."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.comforts.sleeping_bag_brown\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.comforts.sleeping_bag_brown\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki comforts:sleeping_bag_brown\"}}]"
	]
	quest.47292410B032CA71.title: "Спальник і гамак"
	quest.47A8A9E1874569A7.quest_desc: [
		"Молоді й дорослі дракони живуть у &aгніздах&r на поверхні: обвуглена чи замерзла земля, купи золота й кістки. Старі дракони сплять у &aпечерах&r під землею, на величезних скарбах."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Знайти споруду: \", \"color\": \"gray\"}, {\"translate\": \"wilds_wiki.structure.iceandfire.fire_dragon_roost\", \"color\": \"gold\"}]"
		""
		"&6Де:&r вогняні — рівнини, ліси, пустелі; крижані — засніжені краї; грозові — джунглі, бедленди, савани."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Як знайти:&r Компас дослідника → «fire_dragon_roost», «ice_dragon_roost», «lightning_dragon_roost» (печери: «…_dragon_cave»)."
		"&6Порада:&r наближайтеся, коли дракон спить: заплющені очі й тихе дихання. Сплячий дракон не бачить вас, доки не вдарите."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki iceandfire:dragonscales_red\"}}]"
	]
	quest.47A8A9E1874569A7.title: "Знайти гніздо дракона"
	quest.483E5D289A43B965.quest_desc: [
		"Пара &aдробильних коліс&r — швидше й вигідніше за жорна: сира руда стає подрібненою з бонусом, а камінь — гравієм і піском."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.crushing_wheel\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.crushing_wheel\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: механічний верстак\", \"color\": \"white\"}]"
		""
		"&6Як:"
		"&71.&r Поставте два колеса поруч на відстані одного блока, крутіть їх назустріч одне одному."
		"&72.&r Сипте предмети згори (лійкою чи з конвеєра)."
		""
		"&6Порада:&r ряд коліс + вентилятор з водою = подвоєння руд ще до Mekanism."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:crushing_wheel\"}}]"
	]
	quest.483E5D289A43B965.title: "Дробильні колеса"
	quest.488D62A844F2EA3C.quest_desc: [
		"&6Король-вигнанець Мстислав&r, король без королівства &8(доручення 4 з 5)&r:"
		"&o«Залізо плавиться в драконячому вогні, а з ним і той, хто в ньому. Мій коваль казав: є метал, що не горить, — його добувають у Незері з древніх уламків.»&r"
		"&o«Мені потрібен один злиток. Не для мене — для щита, за яким ви підете на звіра.»&r"
		"&fДобудьте злиток незериту: древні уламки з Незеру, переплавлені з золотом."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.enchanted_golden_apple\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×16\", \"color\": \"gray\"}, {\"text\": \", 400 досвіду, 150 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.netherite_ingot\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.netherite_ingot\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"доменна піч, верстак, піч\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:netherite_ingot\"}}]"
	]
	quest.488D62A844F2EA3C.title: "Метал, що не горить"
	quest.48FFC60749B6D51D.quest_desc: [
		"Найбільші загрози морів — &aЛевіятан&r затонулого міста і &aСцилла&r з Акрополя. Їх бої описані в главі &4Великі боси&r; тут — нагорода моряка за обох."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.cataclysm.the_leviathan\", \"color\": \"red\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.cataclysm.scylla\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:cataclysm:the_leviathan\"}}]"
	]
	quest.48FFC60749B6D51D.title: "Морські владики"
	quest.49053BD3207400C9.quest_desc: [ ]
	quest.49053BD3207400C9.title: "Яйце динозавра"
	quest.493C01348F1C1D75.quest_desc: [
		"&aУр-ґаст&r — гігантський плакучий ґаст на верхівці вежі. Щоб він спустився, убийте малих ґастів біля &aпасток для ґастів&r: пастка засвітиться і притягне ур-ґаста."
		"Нагорода: &aвогняні сльози&r і &aкармініт&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.twilightforest.ur_ghast\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aТемна вежа&r — дуже висока вежа з вежового дерева в Темному лісі. Всередині — блоки-механізми, що зникають і з'являються."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r лук і багато стріл, вогнестійкість, блоки для сходів"
		"&6Як знайти:&r Магічна мапа (значок вежі) або Компас дослідника → «dark_tower»."
		"&6Порада:&r у вежі живуть &aкармінітові големи&r і &aкороїди&r; не ламайте стіни навмання."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:twilightforest:ur_ghast\"}}]"
	]
	quest.493C01348F1C1D75.title: "Ур-ґаст"
	quest.4AA53735D401CF8A.quest_desc: [ ]
	quest.4AA53735D401CF8A.title: "Ліки від опіків"
	quest.4AF54FD9C9D04A13.quest_desc: [
		"&aПомпа&r жене рідину трубами, &aносик&r наливає її в предмети (мед у пляшки, воду в цеглу), &aзливач&r спорожнює. Великі &aбаки&r зберігають тисячі відер."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.mechanical_pump\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.fluid_pipe\", \"color\": \"aqua\"}, {\"text\": \" ×16\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.spout\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.item_drain\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.fluid_tank\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.mechanical_pump\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.fluid_pipe\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.spout\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:mechanical_pump\"}}]"
	]
	quest.4AF54FD9C9D04A13.title: "Рідини"
	quest.4AFFED01D2C16218.quest_desc: [
		"&aКит-могильник&r — скелет велетенського кита на дні. Навколо нього збирається дивне життя: крабі, черви, глибоководні риби."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Знайти споруду: \", \"color\": \"gray\"}, {\"translate\": \"wilds_wiki.structure.hybrid_aquatic.whale_fall\", \"color\": \"gold\"}]"
		""
		"&6Де:&r глибокі океани, на самому дні."
		"&6Складність:&r &c★★&8★★★&r — помірно"
		"&6Як знайти:&r Компас дослідника → «whale_fall»."
		"&6Порада:&r тут ловлять рідкісних глибоководних мешканців сачком для істот."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:bone_block\"}}]"
	]
	quest.4AFFED01D2C16218.title: "Кістки кита"
	quest.4B235C856EFB8D66.quest_desc: [
		"Вежі піроманта, гірські вежі, форт заклиначів, катакомби — споруди Iron's Spells, повні сувоїв, чорнил і магів-ворогів."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Знайти споруду: \", \"color\": \"gray\"}, {\"translate\": \"wilds_wiki.structure.irons_spellbooks.pyromancer_tower\", \"color\": \"gold\"}]"
		""
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Як знайти:&r Компас дослідника: «Вежа піроманта», «Гірська вежа», «Форт заклиначів», «Катакомби»"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki irons_spellbooks:wayward_compass\"}}]"
	]
	quest.4B235C856EFB8D66.title: "Вежі магів"
	quest.4B313CB4D81F20C8.quest_desc: [
		"&aПутівні камені&r стоять у селах і вздовж доріг. Активуйте камінь — і зможете повернутися до нього з будь-якого іншого. &aСувій повернення&r переносить до останнього каменю, &aсувій перенесення&r — до будь-якого."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.waystones.return_scroll\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.waystones.return_scroll\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki waystones:return_scroll\"}}]"
	]
	quest.4B313CB4D81F20C8.title: "Шлях додому"
	quest.4B48363F7B1742E7.quest_desc: [
		"&6Остап&r, старий садівник &8(доручення 1 з 2)&r:"
		"&o«Сорок років тому я посадив біля нашої хати кущ троянд для своєї Марти. Цієї весни Марти не стало, а за нею зів'яв і кущ — наче знав.»&r"
		"&o«Я хочу посадити нові на її могилі. Але ноги вже не носять мене далі ґанку, а троянди ростуть лише на квітучих луках та в лісах, де їх ніхто не топче.»&r"
		"&fПринесіть мені шість трояндових кущів. Я заплачу, чим маю."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.bone_meal\", \"color\": \"aqua\"}, {\"text\": \" ×16\", \"color\": \"gray\"}, {\"text\": \", 120 досвіду, 40 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.rose_bush\", \"color\": \"aqua\"}, {\"text\": \" ×6\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecraft.rose_bush\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"у природі: \", \"color\": \"gray\"}, {\"translate\": \"biome.terralith.highlands\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:rose_bush\"}}]"
	]
	quest.4B48363F7B1742E7.title: "Троянди для Марти"
	quest.4B6C8F4CC345EEFF.quest_desc: [ ]
	quest.4B6C8F4CC345EEFF.title: "Проклятий колодязь"
	quest.4B6DEB35841B67C8.quest_desc: [
		"&aКамера хімічного впорскування&r з газом хлороводню дає з руди чотири осколки. Хлороводень — з солі (термальне випаровування або пісок у вентиляторі) у &aхімічному наповнювачі&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.chemical_injection_chamber\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.chemical_infuser\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.mekanism.chemical_injection_chamber\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: mek data\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.mekanism.chemical_infuser\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: mek data\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanism:chemical_injection_chamber\"}}]"
	]
	quest.4B6DEB35841B67C8.title: "Руда ×4"
	quest.4B6FF15B9353A971.quest_desc: [
		"&aСувої&r з закляттями трапляються в скринях підземель і веж. Сувій можна прочитати один раз або вписати в книгу — тоді закляття ваше назавжди."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.irons_spellbooks.scroll\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.irons_spellbooks.scroll\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.irons_spellbooks.apothecarist\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.irons_spellbooks.archevoker\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.irons_spellbooks.cryomancer\", \"color\": \"white\"}, {\"text\": \" і ще 5\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki irons_spellbooks:scroll\"}}]"
	]
	quest.4B6FF15B9353A971.title: "Перше закляття"
	quest.4BDF0543B35691C4.quest_desc: [ ]
	quest.4BDF0543B35691C4.title: "Пісня сирени"
	quest.4C66DAA45F962751.quest_desc: [
		"Вершина переробки: &aрозчинна камера&r (сірчана кислота) робить з руди «брудну суспензію», &aпромивач&r її чистить, &aкристалізатор&r вирощує кристали. П'ять злитків з руди."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.chemical_dissolution_chamber\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.chemical_washer\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.chemical_crystallizer\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.mekanism.chemical_dissolution_chamber\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: mek data\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.mekanism.chemical_washer\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: mek data\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.mekanism.chemical_crystallizer\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanism:chemical_dissolution_chamber\"}}]"
	]
	quest.4C66DAA45F962751.title: "Руда ×5"
	quest.4C7219F5707835B6.quest_desc: [
		"&6Мрійник Захар&r, мандрівник на страйдері:"
		"&o«Я переплив лавове море на страйдері! Ну, майже переплив — посередині моя вудка з грибом зламалася, і він поніс мене назад.»&r"
		"&o«Зробіть мені нову: вудка й викривлений гриб. Я ще раз спробую, а вам розповім, що там, на тому березі.»&r"
		"&fПринесіть викривлений гриб на вудці."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.saddle\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×10\", \"color\": \"gray\"}, {\"text\": \", 180 досвіду, 70 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.warped_fungus_on_a_stick\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.warped_fungus_on_a_stick\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:warped_fungus_on_a_stick\"}}]"
	]
	quest.4C7219F5707835B6.title: "Подорож лавою"
	quest.4C887C73FF4A70DC.quest_desc: [ ]
	quest.4C887C73FF4A70DC.title: "Співучий кристал"
	quest.4C8C83EC68775450.quest_desc: [
		"На сервер можна заходити і з ліцензійної, і з піратської версії, тому кожен нік захищений паролем."
		""
		" • Перший вхід: &a/register пароль пароль&r"
		" • Кожен наступний вхід: &a/login пароль&r"
		" • Змінити пароль: &a/changepassword старий новий новий&r"
		""
		"Поки ви не ввійшли, рухатися й писати в чат не можна — це захист від чужих людей з вашим ніком. На реєстрацію чи вхід дається 1 хвилина: не встигли — сервер відключить, просто зайдіть знову."
		""
		"&6Порада:&r не використовуйте пароль від пошти чи інших сайтів. Скін для піратської версії: &a/skin set mojang НікЛіцензійногоГравця&r."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:name_tag\"}}]"
	]
	quest.4C8C83EC68775450.title: "Ваш акаунт на сервері"
	quest.4CF6CE6BADD27998.quest_desc: [
		"&aКнига архімага&r — усі гліфи всіх рівнів і найдовші закляття. Вершина Ars Nouveau: з нею можна складати складні комбінації на кшталт «снаряд → розкол → вибух → підпал». Робиться з книги майстра й рідкісних частин диких (Wilden)."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.archmage_spell_book\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ars_nouveau.archmage_spell_book\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"ars_nouveau: book upgrade, ars_nouveau: dye\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:archmage_spell_book\"}}]"
	]
	quest.4CF6CE6BADD27998.title: "Книга архімага"
	quest.4CF85D080C33CE5F.quest_desc: [
		"Ars Nouveau — магія, яку ви складаєте самі: &aформа&r (як летить), &aефекти&r (що робить) і &aпідсилення&r. Зошит — його довідник: усе з картинками й рецептами."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.worn_notebook\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ars_nouveau.worn_notebook\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Як:"
		"&71.&r Скрафтіть зошит із книги й лазуриту."
		"&72.&r ПКМ — відкрити; навівши на предмет у світі й затиснувши Ctrl, бачите його сторінку."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:worn_notebook\"}}]"
	]
	quest.4CF85D080C33CE5F.title: "Пошарпаний зошит"
	quest.4D55A499F9F381DB.quest_desc: [ ]
	quest.4D55A499F9F381DB.title: "Луска для обладунку"
	quest.4D805B465BE380D3.quest_desc: [ ]
	quest.4D805B465BE380D3.title: "Мовчазне місто"
	quest.4D99A8CFA26DCE2B.quest_desc: [
		"&6Оксана&r, наречена:"
		"&o«За три дні моє весілля! Мама наказала зварити медовуху на все село — а наш пасічник саме впав із драбини й зламав ногу.»&r"
		"&o«Бджоли його мене не знають і жалять. Я вже двічі пробувала. Подивіться на мою руку!»&r"
		"&fПринесіть шість пляшечок меду. Порада від пасічника: розведіть під вуликом багаття — дим заспокоює бджіл."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"block.minecraft.cake\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×5\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.honeycomb\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", 90 досвіду, 30 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.honey_bottle\", \"color\": \"aqua\"}, {\"text\": \" ×6\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.honey_bottle\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: наповнювач, верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:honey_bottle\"}}]"
	]
	quest.4D99A8CFA26DCE2B.title: "Мед на весілля"
	quest.4DF64BB8F53D030D.quest_desc: [ ]
	quest.4DF64BB8F53D030D.title: "Павуча королева"
	quest.4F4657381B27B081.quest_desc: [
		"У спорудах світу — від сільських хат до підземних катакомб і палуб розбитих кораблів — трапляються &eмандрівники&r із золотим &6«!»&r над головою."
		""
		"Підійдіть ближче — вони заговорять самі. Вислухайте історію, розпитайте, а тоді &aвізьміться&r за справу чи відмовтеся."
		"Можна спробувати &dвиторгувати&r більшу плату — шанс росте з гілкою «Дипломат» у навичках (K). Навичка &dКрасномовство&r відкриває ризиковану брехню — лише в найцінніших дорученнях."
		""
		"&6«!»&r — у мандрівника є для вас справа. &6«?»&r — справу виконано, поверніться по нагороду. Сірий &7«?»&r — ви ще працюєте над нею. Коли ви виконали всі його доручення, знак зникає."
		"Дехто з мандрівників, переконавшись, що вам можна довіряти, дає наступну справу — більшу й ціннішу (до п'яти поспіль)."
		""
		"Узяте доручення з'являється в цьому розділі. Виконайте його й поверніться до мандрівника по нагороду. Кожен гравець отримує й виконує доручення окремо."
		"&cМандрівники смертні.&r Якщо замовник загине раніше, ніж ви повернетеся, — доручення провалено."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:writable_book\"}}]"
	]
	quest.4F4657381B27B081.title: "Мандрівники з дорученнями"
	quest.4F596DD2F2BAF8E1.quest_desc: [
		"Елітри — найкращий спосіб подорожувати. Феєрверки дають тягу, «Відновлення» лагодить їх досвідом."
		""
		"Enderscape додає елітрам чари: &aВідскок&r (затисніть стрибок у польоті) і &aСвітлова швидкість&r (далі на одному розгоні)."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.elytra\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:elytra\"}}]"
	]
	quest.4F596DD2F2BAF8E1.title: "Крила"
	quest.4F69A01081418F8F.quest_desc: [
		"&6Ярема&r, колишній солдат &8(доручення 1 з 4)&r:"
		"&o«Я служив прикордонником, поки розбійники не спалили нашу заставу. Вижив один — бо втік. Двадцять років я не можу собі цього простити.»&r"
		"&o«Зараз їхня застава знову стоїть неподалік. Мої руки трусяться, коли беру арбалет. Але ваші, бачу, ні.»&r"
		"&fПокладіть вісьмох розбійників. Може, тоді я засну хоч одну ніч без того вогню перед очима."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.crossbow\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.arrow\", \"color\": \"aqua\"}, {\"text\": \" ×32\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", 200 досвіду, 80 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.pillager\", \"color\": \"red\"}, {\"text\": \" ×8\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:pillager\"}}]"
	]
	quest.4F69A01081418F8F.title: "Прапор розбійників"
	quest.502371386B2DC7B8.quest_desc: [
		"&aПровісник&r — механічний висохлий з Катаклізму, сторож руїн у глибинах. Стріляє лазерами й ракетами, вибухає при наближенні. Тримайтеся на відстані, ховайтеся за колонами від лазера. Нагорода — &aвітерит&r для зброї."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.cataclysm.the_harbinger\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aСтародавня фабрика&r глибоко під землею."
		"&6Складність:&r &c★★★★★&8&r — смертельно"
		"&6Спорядження:&r незеритова броня з «Захистом від вибухів», молоко від висихання"
		"&6Як знайти:&r &aМеханічне око&r (блоки редстоуну, залізо, око Енду) або Компас дослідника → «ancient_factory»."
		"&6Порада:&r ховайтеся за колонами від лазера — він б'є по прямій."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:cataclysm:the_harbinger\"}}]"
	]
	quest.502371386B2DC7B8.title: "Провісник"
	quest.50237B83E9E5452D.quest_desc: [
		"&aАмброзій&r — паливо для &aвівтаря&r (зачаровує предмети) і &aморозильника&r Етеру. З &aзанітових&r самоцвітів роблять міцні інструменти: чим більше вони зношені, тим сильніші."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.aether.ambrosium_shard\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.aether.zanite_gemstone\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.aether.ambrosium_shard\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: дробарка, доменна піч, верстак\", \"color\": \"white\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.aether.mimic\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.aether.zanite_gemstone\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: дробарка, доменна піч, верстак\", \"color\": \"white\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.aether.mimic\", \"color\": \"white\"}]"
		""
		"&6Де:&r руда в &aсвятокамені&r — сірому камені островів, на будь-якій висоті."
		"&6Складність:&r &c★&8★★★★&r — легко"
		"&6Порада:&r амброзієві уламки також лікують — з'їжте один у скруті."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki aether:ambrosium_shard\"}}]"
	]
	quest.50237B83E9E5452D.title: "Амброзій і заніт"
	quest.5046CED417FCD255.quest_desc: [ ]
	quest.5046CED417FCD255.title: "Перли рифу"
	quest.504F80DB7D216741.quest_desc: [
		"&aЦинкова руда&r — зеленувато-сіра, трапляється в глибокому сланці й поруч із ним (нижче 0 висоти). Цинк потрібен для латуні й багатьох механізмів Create. Подрібніть руду жорнами чи дробильними колесами — вийде більше злитків."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.create.zinc_ingot\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.create.zinc_ingot\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"доменна піч, верстак, піч\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:zinc_ingot\"}}]"
	]
	quest.504F80DB7D216741.title: "Цинк"
	quest.506205457D8D3353.quest_desc: [
		"&6Алхімік Северин&r, алхімік у вигнанні:"
		"&o«Мене вигнали з гільдії алхіміків за вибух у підвалі ратуші. Чесно кажучи, міська рада давно заслуговувала, щоб її трохи потрусило.»&r"
		"&o«Тепер я варю зілля тут, у пеклі, і мені потрібні стрижні іфритів. Іфрити літають біля фортець і плюються вогнем. Я одного разу пробував — бачите мої брови? Їх нема.»&r"
		"&fПринесіть вісім стрижнів іфрита. Іфрити живуть у незерських фортецях біля своїх спавнерів. Візьміть зілля вогнестійкості."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"block.minecraft.brewing_stand\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.potion\", \"color\": \"aqua\"}, {\"text\": \" ×3\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×10\", \"color\": \"gray\"}, {\"text\": \", 220 досвіду, 80 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.blaze_rod\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.blaze_rod\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.blaze\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.netherdepthsupgrade.blazefish\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:blaze_rod\"}}]"
	]
	quest.506205457D8D3353.title: "Стрижні іфритів"
	quest.50696DEA5644BEE3.quest_desc: [
		"&aКазан алхіміка&r над вогнем варить &aчорнила&r (з чорнильного мішка й порошків) і розбирає непотрібні сувої на чорнила. Чорнила бувають звичайні, незвичайні, рідкісні, епічні й легендарні."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.irons_spellbooks.alchemist_cauldron\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.irons_spellbooks.common_ink\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.irons_spellbooks.alchemist_cauldron\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.irons_spellbooks.common_ink\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: наповнювач, Iron's: казан алхіміка\", \"color\": \"white\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.irons_spellbooks.apothecarist\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.irons_spellbooks.archevoker\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.irons_spellbooks.cryomancer\", \"color\": \"white\"}, {\"text\": \" і ще 3\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki irons_spellbooks:alchemist_cauldron\"}}]"
	]
	quest.50696DEA5644BEE3.title: "Казан алхіміка"
	quest.50844ABF39AF2107.quest_desc: [
		"Висидіть &aяйце динозавра&r: поставте його і чекайте поруч — дитинча вважатиме вас батьком. &aСубтеранодон&r — літаючий скакун, &aатлатитан&r — величезна жива фортеця."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.alexscaves.subterranodon_egg\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Порада:&r яйця охороняють дорослі — краще забирати їх уночі, коли травоїдні сплять."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki alexscaves:subterranodon_egg\"}}]"
	]
	quest.50844ABF39AF2107.title: "Приручити динозавра"
	quest.50903549F148981B.quest_desc: [
		"&6Дорко&r, фермер:"
		"&o«Ворони, кролі й козли! Усе, що виростає на моєму полі, з'їдають раніше, ніж я встигаю зібрати. Діди казали: потрібне опудало з різьбленою головою.»&r"
		"&o«Гарбузи в мене є, а різати не вмію — у мене руки тремтять від старості.»&r"
		"&fПринесіть три вирізьблені гарбузи: гарбуз і ножиці — і клацніть ножицями по гарбузу."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.pumpkin_pie\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×4\", \"color\": \"gray\"}, {\"text\": \", 80 досвіду, 30 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.carved_pumpkin\", \"color\": \"aqua\"}, {\"text\": \" ×3\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:carved_pumpkin\"}}]"
	]
	quest.50903549F148981B.title: "Опудало на полі"
	quest.50990F8F550A840B.quest_desc: [
		"&aЗарядник&r заряджає кварц енергією. Заряджений Certus, кварц незеру й червоний пил, кинуті у воду, стають &aфлюікс-кристалами&r — кров'ю мережі."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.ae2.charger\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.charged_certus_quartz_crystal\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.fluix_crystal\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.ae2.charger\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ae2.charged_certus_quartz_crystal\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"AE2: зарядник, createaddition: charging\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ae2.fluix_crystal\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"AE2: перетворення у воді, Create: змішувач, верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ae2:charger\"}}]"
	]
	quest.50990F8F550A840B.title: "Зарядник і флюікс"
	quest.50F6A1E0C093E603.quest_desc: [
		"&aКонвеєр&r з'єднує два вали й везе предмети. Він робиться із сушеної ламінарії: висушіть її в печі, скрафтіть стрічку і з'єднайте нею два вали (клацніть по одному, потім по іншому). Предмети на стрічці можна обробляти пресом, вентилятором чи пилкою прямо на ходу."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.create.belt_connector\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.create.belt_connector\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Як:"
		"&71.&r Клацніть стрічкою по одному валу, потім по другому (до 20 блоків у лінію)."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:belt_connector\"}}]"
	]
	quest.50F6A1E0C093E603.title: "Конвеєри"
	quest.51900552A76C9E91.quest_desc: [
		"Величезна печера з джунглями, вулканами й &eдинозаврами&r: травоїдні гротоцератопси й атлатитани, мисливці-валлумраптори, грізний тремозавр."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Побувати в біомі: \", \"color\": \"gray\"}, {\"translate\": \"biome.alexscaves.primordial_caves\", \"color\": \"green\"}]"
		""
		"&6Де:&r під лісами й джунглями; ознака — вапняк, зелень і вода під землею."
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Спорядження:&r залізна броня, щит, лук; валлумраптори нападають зграями"
		"&6Як знайти:&r Мапа печерного біома або Компас природи → «primordial_caves»."
		"&6Порада:&r тремозавр — найнебезпечніший мешканець; обходьте його, поки не маєте алмазної броні."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki alexscaves:dinosaur_nugget\"}}]"
	]
	quest.51900552A76C9E91.quest_subtitle: "Тут живуть динозаври"
	quest.51900552A76C9E91.title: "Первісні печери"
	quest.51AD0F5A93F1FB51.quest_desc: [ ]
	quest.51AD0F5A93F1FB51.title: "Пам'ятник героям"
	quest.51BF1DD1C3B2160A.quest_desc: [
		"Будь-якого безробітного селянина можна зробити &aохоронцем&r: присядьте й клацніть по ньому правою кнопкою з мечем чи арбалетом у руці. Охоронець носить зброю й броню, яку ви йому дасте, і б'ється з монстрами й ілладжерами."
		"Після перемоги над набігом (статус «Герой села») охоронці ходять за вами; дзвін скликає їх."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.pillager\", \"color\": \"red\"}, {\"text\": \" ×5\"}]"
		""
		"&6Порада:&r дайте охоронцям щити — вони ними справді закриваються."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:pillager\"}}]"
	]
	quest.51BF1DD1C3B2160A.title: "Охорона села"
	quest.5238F7F69B050C3D.quest_desc: [
		"&aP2P-тунелі&r передають канали, енергію, рідини чи предмети одним кабелем на будь-яку відстань. Налаштовують їх картою пам'яті."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.me_p2p_tunnel\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.memory_card\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ae2.me_p2p_tunnel\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ae2.memory_card\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ae2:me_p2p_tunnel\"}}]"
	]
	quest.5238F7F69B050C3D.title: "P2P-тунелі"
	quest.5255995FAD99563F.quest_desc: [
		"За шлюзом починається &6Enderscape&r: &bнебесні гаї&r велетенських грибів, &7серпанкові ліси&r, &8осквернені пустища&r і &dмагнієві скелі&r, що притягують і відштовхують метал."
		""
		"Знайдіть небесний гай — там пливуть повітрям &aдрейфуни&r. Клацніть по дрейфуну порожньою пляшкою, щоб набрати &aдрейфового желе&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Побувати в біомі: \", \"color\": \"gray\"}, {\"translate\": \"biome.enderscape.celestial_grove\", \"color\": \"green\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.enderscape.drift_jelly_bottle\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki enderscape:drift_jelly_bottle\"}}]"
	]
	quest.5255995FAD99563F.title: "Зовнішні острови"
	quest.525608CD2339968F.quest_desc: [
		"&6Олесь&r, хлопець, що бачив світлячків:"
		"&o«Моя бабуся розповідала, що коли кинути діамант у ставок, обрамлений квітами, з неба вдарить блискавка — і відкриється шлях у ліс, де вічно сутеніє.»&r"
		"&o«Усі сміялися з бабусі. А я бачив, як над одним ставком уночі світилися світлячки — сотні. Мені не віддадуть діамант, я ще малий. А ви — спробуйте!»&r"
		"&fВідкрийте портал у Сутінковий ліс і пройдіть крізь нього. Ставок 2×2 з водою, навколо трава й квіти на кожному блоці — і киньте діамант."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.twilightforest.magic_map_focus\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×10\", \"color\": \"gray\"}, {\"text\": \", 250 досвіду, 100 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Потрапити у вимір: \", \"color\": \"gray\"}, {\"text\": \"Сутінковий ліс\", \"color\": \"light_purple\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:diamond\"}}]"
	]
	quest.525608CD2339968F.title: "Сутінковий портал"
	quest.53128291C55543CE.quest_desc: [
		"&6Вакула&r, моряк, що чує пісню:"
		"&o«Ночами я чую пісню. Вона кличе мене в море. Мої товариші пішли на той голос і не повернулися. Я прив'язую себе до щогли, щоб не піти за ними.»&r"
		"&o«Сирена живе на острові в морі. Мене вона зачарує за мить. Але кажуть, із затичками у вухах її пісня не страшна.»&r"
		"&fПокладіть край пісні сирени. Візьміть затички для вух — без них вона змусить вас іти в море."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.iceandfire.siren_tear\", \"color\": \"aqua\"}, {\"text\": \" ×2\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×15\", \"color\": \"gray\"}, {\"text\": \", 300 досвіду, скриня здобичі, 120 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.iceandfire.siren\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:iceandfire:siren\"}}]"
	]
	quest.53128291C55543CE.title: "Пісня сирени"
	quest.53403F160B19E27A.quest_desc: [ ]
	quest.53403F160B19E27A.title: "Мапа в нікуди"
	quest.537F3A8708ABD2CD.quest_desc: [
		"Радіоактивна печера з кислотними озерами. Без &aзахисного костюма&r тут отримуєте опромінення."
		"&dЗв'язок світу:&r місцевий &eуран — та сама руда, що в Mekanism&r: злитки й самородки взаємозамінні."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Побувати в біомі: \", \"color\": \"gray\"}, {\"translate\": \"biome.alexscaves.toxic_caves\", \"color\": \"green\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.alexscaves.hazmat_mask\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.alexscaves.hazmat_mask\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Де:&r під пустелями й рівнинами; ознака — зелене світло й кислота."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r повний &aзахисний костюм&r (hazmat), зілля опору"
		"&6Як знайти:&r Мапа печерного біома або Компас природи → «toxic_caves»."
		"&6Порада:&r рецепт захисного костюма — у JEI (клавіша R на масці)."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki alexscaves:hazmat_mask\"}}]"
	]
	quest.537F3A8708ABD2CD.title: "Токсичні печери"
	quest.53875BB61887A973.quest_desc: [ ]
	quest.53875BB61887A973.title: "Погляд півнозмія"
	quest.538C863C36A22199.quest_desc: [
		"Без будівельника місто не росте. Поставте блок &aМайстерні будівельника&r, а &aІнструментом будівництва&r (золотий скіпетр Structurize) оберіть креслення будинку і місце."
		"Будівельник сам принесе список потрібних матеріалів — покладіть їх у його скриню, і він зведе будинок блок за блоком."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecolonies.blockhutbuilder\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.structurize.sceptergold\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecolonies.blockhutbuilder\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.structurize.sceptergold\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Порада:&r у &aЗаписнику&r видно всі прохання поселенців: що кому бракує."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecolonies:blockhutbuilder\"}}]"
	]
	quest.538C863C36A22199.title: "Майстерня будівельника"
	quest.539CE100BBA877FD.quest_desc: [
		"&aКнига заклять&r — ваша палітра. &aC&r відкриває її: складіть закляття з гліфів (Снаряд + Шкода — перше бойове), &aV&r — коло вибору, ПКМ — каст."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.novice_spell_book\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ars_nouveau.novice_spell_book\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"ars_nouveau: dye, верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:novice_spell_book\"}}]"
	]
	quest.539CE100BBA877FD.title: "Книга заклять новачка"
	quest.539F4F9B8E67FE93.quest_desc: [ ]
	quest.539F4F9B8E67FE93.title: "Утеклий кінь"
	quest.545A6871A3313282.quest_desc: [
		"Вивчіть основні гліфи: форми &aСнаряд&r і &aДотик&r, ефекти &aШкода&r і &aЛамання&r. Кожен гліф — окремий предмет-рецепт на столі писаря."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.glyph_projectile\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.glyph_touch\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.glyph_harm\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.glyph_break\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ars_nouveau.glyph_projectile\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Ars: стіл писаря\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ars_nouveau.glyph_touch\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Ars: стіл писаря\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ars_nouveau.glyph_harm\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Ars: стіл писаря\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:glyph_projectile\"}}]"
	]
	quest.545A6871A3313282.title: "Перші гліфи"
	quest.54AEE8D377E51873.quest_desc: [
		"На воді теж живуть: &aселище на лататті&r з ринком і храмом, &aприпливні містечка&r на палях, рибальські хатки, маяки."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Знайти споруду: \", \"color\": \"gray\"}, {\"translate\": \"wilds_wiki.structure.ocean_lily_pad_village.market\", \"color\": \"gold\"}]"
		""
		"&6Де:&r береги і мілке море; містечка на лататті — у болотах і теплих водах."
		"&6Складність:&r &c★&8★★★★&r — легко"
		"&6Як знайти:&r Компас дослідника → «ocean_lily_pad_village:market», «village_ocean», «lighthouse»."
		"&6Порада:&r морські рибалки торгують гачками, кораблями й гарматами."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:lily_pad\"}}]"
	]
	quest.54AEE8D377E51873.title: "Морські поселення"
	quest.54F0CEB696FD7B47.quest_desc: [
		"&eКрок 4.&r &aМолоток&r: залізо, палиці й полотно (рецепт — у JEI, клавіша R)."
		"&eКрок 5.&r Поставте &aкрихітну юрту&r на рівне місце — з'явиться лише &aкаркас&r."
		"&eКрок 6.&r Бийте каркас &aмолотком&r (правою кнопкою), доки юрта не добудується. &aЗолотий молоток&r будує одразу."
		"&eКрок 7.&r Зайдіть у двері — ви всередині юрти."
		""
		"&eЯк забрати:&r присядьте і зламайте двері — юрта згорнеться в предмет з усім, що всередині. Забрати юрту може лише той, хто її поставив."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.nomadictents.tiny_yurt\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.nomadictents.mallet\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.nomadictents.tiny_yurt\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.nomadictents.mallet\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Порада:&r біля монстрів у юрту не зайдеш — спершу розберіться з ними."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki nomadictents:tiny_yurt\"}}]"
	]
	quest.54F0CEB696FD7B47.title: "Наметовий молоток"
	quest.54F518DCEF80B223.quest_desc: [
		"Олені, кабани, качки й індики — нова їжа: &aоленина&r, &aдичина&r, &aстегенця&r. З більших звірів падають &aхутро&r і &aшкура&r."
		""
		"&dЗв'язок світу:&r хутро й шкури звірів, гоблінів і динозаврів &eпідходять замість шкіри&r у рецептах; хутро ще й перетворюється на вовну."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.naturalist.venison\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.naturalist.fur\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.naturalist.venison\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.naturalist.deer\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.naturalist.fur\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.naturalist.bear\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.naturalist.black_bear\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.naturalist.capybara\", \"color\": \"white\"}, {\"text\": \" і ще 5\"}]"
		""
		"&6Де:&r ліси, тайга, савани й болота — у кожному краї свої звірі."
		"&6Складність:&r &c★★&8★★★&r — помірно"
		"&6Порада:&r ведмеді й алігатори нападають першими; не підходьте близько до ведмежат."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki naturalist:venison\"}}]"
	]
	quest.54F518DCEF80B223.title: "Мисливська здобич"
	quest.55357BE579DC7F5C.quest_desc: [
		"&6Торговка Ліза&r, купчиха шовку:"
		"&o«Скриня, що зберігає речі, навіть коли її розбити — це ж мрія кожного купця! Я хочу торгувати ящиками шалкерів по всьому світу.»&r"
		"&o«Для цього потрібні мушлі. Шалкери ховаються в баштах міст Енду й прикидаються блоками.»&r"
		"&fПринесіть вісім мушель шалкерів."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"block.minecraft.shulker_box\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.diamond\", \"color\": \"aqua\"}, {\"text\": \" ×4\", \"color\": \"gray\"}, {\"text\": \", 320 досвіду, 120 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.shulker_shell\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.shulker_shell\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.shulker\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:shulker_shell\"}}]"
	]
	quest.55357BE579DC7F5C.title: "Мушлі шалкерів"
	quest.553EB0D6A8673AD6.quest_desc: [
		"&6Учениця Мілена&r, учениця мага &8(доручення 2 з 3)&r:"
		"&o«Учитель побачив мій сувій і... сказав, що почерк жахливий. Але погодився вчити далі!»&r"
		"&o«Тепер я мушу писати сувої сама, а для цього потрібні чорнила. Їх варять у казані алхіміка з чорнильного мішка й тайної есенції.»&r"
		"&fПринесіть вісім звичайних чорнил."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"block.irons_spellbooks.scroll_forge\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", 200 досвіду, 80 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.irons_spellbooks.common_ink\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.irons_spellbooks.common_ink\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: наповнювач, Iron's: казан алхіміка\", \"color\": \"white\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.irons_spellbooks.apothecarist\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.irons_spellbooks.archevoker\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.irons_spellbooks.cryomancer\", \"color\": \"white\"}, {\"text\": \" і ще 3\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki irons_spellbooks:common_ink\"}}]"
	]
	quest.553EB0D6A8673AD6.title: "Перші чорнила"
	quest.558D4D5D23D0E2EC.quest_desc: [
		"Сторож кидає шматки порожнечі й стріляє чарами. Поруч бродять ендові големи. Нагорода — рукавиця сторожа."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.cataclysm.ender_guardian\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aЗруйнована цитадель&r на островах Енду."
		"&6Складність:&r &c★★★★★&8&r — смертельно"
		"&6Спорядження:&r незеритова броня, зілля повільного падіння, ендер-перли"
		"&6Як знайти:&r &aОко порожнечі&r (пурпурні блоки, панцир шалкера, цегла енду, око Енду) або Компас дослідника → «ruined_citadel»."
		"&6Порада:&r не бийтеся біля краю острова — сторож відкидає."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:cataclysm:ender_guardian\"}}]"
	]
	quest.558D4D5D23D0E2EC.title: "Ендовий сторож"
	quest.5596A8BADC6F1D6A.quest_desc: [ ]
	quest.5596A8BADC6F1D6A.title: "Храм вартових"
	quest.55B0697D6C4F26A1.quest_desc: [
		"Hybrid Aquatic додає справжній &aводолазний костюм&r: шолом, костюм, штани й черевики. З &aважками&r ви ходите дном, як по суші; &aсвітна паличка&r освітлює глибину."
		"Шаблон &aпосилення костюма&r трапляється у скринях."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.hybrid_aquatic.diving_helmet\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.hybrid_aquatic.diving_suit\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.hybrid_aquatic.diving_helmet\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.hybrid_aquatic.diving_suit\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Порада:&r у глибокому морі живуть акули: блокуйте їхній укус щитом — так здобувають &aакулячий зуб&r."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki hybrid_aquatic:diving_helmet\"}}]"
	]
	quest.55B0697D6C4F26A1.title: "Водолазний костюм"
	quest.55CBF3EEE1C73453.quest_desc: [
		"Перший бос: велетенська змія, що кружляє по арені й таранить. Після кожного ривка вона відкрита — тоді й бийте в голову."
		"Нагорода: &aлуска наґи&r — нагрудник і поножі, що не дають себе відкинути."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.twilightforest.naga\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aДвір наґи&r — квадратна арена з моховитої кам'яної цегли посеред звичайного Сутінкового лісу, зазвичай недалеко від порталу."
		"&6Складність:&r &c★★&8★★★&r — помірно"
		"&6Спорядження:&r залізна броня, щит, меч, 10–16 одиниць їжі"
		"&6Як знайти:&r Магічна мапа (значок змії) або Компас дослідника → «naga_courtyard»."
		"&6Порада:&r не стійте в кутку: наґа притискає до стін. Відступайте вбік, коли вона розганяється."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:twilightforest:naga\"}}]"
	]
	quest.55CBF3EEE1C73453.title: "Наґа"
	quest.56112B20BAE4BAE1.quest_desc: [
		"Фортеці Незеру перебудовано (YUNG's Better Nether Fortresses): більші, з мостами, залами й в'язницями. Тут живуть &cіфрити&r і &8візер-скелети&r."
		""
		"Вам потрібні &aстрижні іфрита&r: з них варять зілля (варильна стійка) і роблять &aоко Енду&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.blaze_rod\", \"color\": \"aqua\"}, {\"text\": \" ×6\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.blaze_rod\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.blaze\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.netherdepthsupgrade.blazefish\", \"color\": \"white\"}]"
		""
		"&6Де:&r темні цегляні мости над лавою; часто між біомами."
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Спорядження:&r щит, лук, вогнестійкість"
		"&6Як знайти:&r Компас дослідника → «fortress»."
		"&6Порада:&r візер-скелети накладають іссушення — тримайте молоко."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:blaze_rod\"}}]"
	]
	quest.56112B20BAE4BAE1.title: "Фортеця Незеру"
	quest.564886FCBCC75EA7.quest_desc: [
		"У глибині &aкатакомб&r на троні сидить &aМертвий король&r. Він кличе мерців, б'є косою й у другій фазі стає ще швидшим. З нього падає його коса й рідкісні реліквії."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.irons_spellbooks.dead_king\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r Катакомби (Компас дослідника)"
		"&6Складність:&r &c★★★★★&8&r — смертельно"
		"&6Спорядження:&r незеритова або мітрилова броня, зілля, тотем"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:irons_spellbooks:dead_king\"}}]"
	]
	quest.564886FCBCC75EA7.title: "Мертвий король"
	quest.57283EB763F37AF2.quest_desc: [
		"&6Пані Аделаїда&r, годинникарка &8(доручення 4 з 5)&r:"
		"&o«Мій великий годинник матиме фігурки, що виходять щогодини: коваль б'є молотом, пастушка жене овець. Рухати їх мають механічні руки.»&r"
		"&o«Дві руки — і фігурки оживуть. Дорого? Так. Але це буде диво, про яке говоритимуть у трьох селах.»&r"
		"&fПринесіть дві механічні руки."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×16\", \"color\": \"gray\"}, {\"text\": \", 320 досвіду, скриня здобичі, 120 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.mechanical_arm\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.mechanical_arm\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:mechanical_arm\"}}]"
	]
	quest.57283EB763F37AF2.title: "Механічні руки"
	quest.573B94C480D57557.quest_desc: [
		"&aТочка бездротового доступу&r і &aуніверсальний бездротовий термінал&r — мережа в кишені в радіусі точки."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.ae2.wireless_access_point\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2wtlib.wireless_universal_terminal\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.ae2.wireless_access_point\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ae2:wireless_access_point\"}}]"
	]
	quest.573B94C480D57557.title: "Бездротовий доступ"
	quest.5774D3E58745ABF1.quest_desc: [ ]
	quest.5774D3E58745ABF1.title: "Годинник для села"
	quest.5775B1A1874FD00B.quest_desc: [
		"&aСамоцвіти&r випадають з мобів. Їх вставляють у &eгнізда&r спорядження на ковальському столі. Гнізда додає &aсигіл інкрустації&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.apotheosis.gem\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.apotheosis.sigil_of_socketing\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.apotheosis.sigil_of_socketing\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki apotheosis:gem\"}}]"
	]
	quest.5775B1A1874FD00B.title: "Самоцвіти"
	quest.5834D7EFBA5EBAD1.quest_desc: [
		"&aРанець&r на водні — перший політ. Заправте його воднем із сепаратора: поставте в його слот у машині."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.mekanism.jetpack\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.mekanism.jetpack\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: mek data\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanism:jetpack\"}}]"
	]
	quest.5834D7EFBA5EBAD1.title: "Реактивний ранець"
	quest.583A84F598382B3A.quest_desc: [
		"&6Отаман Харитон&r, отаман рибальської громади:"
		"&o«З глибини виходять глибинні — напівлюди-напівриби з тризубами. Вони ночами беруть людей і несуть на дно, у своє затоплене місто.»&r"
		"&o«Наші хлопці слабкі проти них. Але один сміливий воїн, кажуть старі, вартий десятка.»&r"
		"&fПодолайте п'ятьох глибинних. Вони тримаються біля затонулих міст на дні глибокого океану."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.diamond_sword\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×15\", \"color\": \"gray\"}, {\"text\": \", 320 досвіду, скриня здобичі, 120 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.cataclysm.deepling\", \"color\": \"red\"}, {\"text\": \" ×5\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:cataclysm:deepling\"}}]"
	]
	quest.583A84F598382B3A.title: "Глибинні"
	quest.5857B0B345D52EDD.quest_desc: [ ]
	quest.5857B0B345D52EDD.title: "Яйце гіпогрифа"
	quest.58A4F42C33E80EF5.quest_desc: [
		"&6Галина&r, пастушка &8(доручення 1 з 2)&r:"
		"&o«Мої вівці ночують у кошарі за селом. Третю ніч поспіль хтось риє під загородою, і щоранку однієї бракує.»&r"
		"&o«Сліди великі, як долоня. Староста каже — вовки, а мисливці подалися на ярмарок у місто і повернуться хіба по жнивах.»&r"
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"block.minecraft.white_wool\", \"color\": \"aqua\"}, {\"text\": \" ×16\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.mutton\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", 80 досвіду, 30 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.wolf\", \"color\": \"red\"}, {\"text\": \" ×3\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:wolf\"}}]"
	]
	quest.58A4F42C33E80EF5.title: "Вовки біля кошари"
	quest.592A87E7FB826A3C.quest_desc: [
		"У савані живуть слони, жирафи, зебри, леви, носороги й страуси. Леви — хижаки, а носоріг таранить тих, хто підійде близько."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Побувати в біомі: \", \"color\": \"gray\"}, {\"translate\": \"biome.minecraft.savanna\", \"color\": \"green\"}]"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.naturalist.lion\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r савани."
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Порада:&r на зебру можна сісти верхи, як на коня."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:naturalist:lion\"}}]"
	]
	quest.592A87E7FB826A3C.title: "Звірі савани"
	quest.5981FFB7741A9082.quest_desc: [
		"Блоки, приклеєні суперклеєм до &aпідшипника&r, &aпоршня&r чи &aшківа&r, рухаються разом: вітряки, ліфти, мости, двері, бурові установки."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.mechanical_bearing\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.create.super_glue\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.sail_frame\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.mechanical_bearing\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.create.super_glue\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.sail_frame\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Як:"
		"&71.&r Поставте механічний підшипник, на нього — каркаси вітрил, обклейте суперклеєм і клацніть по підшипнику ключем — вітряк закрутиться."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:mechanical_bearing\"}}]"
	]
	quest.5981FFB7741A9082.title: "Рухомі механізми"
	quest.59A1BD92AED461CD.quest_desc: [
		"&aШахта&r: шахтар копає вертикальний ствол і рівні з тунелями, приносить камінь і руди — зокрема руди Mekanism, Create і Ice and Fire. Що глибша шахта (вищий рівень будівлі), то багатша здобич."
		"Йому потрібні кирка, лопата, дошки й смолоскипи — колонія сама попросить."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecolonies.blockhutminer\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecolonies.blockhutminer\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Порада:&r шахту ставлять над твердим каменем, а не над печерою чи водою."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecolonies:blockhutminer\"}}]"
	]
	quest.59A1BD92AED461CD.title: "Найнятий шахтар"
	quest.59A4A7CF1DE61FBB.quest_desc: [
		"&aАтомний розбирач&r — енергетичний інструмент на все: копає, рубає, косить, а в режимі «вени» зносить цілі жили руди."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.mekanism.atomic_disassembler\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.mekanism.atomic_disassembler\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: mek data\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanism:atomic_disassembler\"}}]"
	]
	quest.59A4A7CF1DE61FBB.title: "Атомний розбирач"
	quest.5A58857FD0D63BB0.quest_desc: [
		"Запишіть рецепт на &aшаблон&r у терміналі кодування, вставте в &aпостачальник шаблонів&r поруч із &aмолекулярним збирачем&r — і мережа крафтить на замовлення. Для замовлень потрібен &aкрафтовий процесор&r (блоки зберігання + одиниці)."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.pattern_encoding_terminal\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
