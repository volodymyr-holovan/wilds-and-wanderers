	]
	quest.5B2012F494AA9FD1.title: "Подвоєння руд"
	quest.5B372A27011D28CE.quest_desc: [
		"Колії, &aстанція&r, &aкерування&r і рамка з залізничної обшивки — і ваш поїзд везе руду з далекої шахти. Розклад на станції, семафори на коліях."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.track\", \"color\": \"aqua\"}, {\"text\": \" ×32\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.track_station\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.controls\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.railway_casing\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.track\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: послідовне складання\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.track_station\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.controls\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Як:"
		"&71.&r Прокладіть колію (клацніть рейкою по початку й кінцю)."
		"&72.&r Поставте станцію, на колії зберіть вагон з обшивки й пульта керування, приклейте суперклеєм."
		"&73.&r Клацніть по станції — «Зібрати поїзд»."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:track\"}}]"
	]
	quest.5B372A27011D28CE.title: "Поїзди"
	quest.5B66EAD512974B1C.quest_desc: [
		"&aКонфігуратор&r налаштовує, з якого боку машина бере й віддає предмети, а &aлогістичні транспортери&r самі розносять їх між машинами. Так машини з'єднуються в лінію."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.mekanism.configurator\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.mekanism.configurator\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanism:configurator\"}}]"
	]
	quest.5B66EAD512974B1C.title: "Налаштування сторін"
	quest.5BFA7A0B342FABFE.quest_desc: [
		"&aАльтернатор&r перетворює обертання Create на енергію FE. Так ваше водяне колесо чи паровий двигун можуть живити машини &eMekanism&r і мережу &eAE2&r."
		"Енергію передають дроти між &aконекторами&r або кабелі Mekanism."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.createaddition.alternator\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.createaddition.connector\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.createaddition.alternator\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: механічний верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.createaddition.connector\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki createaddition:alternator\"}}]"
	]
	quest.5BFA7A0B342FABFE.title: "Генератор"
	quest.5C3BB6FF2C8487B5.quest_desc: [
		"&6Параска&r, господиня:"
		"&o«Моя пташка зникає щоночі. Я сиджу з ліхтарем біля курника, а лисиці ніби знають і приходять саме тоді, як я задрімаю.»&r"
		"&o«Чоловік поїхав на заробітки, син малий. Я би й сама, та лисиці моторні — не наздоженеш.»&r"
		"&fПроженіть двох лисиць. Вони ходять опівночі від лісу, з тайги чи ялинника."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.egg\", \"color\": \"aqua\"}, {\"text\": \" ×16\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.cooked_chicken\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×4\", \"color\": \"gray\"}, {\"text\": \", 70 досвіду, 25 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.fox\", \"color\": \"red\"}, {\"text\": \" ×2\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:fox\"}}]"
	]
	quest.5C3BB6FF2C8487B5.title: "Лисиця й кури"
	quest.5CD40580D3FF8E44.quest_desc: [
		"&aКартопляна гармата&r стріляє овочами (і не тільки), &aпротезна рука&r дістає блоки на відстані."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.create.potato_cannon\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.create.extendo_grip\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.create.potato_cannon\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: механічний верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.create.extendo_grip\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: механічний верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:potato_cannon\"}}]"
	]
	quest.5CD40580D3FF8E44.title: "Дивні інструменти"
	quest.5D8AAFB547B62AF3.quest_desc: [
		"Команди для зручної гри разом:"
		" • &a/sethome назва&r, &a/home назва&r, &a/listhomes&r — точки дому."
		" • &a/tpa Нік&r — попросити телепорт до друга; він відповідає &a/tpaccept&r."
		" • &a/back&r — повернутися на попереднє місце (і на місце смерті)."
		" • &a/rtp&r — випадковий телепорт у дику місцевість, щоб оселитися подалі від інших."
		" • &a/spawn&r — на спавн; &a/warp&r — точки, які створив адміністратор."
		""
		"Після смерті ваші речі лежать у &eтілі&r на місці загибелі (мод Corpse) — нічого не зникає."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:ender_pearl\"}}]"
	]
	quest.5D8AAFB547B62AF3.title: "Дім, телепорти й друзі"
	quest.5F048F31DB7EB7C8.quest_desc: [
		"&6Брат Євсевій&r, німий чернець:"
		"&o«(Чернець пише на дощечці.) Я дав обітницю мовчання, бо колись почув голос з глибини. Під землею є місто, де навіть кроки змушують щось прокинутися.»&r"
		"&o«Я мушу знати, що воно існує, — тоді моя обітниця має сенс. Ходіть тихо. Крадіться. Ніколи не біжіть.»&r"
		"&f(пише) Знайдіть Стародавнє місто глибоко під землею, у Темній глибині. Компас дослідника — «Стародавнє місто»."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.echo_shard\", \"color\": \"aqua\"}, {\"text\": \" ×4\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.recovery_compass\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", 300 досвіду, скриня здобичі, 120 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Знайти споруду: \", \"color\": \"gray\"}, {\"translate\": \"wilds_wiki.structure.minecraft.ancient_city\", \"color\": \"gold\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:echo_shard\"}}]"
	]
	quest.5F048F31DB7EB7C8.title: "Мовчазне місто"
	quest.5FBEA03AE870BA9C.quest_desc: [
		"&aБібліотека&r зберігає всі ваші зачаровані книги як «очки» і видає книгу будь-якого рівня, який ви вже вносили. Більше не треба скринь з книгами."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.apothic_enchanting.library\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.apothic_enchanting.library\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki apothic_enchanting:library\"}}]"
	]
	quest.5FBEA03AE870BA9C.title: "Бібліотека чар"
	quest.602F4CCF2594D07B.quest_desc: [
		"&aЛевіятан&r — глибинне чудовисько затонулого міста (Катаклізм). Битва під водою, тож візьміть зілля підводного дихання й нічного бачення, а краще — мідний шолом з балоном. Нагорода — &aприпливні кігті&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.cataclysm.the_leviathan\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aЗатонуле місто&r на дні глибокого океану."
		"&6Складність:&r &c★★★★★&8&r — смертельно"
		"&6Спорядження:&r зілля підводного дихання й нічного бачення, «Підводна хода», «Спритність у воді», тризуб"
		"&6Як знайти:&r &aОко безодні&r (обсидіан, плакучий обсидіан, око Енду) або Компас дослідника → «sunken_city»."
		"&6Порада:&r добирайтеся на кораблі — так легше повернутися з трофеями."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:cataclysm:the_leviathan\"}}]"
	]
	quest.602F4CCF2594D07B.title: "Левіятан"
	quest.60584997CF39B901.quest_desc: [
		"&6Учениця Мілена&r, учениця мага &8(доручення 1 з 3)&r:"
		"&o«Мій учитель вважає, що я ще не готова до справжньої магії. Але я вже вивчила три закляття з книжки! Ну, одне. Наполовину.»&r"
		"&o«Щоб показати йому, я маю зробити свій перший сувій. Для цього потрібна тайна есенція — вона сиплеться з магів і їхніх скринь у вежах.»&r"
		"&fПринесіть дванадцять тайної есенції. Чарівники Iron's Spells і їхні вежі — найкращі джерела."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"block.irons_spellbooks.inscription_table\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.lapis_lazuli\", \"color\": \"aqua\"}, {\"text\": \" ×16\", \"color\": \"gray\"}, {\"text\": \", 220 досвіду, скриня здобичі, 80 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.irons_spellbooks.arcane_essence\", \"color\": \"aqua\"}, {\"text\": \" ×12\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.irons_spellbooks.arcane_essence\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.irons_spellbooks.apothecarist\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.irons_spellbooks.archevoker\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.irons_spellbooks.cryomancer\", \"color\": \"white\"}, {\"text\": \" і ще 7\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki irons_spellbooks:arcane_essence\"}}]"
	]
	quest.60584997CF39B901.title: "Тайна есенція"
	quest.6064D1D5583DC921.quest_desc: [
		"&6Ярема&r, колишній солдат &8(доручення 3 з 4)&r:"
		"&o«Того дня ворота нашої застави виламав руйнівник — звір завбільшки з хату. Він приходить із великими набігами.»&r"
		"&o«Кажуть, той самий звір досі ходить з їхнім військом. Я впізнаю його по шраму на морді.»&r"
		"&fПереможіть руйнівника."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.saddle\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×14\", \"color\": \"gray\"}, {\"text\": \", 300 досвіду, скриня здобичі, 120 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.ravager\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:ravager\"}}]"
	]
	quest.6064D1D5583DC921.title: "Звір облоги"
	quest.606AAA5401A88133.quest_desc: [
		"&aРожевий кварц&r (кварц незеру з червоним пилом) шліфують і роблять &aелектронні лампи&r — для розумних механізмів."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.create.polished_rose_quartz\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.create.electron_tube\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.create.polished_rose_quartz\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: наждачний папір, Mekanism: збагачувач\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.create.electron_tube\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:polished_rose_quartz\"}}]"
	]
	quest.606AAA5401A88133.title: "Електронна лампа"
	quest.6078951E61452282.quest_desc: [
		"&6Гордій&r, рибалка:"
		"&o«Біла акула кружляє біля нашого причалу. Вона вже перевернула два човни й забрала сина мого сусіда.»&r"
		"&o«Ми рибалки, а не воїни. Списи в нас для риби, а не для чудовиськ завдовжки з будинок.»&r"
		"&fПодолайте велику білу акулу. Вона живе у глибоких теплих водах. Найкраще бити з човна або з берега — у воді вона сильніша."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.fishing_rod\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×12\", \"color\": \"gray\"}, {\"text\": \", 260 досвіду, скриня здобичі, 100 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.hybrid_aquatic.great_white_shark\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:hybrid_aquatic:great_white_shark\"}}]"
	]
	quest.6078951E61452282.title: "Акулячі води"
	quest.609DAB50742C9626.quest_desc: [ ]
	quest.609DAB50742C9626.title: "Серце моря"
	quest.60B32C5A3603EFB3.quest_desc: [
		"&aE&r — інвентар разом з усім спорядженням: броня, каблучки, намисто, пояс, рукавиці, плащ, книга заклинань, ранець за спиною. Усе в одному вікні, без окремих вкладок."
		"Кнопка з веселкою показує декоративні слоти (вигляд без зміни характеристик). Біля швидкої панелі — дві кнопки: &aзелена книга&r відкриває книгу рецептів ліворуч, &a⚔&r — панель усіх ваших характеристик праворуч. Відкривайте хоч усе разом: вікна не перекривають одне одного й лишаються відкритими, доки ви їх не закриєте."
		"Середня кнопка миші сортує скриню чи інвентар. &aShift + клік&r переносить стос, &aCtrl + клік&r — по одному."
		"Протягніть мишкою із затиснутою правою кнопкою по слотах — предмети розкладуться порівну."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:chest\"}}]"
	]
	quest.60B32C5A3603EFB3.title: "Інвентар і спорядження"
	quest.611DBEFFFE7B7245.quest_desc: [
		"Сітка &aмеханічних верстатів&r крафтить великі рецепти (до 9×9) самостійно. Разом із &aрозміщувачем&r і &aмеханічною рукою&r ви автоматизуєте майже все."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.mechanical_crafter\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.deployer\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.mechanical_arm\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.mechanical_crafter\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.deployer\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.mechanical_arm\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:mechanical_crafter\"}}]"
	]
	quest.611DBEFFFE7B7245.title: "Механічний верстат"
	quest.612E0F8D3BF1CC77.quest_desc: [
		"&6Пілот Віталій&r, мрійник про небо:"
		"&o«Я все життя будую крила. Шкіра, пір'я, перетинки фантомів — ніщо не тримає в повітрі. Але є крила, що летять самі: елітри з кораблів Енду.»&r"
		"&o«Я надто старий для Енду. Принесіть мені одні — я хочу торкнутися неба, поки не пізно. А потім віддам їх вам. Обіцяю.»&r"
		"&fПринесіть елітри з корабля міста Енду. Шалкери стріляють левітацією — тримайте відро води чи молоко."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.firework_rocket\", \"color\": \"aqua\"}, {\"text\": \" ×32\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.diamond\", \"color\": \"aqua\"}, {\"text\": \" ×5\", \"color\": \"gray\"}, {\"text\": \", 500 досвіду, скриня здобичі, 200 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.elytra\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:elytra\"}}]"
	]
	quest.612E0F8D3BF1CC77.title: "Крила Енду"
	quest.6156FE514919AF1E.quest_desc: [ ]
	quest.6156FE514919AF1E.title: "Довга дорога"
	quest.61811F9DA4A9BA0C.quest_desc: [
		"Бос Incendium. Принесіть &aзірку Незеру&r на &cПекельний вівтар&r — і з полум'я постане Ширяюче пекло."
		""
		"Нагорода — &6Пекельні крила&r, «Вогняна буря» чи один зі щитів. Зірку Незеру дає візер."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Знайти споруду: \", \"color\": \"gray\"}, {\"translate\": \"wilds_wiki.structure.incendium.infernal_altar\", \"color\": \"gold\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.nether_star\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Складність:&r &c★★★★★&8&r — смертельно"
		"&6Спорядження:&r незеритова броня, вогнестійкість, зцілення"
		"&6Як знайти:&r Компас дослідника → «infernal_altar»."
		"&6Порада:&r бийтеся там, де є куди відступити від вогню."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:nether_star\"}}]"
	]
	quest.61811F9DA4A9BA0C.title: "Ширяюче пекло"
	quest.618C95D0AE6DACC4.quest_desc: [ ]
	quest.618C95D0AE6DACC4.title: "Дорога на північ"
	quest.61A0C134105F2F53.quest_desc: [
		"&6Інженерка Віра&r, винахідниця:"
		"&o«У компасах біля моєї майстерні стрілки крутяться, як навіжені. Хтось каже — прокляття. Я кажу — магніт під землею! Там цілі печери, де металеві уламки висять у повітрі.»&r"
		"&o«Мені потрібен червоний неодим для мого двигуна. Самій спускатися страшно — кажуть, там ходять металеві роботи.»&r"
		"&fПринесіть шість сирого червоного неодиму з Магнітних печер."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"block.minecraft.redstone_block\", \"color\": \"aqua\"}, {\"text\": \" ×4\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×12\", \"color\": \"gray\"}, {\"text\": \", 240 досвіду, скриня здобичі, 90 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.alexscaves.raw_scarlet_neodymium\", \"color\": \"aqua\"}, {\"text\": \" ×6\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.alexscaves.raw_scarlet_neodymium\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.alexscaves.teletor\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki alexscaves:raw_scarlet_neodymium\"}}]"
	]
	quest.61A0C134105F2F53.title: "Магнітна загадка"
	quest.61A1A6FD11ADCE0F.quest_desc: [
		"Око Енду — порох іфрита і перлина Енду (або око риби-ока з лавових морів). Киньте його — воно полетить до найближчої &aфортеці Енду&r під землею."
		""
		"Для порталу в Енд потрібно до дванадцяти очей: частина рамок уже може мати око. Візьміть запас — очі інколи розбиваються в польоті."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.ender_eye\", \"color\": \"aqua\"}, {\"text\": \" ×12\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.ender_eye\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Як знайти:&r Око Енду показує напрям; фортеці перебудовано (YUNG's Better Strongholds), портал — у глибині."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:ender_eye\"}}]"
	]
	quest.61A1A6FD11ADCE0F.title: "Очі Енду"
	quest.629EEEEBA7DFF410.quest_desc: [
		"&6Інженер Фрол&r, будівничий фортеці:"
		"&o«Я відновлюю стару фортецю під землею. Але в стінах живуть лусочниці — розбиваєш камінь, а з нього вилазить ціла зграя.»&r"
		"&o«Мої робітники розбіглися. Мені потрібен хтось, хто не боїться сріблястого шерхоту у стінах.»&r"
		"&fЗнищіть п'ятнадцятьох лусочниць. Порада: ламайте блоки з лусочницями здалеку, і не бийте одну — бо прибіжать інші."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.ender_pearl\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×10\", \"color\": \"gray\"}, {\"text\": \", 220 досвіду, 80 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.silverfish\", \"color\": \"red\"}, {\"text\": \" ×15\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:silverfish\"}}]"
	]
	quest.629EEEEBA7DFF410.title: "Гніздо лусочниць"
	quest.62AA5506A726F646.quest_desc: [
		"&aГравітитова руда&r трапляється на нижніх частинах островів. Зачаруйте її на вівтарі — з неї роблять найкращі інструменти Етеру: кирка підкидає блоки вгору, броня дає високі стрибки."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.aether.enchanted_gravitite\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.aether.enchanted_gravitite\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"aether: enchanting\", \"color\": \"white\"}]"
		""
		"&6Де:&r низ великих островів; руда фіолетова й підлітає, коли її ламаєте."
		"&6Складність:&r &c★★&8★★★&r — помірно"
		"&6Порада:&r ламайте руду, стоячи над нею, — інакше вона полетить угору."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki aether:enchanted_gravitite\"}}]"
	]
	quest.62AA5506A726F646.title: "Гравітит"
	quest.62BC8551B779EBCE.quest_desc: [
		"Острів дракона перебудовано (YUNG's Better End Island): у центрі — &5вежа з дзвоном&r. Дракон прилітає не одразу, а коли ви наближаєтеся до вежі, тож є час роздивитися."
		""
		"&6Візьміть:&r лук і багато стріл, блоки, гарбуз на голову (від ендерменів), відро води, зілля повільного падіння."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Потрапити у вимір: \", \"color\": \"gray\"}, {\"text\": \"Енд\", \"color\": \"light_purple\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:end_stone\"}}]"
	]
	quest.62BC8551B779EBCE.title: "Енд"
	quest.62CF778823702155.quest_desc: [
		"&6Лукія&r, сільська лікарка &8(доручення 2 з 4)&r:"
		"&o«Обернених ви зупинили. Але двоє дітей уже кашляють сірим кашлем. Їх ще можна врятувати: зілля слабкості і золоте яблуко.»&r"
		"&o«Зілля я зварю сама. А от золота в мене нема — тільки трави.»&r"
		"&fПринесіть два золоті яблука."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×10\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.glistering_melon_slice\", \"color\": \"aqua\"}, {\"text\": \" ×4\", \"color\": \"gray\"}, {\"text\": \", 160 досвіду, 60 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.golden_apple\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.golden_apple\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:golden_apple\"}}]"
	]
	quest.62CF778823702155.title: "Ліки для ранніх"
	quest.62EF1AD6C6AFFA8C.quest_desc: [
		"Глибоко під океаном — &aГлибинна безодня&r: глибоководні створіння, руїни &aглибинних людей&r і їхні скарби. Для подорожі збудуйте &aпідводний човен&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Побувати в біомі: \", \"color\": \"gray\"}, {\"translate\": \"biome.alexscaves.abyssal_chasm\", \"color\": \"green\"}]"
		""
		"&6Де:&r під глибоким океаном, нижче морського дна."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r зілля нічного бачення й підводного дихання, зачарування «Дихання» і «Підводна хода»"
		"&6Як знайти:&r Мапа печерного біома або Компас природи → «abyssal_chasm»; руїни — Компас дослідника → «abyssal_ruins»."
		"&6Порада:&r тут живе &aКорабелолам&r (Hullbreaker) — велетенська глибоководна риба. Не спускайтеся сюди першим ділом."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki alexscaves:pearl\"}}]"
	]
	quest.62EF1AD6C6AFFA8C.title: "Глибинна безодня"
	quest.6362E4839B2B6EB2.quest_desc: [
		"&6Тиха Злата&r, провидиця:"
		"&o«Ворони Сутінкового лісу бачать минуле й майбутнє. Із їхнього пір'я я читаю долі людей, що потрапили сюди.»&r"
		"&o«Але птахи мене обминають — бояться. Ви ж тихо підкрадетеся, правда?»&r"
		"&fПринесіть п'ять пір'їн ворона. Ворони сидять на землі й злітають, коли підходите — крадіться присівши."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.twilightforest.magic_map_focus\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", 180 досвіду, 70 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.twilightforest.raven_feather\", \"color\": \"aqua\"}, {\"text\": \" ×5\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.twilightforest.raven_feather\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.twilightforest.raven\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki twilightforest:raven_feather\"}}]"
	]
	quest.6362E4839B2B6EB2.title: "Пір'я воронів"
	quest.63C2C52D1861D802.quest_desc: [
		"Кварцовий притулок розбійників у кварцових рівнинах: сховище, вартові й ілюзіоністи. З ілюзіоністів часто падає &aСувій повернення&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Знайти споруду: \", \"color\": \"gray\"}, {\"translate\": \"wilds_wiki.structure.incendium.sanctum\", \"color\": \"gold\"}]"
		""
		"&6Де:&r біом «Кварцові рівнини»."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Як знайти:&r Компас дослідника → «sanctum»."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:quartz_pillar\"}}]"
	]
	quest.63C2C52D1861D802.title: "Санктум"
	quest.6491ACE47996C671.quest_desc: [ ]
	quest.6491ACE47996C671.title: "Пилок піксі"
	quest.64A2C1C192811B50.quest_desc: [ ]
	quest.64A2C1C192811B50.title: "Перший урожай"
	quest.64F19821B5FF6E39.quest_desc: [
		"&6Посол Тодор&r, посол до піглінів:"
		"&o«Я посол нашого королівства до піглінів. Вони погоджуються на мир лише за золото — і щоразу більше. Король вже переплавив корону.»&r"
		"&o«Чотири блоки золота — і пігліни відкриють нам шлях до бастіону, де полонені наші люди.»&r"
		"&fПринесіть чотири блоки золота. Носіть золоту броню — тоді пігліни вас не чіпатимуть."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.ender_pearl\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.fire_charge\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×15\", \"color\": \"gray\"}, {\"text\": \", 260 досвіду, 100 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.gold_block\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecraft.gold_block\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:gold_block\"}}]"
	]
	quest.64F19821B5FF6E39.title: "Золото для піглінів"
	quest.652CAA6481C63C1A.quest_desc: [
		"Залізний лицар б'є гігантською сокирою. Після кожного замаху сокира застрягає — тоді в нього відкрита спина, бийте туди."
		"Нагорода: &aсокира й шолом лицаря&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.mowziesmobs.ferrous_wroughtnaut\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aКована палата&r — підземна зала з залізними ґратами, у звичайних печерах світу."
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Спорядження:&r залізна броня, меч, швидкі ноги"
		"&6Як знайти:&r Компас дослідника → «wrought_chamber»."
		"&6Порада:&r спереду він невразливий — не тратьте сили на удари в груди."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:mowziesmobs:ferrous_wroughtnaut\"}}]"
	]
	quest.652CAA6481C63C1A.title: "Залізний лицар"
	quest.657D2D7C3024415E.quest_desc: [ ]
	quest.657D2D7C3024415E.title: "Механічні руки"
	quest.65AF334E98743C7F.quest_desc: [
		"Два компаси допоможуть знайти будь-що у світі:"
		" • &aКомпас дослідника&r (Explorer's Compass) — обираєте споруду (село, драконяче гніздо, підземелля...), і стрілка веде до найближчої."
		" • &aКомпас природи&r (Nature's Compass) — так само шукає &eбіоми&r."
		""
		"Багато квестів у цій книзі кажуть «знайдіть споруду X» — просто виберіть її в компасі."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.explorerscompass.explorerscompass\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.naturescompass.naturescompass\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.explorerscompass.explorerscompass\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"crafting_shaped: , crafting_shapeless: \", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.naturescompass.naturescompass\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"crafting_shaped: , crafting_shapeless: \", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki explorerscompass:explorerscompass\"}}]"
	]
	quest.65AF334E98743C7F.title: "Куди йти?"
	quest.65D09AD132204495.quest_desc: [
		"Олені в лісах іноді скидають &aроги&r — підберіть їх із землі. Роги можна повісити як прикрасу, а жорна Create перемелюють їх на кістяне борошно для добрива."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.naturalist.antler\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.naturalist.antler\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.naturalist.deer\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki naturalist:antler\"}}]"
	]
	quest.65D09AD132204495.title: "Оленячі роги"
	quest.661CA20A9F288824.quest_desc: [
		"Чарівні помічники автоматизують: &aСтарбанкл&r переносить предмети між скринями, &aДригмі&r збирає здобич із мобів у загоні, &aВіхі&r варить зілля, &aВіхляк&r вирощує рослини."
		"Їхні амулети роблять з особливих мобів, зустрінутих у світі (дивіться зошит)."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.starbuncle_charm\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ars_nouveau.starbuncle_charm\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Ars: зачаровувальний апарат, верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:starbuncle_charm\"}}]"
	]
	quest.661CA20A9F288824.title: "Старбанкл"
	quest.66F4D653B82E9440.quest_desc: [
		"&6Морячка Устина&r, колишня штурманка:"
		"&o«Колись я обігнула пів світу. Тепер мій корабель гниє в затоці, а я рахую чайок. Я хочу знати, що хтось ще пливе туди, де кінчаються мапи.»&r"
		"&o«Проженіть свій човен через три тисячі блоків моря — і принесіть мені звістку про далекі береги.»&r"
		"&fПропливіть човном три тисячі блоків."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.heart_of_the_sea\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×15\", \"color\": \"gray\"}, {\"text\": \", 450 досвіду, 180 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Пропливти човном: \", \"color\": \"gray\"}, {\"text\": \"3000 блоків\", \"color\": \"yellow\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:oak_boat\"}}]"
	]
	quest.66F4D653B82E9440.title: "Навколо світу"
	quest.673091ACD2ADBB9E.quest_desc: [
		"Боси Cataclysm розраховані на гравця в &eалмазному чи кращому&r спорядженні. Перед боєм:"
		" • зачаруйте броню (полиці Apotheosis);"
		" • візьміть золоті яблука, зілля і щит;"
		" • вкладіть очки в гілку &cВоїн&r дерева навичок;"
		" • кличте друзів — разом легше."
		""
		"&eЯк знайти арену Cataclysm:&r скрафтіть потрібне &aОко&r (у кожного боса своє, рецепт з оком Енду — у JEI) і киньте його, як око Енду: воно полетить у бік споруди."
		""
		"&6Порада:&r під час бою грає бойова музика; коли бос втрачає вас з поля зору, вона змовкає — так видно, що ви відірвалися."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:golden_apple\"}}]"
	]
	quest.673091ACD2ADBB9E.title: "Перед великим боєм"
	quest.6734983E6B8EE291.quest_desc: [ ]
	quest.6734983E6B8EE291.title: "Електронні лампи"
	quest.6770ED84F80FD89F.quest_desc: [ ]
	quest.6770ED84F80FD89F.title: "Привид шахти"
	quest.67C2D380381D64FC.quest_desc: [ ]
	quest.67C2D380381D64FC.title: "Мушлі шалкерів"
	quest.67CE474398B83022.quest_desc: [
		"Перша сила — &aводяне колесо&r. Поставте його так, щоб вода текла по лопатях, — воно крутиться саме. Від нього вали й шестерні несуть обертання далі."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.shaft\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.cogwheel\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.water_wheel\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.shaft\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: пилка, верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.cogwheel\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: розміщувач, верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.water_wheel\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Як:"
		"&71.&r Поставте колесо біля струмка або збудуйте водоспад, що б'є в лопаті збоку."
		"&72.&r Приєднайте вал (shaft) до осі колеса."
		"&73.&r Шестерні передають обертання вбік; велика й мала шестерні міняють швидкість."
		""
		"&6Порада:&r одягніть &aокуляри інженера&r — над машиною видно, скільки сили (stress) вона бере і скільки дає джерело."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:shaft\"}}]"
	]
	quest.67CE474398B83022.title: "Обертання"
	quest.6856727C54AFEFB9.quest_desc: [
		"&6Капітан Остап Чорновус&r, капітан без корабля &8(доручення 2 з 3)&r:"
		"&o«Мої хлопці спочили. А мені знову сниться море. Старі моряки кажуть: хто тримає серце моря, того вода не забирає.»&r"
		"&o«Серце лежить у скринях із затонулими скарбами — за картами скарбів із затонулих кораблів і руїн.»&r"
		"&fЗнайдіть серце моря."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.trident\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×14\", \"color\": \"gray\"}, {\"text\": \", 320 досвіду, скриня здобичі, 120 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.heart_of_the_sea\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.heart_of_the_sea\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: nucleosynthesizing\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:heart_of_the_sea\"}}]"
	]
	quest.6856727C54AFEFB9.title: "Серце моря"
	quest.68634AF527B8D1B6.quest_desc: [
		"&aОчищувальна камера&r з киснем перетворює руду на три грудки. Кисень дає &aелектролітичний сепаратор&r з води (а ще водень — паливо!)."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.purification_chamber\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.electrolytic_separator\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.electric_pump\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.mekanism.purification_chamber\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: mek data\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.mekanism.electrolytic_separator\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.mekanism.electric_pump\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Як:"
		"&71.&r Сепаратор: подайте воду електричною помпою, з одного боку вийде кисень, з другого — водень."
		"&72.&r Кисень трубками під тиском — в очищувальну камеру."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanism:purification_chamber\"}}]"
	]
	quest.68634AF527B8D1B6.title: "Потрійна обробка"
	quest.68702D578FC0195A.quest_desc: [
		"&6Філімон&r, кравець:"
		"&o«Я шию куртки для мисливців, а мисливці подалися на північ — за ведмедями. Тепер ні замовників, ні шкіри.»&r"
		"&o«Обіцяю: принесете шкіру — пошию вам таку куртку, що й дракон не подряпає. Ну, принаймні не одразу.»&r"
		"&fПринесіть шістнадцять шкір — корови, коні, ламі."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.leather_chestplate\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.leather_boots\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", 100 досвіду, 40 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.leather\", \"color\": \"aqua\"}, {\"text\": \" ×16\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.leather\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: дробарка, Create: жорна, верстак\", \"color\": \"white\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.aether.flying_cow\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.friendsandfoes.moobloom\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.hybrid_aquatic.dugong\", \"color\": \"white\"}, {\"text\": \" і ще 15\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:leather\"}}]"
	]
	quest.68702D578FC0195A.title: "Мандрівний кравець"
	quest.68801C24A9251DA0.quest_desc: [
		"Ковзач — кам'яний блок-бос, що ковзає по кімнаті і тисне. Він вразливий лише до &aкирки&r: бийте, коли він зупиняється."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.aether.slider\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aБронзове підземелля&r сховане всередині пагорбів на великих островах; зовні видно лише каміння."
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Спорядження:&r залізна чи занітова кирка, залізна броня"
		"&6Як знайти:&r Компас дослідника → «bronze_dungeon»."
		"&6Порада:&r у підземеллі є &aміміки&r — скрині, що кусають. Вдарте скриню перед тим, як відкрити."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:aether:slider\"}}]"
	]
	quest.68801C24A9251DA0.title: "Ковзач"
	quest.6912F3F4A5C7E07F.quest_desc: [
		"Apotheosis додає речам &eрідкісність&r (звичайна, незвичайна, рідкісна, епічна, міфічна) з випадковими властивостями-афіксами."
		"Такі речі падають з мобів (особливо з &cбосів-чемпіонів&r зі світлою аурою) і трапляються в скринях."
		""
		"Наведіть на предмет — у підказці видно рідкість і всі бонуси."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:diamond_sword\"}}]"
	]
	quest.6912F3F4A5C7E07F.title: "Рідкісні речі"
	quest.698AEAD5F8A419D7.quest_desc: [
		"&6Інспектор Кіндрат&r, інспектор гільдії металургів &8(доручення 3 з 3)&r:"
		"&o«Останнє доручення: гільдія будує першу автоматичну плавильню. Їй потрібні схеми керування — мозок кожної машини.»&r"
		"&o«Схему роблять з осмію й червоного пилу в металургійному наповнювачі. Ви вже знаєте, як він працює.»&r"
		"&fПринесіть вісім базових схем керування."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.mekanism.energy_tablet\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×20\", \"color\": \"gray\"}, {\"text\": \", 320 досвіду, скриня здобичі, 130 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.mekanism.basic_control_circuit\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.mekanism.basic_control_circuit\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Mekanism: металургійний наповнювач\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanism:basic_control_circuit\"}}]"
	]
	quest.698AEAD5F8A419D7.title: "Схеми керування"
	quest.69BE065DA73428B0.quest_desc: [
		"&6Дем'ян&r, мисливець за скарбами:"
		"&o«Підводний храм. Кажуть, у ньому золото, але насправді там є дещо цінніше: губки, що висушують море. За них у пустельних містах дають цілі статки.»&r"
		"&o«Я пробував тричі. Вартові з одним оком стріляють променем, від якого зупиняється серце. Я вже старий для таких пригод.»&r"
		"&fПринесіть чотири мокрі губки з океанської пам'ятки. Візьміть зілля підводного дихання і молоко від втоми рудників."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.diamond\", \"color\": \"aqua\"}, {\"text\": \" ×3\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.prismarine_crystals\", \"color\": \"aqua\"}, {\"text\": \" ×16\", \"color\": \"gray\"}, {\"text\": \", 280 досвіду, скриня здобичі, 100 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.sponge\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecraft.sponge\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак, піч, twilightforest: drying\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:sponge\"}}]"
	]
	quest.69BE065DA73428B0.title: "Храм вартових"
	quest.6A3C28BA92F6407A.quest_desc: [
		"Найкращий метал у грі. Зброя з неї підпалює (вогняна), заморожує (крижана) чи б'є блискавкою (грозова)."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.iceandfire.dragonsteel_fire_ingot\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.iceandfire.dragonsteel_fire_ingot\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: дробарка, Ice and Fire: драконяча кузня, верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki iceandfire:dragonsteel_fire_ingot\"}}]"
	]
	quest.6A3C28BA92F6407A.title: "Драконесталь"
	quest.6A5036C3CC3BFABD.quest_desc: [ ]
	quest.6A5036C3CC3BFABD.title: "Спадок пасічника"
	quest.6A68A0DFD3EFE9B8.quest_desc: [
		"Рамка з &aрамок телепорта&r і сам &aтелепорт&r: увійдіть у портал — і ви на іншому кінці світу або в іншому вимірі. &aКишеньковий телепорт&r носите з собою."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.teleporter\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.teleporter_frame\", \"color\": \"aqua\"}, {\"text\": \" ×9\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.mekanism.portable_teleporter\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.mekanism.teleporter\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.mekanism.teleporter_frame\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.mekanism.portable_teleporter\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: mek data\", \"color\": \"white\"}]"
		""
