	file.0000000000000001.title: "Wilds \\& Wanderers"
	quest.100433C49D1CD8B9.quest_desc: [ ]
	quest.100433C49D1CD8B9.title: "Механічний прес"
	quest.102DE72CB57467CC.quest_desc: [
		"&aМайстерня лісоруба&r: лісоруб сам рубає дерева й одразу садить нові саджанці. &aІнструментом лісника&r позначте ділянку лісу, де йому працювати."
		"Лісоруб уміє рубати й дерева модів, а великі дерева рубає цілком."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecolonies.blockhutlumberjack\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecolonies.blockhutlumberjack\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Порада:&r дайте йому сокиру краще — він працюватиме швидше; дерева з лісорубні можна везти на лісопильню Create."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecolonies:blockhutlumberjack\"}}]"
	]
	quest.102DE72CB57467CC.title: "Найнятий лісоруб"
	quest.10354F8A8551E38F.quest_desc: [ ]
	quest.10354F8A8551E38F.title: "Сльози ґаста"
	quest.105E9A0C2CEC95C4.quest_desc: [
		"У центрі Лабіринту, в окремій залі, живе &aГриботавр&r із величезною сокирою. Він розганяється і б'є з розмаху; вдарившись об стіну, на мить застигає."
		"Нагорода: &aсокира мінотавра&r і &aстроганов з мифу&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.twilightforest.minoshroom\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aЛабіринт&r — підземний лабіринт під болотом. Вхід — невеликий кам'яний павільйон на поверхні."
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Спорядження:&r щит обов'язково, броня, що не дає себе відкинути (луска наґи ідеальна)"
		"&6Як знайти:&r Магічна мапа (значок лабіринту) або Компас дослідника → «labyrinth». Всередині допоможе мапа лабіринту."
		"&6Порада:&r біля стін Гриботавр б'ється об них і застигає — так безпечніше, ніж посеред зали."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:twilightforest:minoshroom\"}}]"
	]
	quest.105E9A0C2CEC95C4.title: "Гриботавр"
	quest.108FA0C6C6A8E789.quest_desc: [
		"&aHome&r відкриває вікно браузера поверх гри: вікі модів, відео, мапи. Вікно можна перетягувати й змінювати розмір."
		"При першому запуску браузер один раз завантажує Chromium — зачекайте хвилину."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:glass_pane\"}}]"
	]
	quest.108FA0C6C6A8E789.quest_subtitle: "Клавіша Home"
	quest.108FA0C6C6A8E789.title: "Браузер у грі"
	quest.1099241061D2A9F4.quest_desc: [ ]
	quest.1099241061D2A9F4.title: "Камені джерела"
	quest.10C6B480D72A6D90.quest_desc: [
		"&6Харитон&r, лавовий рибалка:"
		"&o«Сорок років я рибалив у морі. Потім море мені набридло — бо в ньому все давно спіймано. А в лаві, кажуть, плаває риба з каменю.»&r"
		"&o«Я змайстрував лавову вудку, але руки вже не ті: жар із лави сушить очі, і поплавця я не бачу. Мені б хоч глянути на цю рибу, перш ніж помру.»&r"
		"&fСпіймайте мені три обсидіанові риби. Моя запасна вудка — ваша."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.netherdepthsupgrade.lava_fishing_rod\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.blaze_rod\", \"color\": \"aqua\"}, {\"text\": \" ×4\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×12\", \"color\": \"gray\"}, {\"text\": \", 260 досвіду, 90 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.netherdepthsupgrade.obsidianfish\", \"color\": \"aqua\"}, {\"text\": \" ×3\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.netherdepthsupgrade.obsidianfish\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.netherdepthsupgrade.obsidianfish\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki netherdepthsupgrade:obsidianfish\"}}]"
	]
	quest.10C6B480D72A6D90.title: "Риба, що не горить"
	quest.10C8AD389E6FDBC9.quest_desc: [ ]
	quest.10C8AD389E6FDBC9.title: "Нова кошара"
	quest.10E9D498140C6ABF.quest_desc: [
		"Дві руди Енду: &dнебуліт&r — енергія для знарядь Енду (з уламків складається небуліт) і &8шадолін&r — метал, що плавиться в злитки."
		""
		"Жорна Create і збагачувач Mekanism дають з руди більше, а Ars Nouveau заряджає уламки небуліту в джерельні самоцвіти."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.enderscape.nebulite\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.enderscape.shadoline_ingot\", \"color\": \"aqua\"}, {\"text\": \" ×6\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki enderscape:nebulite\"}}]"
	]
	quest.10E9D498140C6ABF.title: "Небуліт і шадолін"
	quest.11146B6C59F5E94E.quest_desc: [ ]
	quest.11146B6C59F5E94E.title: "Хліб для сиріт"
	quest.114EB85000044D1E.quest_desc: [
		"Плем'я &aумвутана&r в масках охороняє свого вождя. Умвуті б'є сонячними променями й кличе воїнів. Нагорода — &aЛик сонця&r: маска, що стріляє сонячним ударом."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.mowziesmobs.umvuthi\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aГай умвутана&r — селище з тотемами в &aсаванах&r."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r щит, лук, алмазна броня"
		"&6Як знайти:&r Компас дослідника → «umvuthana_grove»."
		"&6Порада:&r маски воїнів після бою можна носити — у кожної свій ефект."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:mowziesmobs:umvuthi\"}}]"
	]
	quest.114EB85000044D1E.title: "Умвуті"
	quest.116DEDD639324352.quest_desc: [
		"Alex's Caves ховає під землею шість рідкісних величезних біомів — кожен на сотні блоків углиб і вшир. Навмання їх шукати довго, тому:"
		" • у селах &aкартограф&r продає &aмапи печерного біома&r — вони ведуть до найближчого біому;"
		" • Компас природи теж уміє шукати печерні біоми."
		""
		"&aПечерний кодекс&r — посібник мода: ставте в нього &aпечерні таблички&r з кожного біому."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.alexscaves.cave_map\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r біоми лежать глибоко під землею, зазвичай нижче рівня моря і до самого дна світу."
		"&6Складність:&r &c★★&8★★★&r — помірно"
		"&6Спорядження:&r смолоскипи, водяне відро, кирка, їжа на довгу подорож"
		"&6Порада:&r викопайте шахту донизу драбиною й сходами — щоб повернутися з повними кишенями."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki alexscaves:cave_map\"}}]"
	]
	quest.116DEDD639324352.title: "Мапа печерного біома"
	quest.118702233F19D4E7.quest_desc: [
		"&6Ярема&r, колишній солдат &8(доручення 2 з 4)&r:"
		"&o«Після того, як ви розбили їхніх арбалетників, я вперше за двадцять років узяв арбалет і не трусився.»&r"
		"&o«Але арбалетники — це дрібнота. Справжні вбивці — поборники з сокирами. Це вони спалили нашу заставу.»&r"
		"&fПереможіть чотирьох поборників."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.iron_axe\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×10\", \"color\": \"gray\"}, {\"text\": \", 220 досвіду, 90 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.vindicator\", \"color\": \"red\"}, {\"text\": \" ×4\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:vindicator\"}}]"
	]
	quest.118702233F19D4E7.title: "Сокирники"
	quest.118B6A678B33FDCF.quest_desc: [
		"&6Христя&r, дівчина з фермерської родини:"
		"&o«Батько каже: доки я не виростимо власного врожаю, мене не пустять на ярмарок у місто. Я посадила моркву — а кролі все з'їли до останньої!»&r"
		"&o«Може, ви знаєте, як захистити грядку? А ще краще — принесіть мені моркву, і я покажу батькові, що впораюся. Ну... майже сама.»&r"
		"&fПринесіть тридцять дві моркви. Їх можна знайти в селах на грядках або виростити."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.golden_carrot\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×5\", \"color\": \"gray\"}, {\"text\": \", 80 досвіду, 30 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.carrot\", \"color\": \"aqua\"}, {\"text\": \" ×32\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.carrot\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.kobolds.kobold_zombie\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.minecraft.husk\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.minecraft.zombie\", \"color\": \"white\"}, {\"text\": \" і ще 2\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:carrot\"}}]"
	]
	quest.118B6A678B33FDCF.title: "Перший урожай"
	quest.11B26EF16F0E3B4E.quest_desc: [
		"&6Мар'яна&r, ловчиня перлів:"
		"&o«Я пірнала за перлами з восьми років. Минулого місяця акула відкусила мені два пальці, і тепер я не тримаю ножа.»&r"
		"&o«Раковини наутилуса дають утопленики й рибалки. Принесете три — і я віддам вам те, що беріг мій дід: серце моря.»&r"
		"&fПринесіть три раковини наутилуса."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.heart_of_the_sea\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", 200 досвіду, 70 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.nautilus_shell\", \"color\": \"aqua\"}, {\"text\": \" ×3\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.nautilus_shell\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: nucleosynthesizing, доменна піч, піч\", \"color\": \"white\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.cataclysm.deepling\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.cataclysm.deepling_angler\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.cataclysm.deepling_brute\", \"color\": \"white\"}, {\"text\": \" і ще 3\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:nautilus_shell\"}}]"
	]
	quest.11B26EF16F0E3B4E.title: "Перли рифу"
	quest.120BB2862BC3FBD3.quest_desc: [ ]
	quest.120BB2862BC3FBD3.title: "Мовчазна каплиця"
	quest.1262AEA77BCB5895.quest_desc: [ ]
	quest.1262AEA77BCB5895.title: "Вежа ліча"
	quest.1290F8470CF31418.quest_desc: [ ]
	quest.1290F8470CF31418.title: "Подорож лавою"
	quest.12A8D042F72D17A8.quest_desc: [ ]
	quest.12A8D042F72D17A8.title: "Слід дракона"
	quest.12DCDE38F58179CF.quest_desc: [ ]
	quest.12DCDE38F58179CF.title: "Ліки для ранніх"
	quest.12F61822E40941E4.quest_desc: [
		"&6Килина&r, доглядачка маяка:"
		"&o«Мій батько тридцять років тримав світло, щоб купці не розбилися об скелі. Цієї зими він помер, а вогонь згас.»&r"
		"&o«Я хочу запалити не один ліхтар, а вісім — щоб кожен човен бачив дорогу додому. Залізо я не вмію кувати, а купити нема на що.»&r"
		"&fПринесіть вісім ліхтарів: залізні самородки навколо смолоскипа на верстаті."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.spyglass\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", 100 досвіду, 40 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.lantern\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecraft.lantern\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:lantern\"}}]"
	]
	quest.12F61822E40941E4.title: "Вогні в тумані"
	quest.12FF5C0C56FA8D1D.quest_desc: [
		"Create: Enchantment Industry зберігає досвід як &eрідину&r. &aМеханічне точило&r знімає зачарування з речей і дає рідкий досвід; він збирається в баки."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create_enchantment_industry.mechanical_grindstone\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create_enchantment_industry.mechanical_grindstone\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create_enchantment_industry:mechanical_grindstone\"}}]"
	]
	quest.12FF5C0C56FA8D1D.title: "Рідкий досвід"
	quest.13105751B35D9192.quest_desc: [
		"Гобліни живуть цілими таборами: хатини з колод, тотеми, таверна. Є ватажок, шамани, чемпіони, лицарі й мисливці — а ще мирні &aторговці&r, &aбармен&r, &aковаль&r і &aінженер&r. Гобліни ворожі до чужинців, але не до своїх."
		""
		"&dЗв'язок світу:&r золоті &aгоблінські монети&r беруть сільські клірики й картографи, а мандрівний торговець продає за них керувальні схеми Mekanism."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Знайти споруду: \", \"color\": \"gray\"}, {\"translate\": \"wilds_wiki.structure.goblins_tyranny.goblinscamp\", \"color\": \"gold\"}]"
		""
		"&6Де:&r рівнини, засніжені рівнини, савани й луки; менші стоянки й каравани — на дорогах."
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Спорядження:&r залізна броня, щит, лук"
		"&6Як знайти:&r Компас дослідника → «goblinscamp»; каравани — «goblins_caravan»."
		"&6Порада:&r спершу виманюйте воїнів по одному: разом із шаманом вони дуже небезпечні."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki goblins_tyranny:hut_logs\"}}]"
	]
	quest.13105751B35D9192.title: "Табір гоблінів"
	quest.132890CBB2E83CE2.quest_desc: [
		"&6Ярема&r, колишній солдат &8(доручення 4 з 4)&r:"
		"&o«Їх веде закликач — маг, що кличе з-під землі ікла й примарних вексів. Він живе в лісовому особняку, глибоко в темному лісі.»&r"
		"&o«Я піду з вами до краю лісу. Далі — ви самі. Я старий, і я вже раз утік. Удруге не дозволю собі заважати.»&r"
		"&fЗнайдіть і переможіть закликача — ватажка розбійників."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.diamond_sword\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×20\", \"color\": \"gray\"}, {\"text\": \", 420 досвіду, скриня здобичі, 160 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.evoker\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:evoker\"}}]"
	]
	quest.132890CBB2E83CE2.title: "Ватажок"
	quest.132C4AF0A4E35B7A.quest_desc: [ ]
	quest.132C4AF0A4E35B7A.title: "Луска наґи"
	quest.1352F233D895E2CB.quest_desc: [
		"&6Гнат&r, мірошник:"
		"&o«У моєму млині оселилися павуки — величезні, з собаку завбільшки. Усю зиму я молов борошно, а тепер навіть двері відчинити боюся.»&r"
		"&o«Синок пішов до міста вчитися на писаря. Каже, павуки — це «екосистема». Мені від цієї екосистеми не легше.»&r"
		"&fВиженіть шістьох павуків. Ліпше вдень — уночі вони стають злими, як моя теща."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.bread\", \"color\": \"aqua\"}, {\"text\": \" ×12\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", 110 досвіду, 40 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.spider\", \"color\": \"red\"}, {\"text\": \" ×6\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:spider\"}}]"
	]
	quest.1352F233D895E2CB.title: "Старий млин"
	quest.1356C4778974BDDC.quest_desc: [
		"&6Мірра&r, хранителька Перехрестя:"
		"&o«Ласкаво просимо до Перехрестя! Колись тут стояло ельфійське святилище, а тепер ці арки зустрічають усіх, хто приходить у цей світ. Я зустрічаю разом із ними.»&r"
		"&o«Світ навколо дикий і великий: ліси, гори, моря, підземелля, дракони. Тут, на Перехресті, ви в безпеці — ніхто не зашкодить ні вам, ні тваринам, і чудовиська сюди не забредуть. Але далі вже самі.»&r"
		"&o«Перш ніж рушати, покажіть, що вмієте працювати руками. Змайструйте верстак: чотири дошки з будь-якої деревини, а дошки — з колоди. Дерев довкола вдосталь.»&r"
		"&fЗмайструйте і принесіть мені верстак. Натомість отримаєте кам'яне знаряддя, хліб, смолоскипи й ліжко — на першу ніч вистачить."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.stone_pickaxe\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.stone_axe\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.stone_sword\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.bread\", \"color\": \"aqua\"}, {\"text\": \" ×12\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.torch\", \"color\": \"aqua\"}, {\"text\": \" ×32\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.white_bed\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", 60 досвіду, 30 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.crafting_table\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecraft.crafting_table\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:crafting_table\"}}]"
	]
	quest.1356C4778974BDDC.title: "Перший верстак"
	quest.1378D3A1FE92702D.quest_desc: [
		"&6Лукія&r, сільська лікарка &8(доручення 1 з 4)&r:"
		"&o«Хтось у сусідньому селі приніс хворобу, від якої люди сіріють і забувають власних дітей. Тих, хто вже зовсім перетворився, ми не врятуємо.»&r"
		"&o«Я знаю, як лікувати ранніх — золоте яблуко і слабкість. Але поки троє обернених бродять навколо, хвороба ширитиметься.»&r"
		"&fЗупиніть трьох обернених селян-зомбі. Знаю, це важко. Але це милосердя."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.golden_apple\", \"color\": \"aqua\"}, {\"text\": \" ×2\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.glistering_melon_slice\", \"color\": \"aqua\"}, {\"text\": \" ×4\", \"color\": \"gray\"}, {\"text\": \", 150 досвіду, 60 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.zombie_villager\", \"color\": \"red\"}, {\"text\": \" ×3\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:zombie_villager\"}}]"
	]
	quest.1378D3A1FE92702D.title: "Чорна хвороба"
	quest.1386403DCD6EB039.quest_desc: [
		"&6Мисливиця Агафія&r, ловчиня рідкісних звірів:"
		"&o«Я полювала на ведмедів, тигрів і навіть на кракена. Але валюмрапторів не бачив ніхто з мисливської гільдії. Мені потрібен доказ.»&r"
		"&o«Вони полюють зграями, а я одна. Навіть я не така дурна.»&r"
		"&fПодолайте трьох валюмрапторів у Первісних печерах. Вони нападають зграєю — тримайтеся спиною до стіни."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.alexscaves.dinosaur_nugget\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×15\", \"color\": \"gray\"}, {\"text\": \", 280 досвіду, скриня здобичі, 110 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.alexscaves.vallumraptor\", \"color\": \"red\"}, {\"text\": \" ×3\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:alexscaves:vallumraptor\"}}]"
	]
	quest.1386403DCD6EB039.title: "Полювання на ящерів"
	quest.138A16DCFE107162.quest_desc: [ ]
	quest.138A16DCFE107162.title: "Крила Енду"
	quest.138A3FAD187372F1.quest_desc: [ ]
	quest.138A3FAD187372F1.title: "Вітряк для села"
	quest.139FE25C0CE40ED0.quest_desc: [
		"Ars Nouveau й Iron's Spells мають &eспільну ману&r. Камера насичення Ars робить з аметисту магічну есенцію Iron's, а з есенції — джерельний самоцвіт."
		"Серце дракона чи гідри замінює вісім рун у сфері покращення мани."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:source_gem\"}}]"
	]
	quest.139FE25C0CE40ED0.title: "Одна магія"
	quest.13B0EE05A2F4E780.quest_desc: [
		"&aСкладський облік&r (stock ticker) бачить усі сховища, з'єднані &aскладськими зв'язками&r, і за замовленням пакує й надсилає будь-що. &aЗапитувач&r від редстоуну сам замовляє, коли чогось бракує."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.stock_ticker\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.stock_link\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.redstone_requester\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.stock_ticker\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.stock_link\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.redstone_requester\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:stock_ticker\"}}]"
	]
	quest.13B0EE05A2F4E780.title: "Склад на замовлення"
	quest.13CD1454E5F8B072.quest_desc: [
		"&6Тетяна&r, дівчина з хворою сестрою:"
		"&o«Моя сестричка не встає з ліжка третій тиждень. Знахарка каже: допоможе пилок піксі — він лікує те, що не лікують трави.»&r"
		"&o«Піксі живуть у грибних будиночках у темному лісі. Вони крадуть усе, що блищить, і сміються. Мене вони обікрали двічі.»&r"
		"&fПринесіть чотири дрібки пилку піксі. Піксі здобувають з них, коли ті падають. Не тримайте в руках цінного — піксі краде!"
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.golden_apple\", \"color\": \"aqua\"}, {\"text\": \" ×2\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", 180 досвіду, 70 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.iceandfire.pixie_dust\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.iceandfire.pixie_dust\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.iceandfire.pixie\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki iceandfire:pixie_dust\"}}]"
	]
	quest.13CD1454E5F8B072.title: "Пилок піксі"
	quest.13D2843AA2AA243D.quest_desc: [
		"&aРетранслятори&r передають джерело між глечиками й машинами на відстань — зв'яжіть їх жезлом панування."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.ars_nouveau.relay\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.dominion_wand\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.ars_nouveau.relay\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ars_nouveau.dominion_wand\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Ars: зачаровувальний апарат\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:relay\"}}]"
	]
	quest.13D2843AA2AA243D.title: "Ретранслятори"
	quest.13FE9795096BB208.quest_desc: [
		"&aЛатунь&r — серце пізнього Create. Мідь і цинк змішують &aмеханічним змішувачем&r у чані, під яким стоїть &aпальник іфрита&r (зловіть іфрита в порожній пальник у Незері). З латуні — розумні механізми, рука-маніпулятор і поїзди."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.mechanical_mixer\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.basin\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.blaze_burner\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.create.brass_ingot\", \"color\": \"aqua\"}, {\"text\": \" ×16\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.mechanical_mixer\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.basin\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Як:"
		"&71.&r Зловіть іфрита в порожній пальник (клацніть пальником по іфриту в незерській фортеці)."
		"&72.&r Поставте пальник, над ним чан, над чаном змішувач."
		"&73.&r Нагодуйте пальник вугіллям чи деревом і киньте в чан мідь і цинк."
		""
		"&6Де:&r іфрити — у незерських фортецях"
		"&6Складність:&r &c★★&8★★★&r — помірно"
		"&6Спорядження:&r зілля вогнестійкості"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:mechanical_mixer\"}}]"
	]
	quest.13FE9795096BB208.title: "Змішувач і латунь"
	quest.14038EE3F653F0D0.quest_desc: [
		"Ілладжери не сидять у самих лише форпостах: є фортеці, вітряки, табори, галери й навіть школа &aілюзіоністів&r і хижа &aкрижаного чаклуна&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Знайти споруду: \", \"color\": \"gray\"}, {\"translate\": \"wilds_wiki.structure.dungeons_arise.illager_fort\", \"color\": \"gold\"}]"
		""
		"&6Де:&r темні ліси, гори й узбережжя; крижаний чаклун — у снігах."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r щит від сокир, тотем безсмертя, лук"
		"&6Як знайти:&r Компас дослідника → «illager_fort», «illager_windmill», «illusioner_training_grounds», «iceologer_cabin»."
		"&6Порада:&r &aохоронці сіл&r (Guard Villagers) допомагають відбивати набіги — заведіть кількох."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:totem_of_undying\"}}]"
	]
	quest.14038EE3F653F0D0.title: "Твердиня ілладжерів"
	quest.140BBBFC6D69FCF4.quest_desc: [ ]
	quest.140BBBFC6D69FCF4.title: "Компас утопленика"
	quest.141B76BAC5B15B2D.quest_desc: [
		"&aКіклоп&r — око для амулета; &aГоргона&r — голова, що скам'янює; &aТроль&r — бивні й шкура (підходить як шкіра); &aГідра&r — серце для магії; &aСирена&r співає і тягне на дно."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.iceandfire.troll_tusk\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.iceandfire.troll_tusk\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.iceandfire.troll\", \"color\": \"white\"}]"
		""
		"&6Де:&r кіклопи й горгони — на узбережжях, гідри — у болотах, тролі — у печерах лісів і гір, сирени — на скелях серед океану."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Як знайти:&r Компас дослідника → «cyclops_cave», «gorgon_temple», «hydra_cave», «siren_island»."
		"&6Порада:&r на горгону дивіться лише через відображення: тримайте перед собою щит. Від співу сирен рятують &aберуші&r."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki iceandfire:troll_tusk\"}}]"
	]
	quest.141B76BAC5B15B2D.title: "Інші міфічні звірі"
	quest.1429AB275B508821.quest_desc: [
		"&aРак-самітник&r на березі міняє черепашки на свої скарби. Найрідкісніший — &aзловісна мушля&r: «Глибокий океан кличе зсередини». Що відповість на її поклик — дізнайтеся самі."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.hybrid_aquatic.ominous_conch\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r пляжі теплих морів, біля води."
		"&6Складність:&r &c★★★★★&8&r — смертельно"
		"&6Порада:&r не дмухайте в мушлю без повного спорядження і друзів поруч."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki hybrid_aquatic:ominous_conch\"}}]"
	]
	quest.1429AB275B508821.title: "Зловісна мушля"
	quest.1464F36CC958AD76.quest_desc: [
		"Збудуйте рамку, як для порталу в Незер, але зі &aсвітлокаменю&r, і вилийте в неї &aводу&r — відкриється блакитний портал."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Потрапити у вимір: \", \"color\": \"gray\"}, {\"text\": \"Етер\", \"color\": \"light_purple\"}]"
		""
		"&6Складність:&r &c★★&8★★★&r — помірно"
		"&6Спорядження:&r парашути чи зілля повільного падіння, блоки для мостів, їжа"
		"&6Порада:&r в Етері найбільша небезпека — падіння з острова. Ходіть присівши біля країв."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:glowstone\"}}]"
	]
	quest.1464F36CC958AD76.title: "Портал в Етер"
	quest.147BA8A1DE77678F.quest_desc: [
		"Дробильні колеса Create розмелюють &eдраконячу луску&r на золото й досвід. Mekanism збагачує &eбурштин&r до слизу. Crafts \\& Additions переводить обертання Create в енергію Mekanism і AE2, а Applied Mekanistics зберігає хімікати Mekanism у мережі AE2."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:crushing_wheel\"}}]"
	]
	quest.147BA8A1DE77678F.title: "Машини і звірі"
	quest.14B743B4EE0A5A7B.quest_desc: [
		"&aКістки дракона&r (Ice and Fire) і &aтяжкі кістки динозаврів&r (Alex's Caves) — взаємозамінні в рецептах обох модів."
		"Жорна Create і камера збагачення Mekanism перемелюють їх на 9–12 кісткового борошна."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.alexscaves.heavy_bone\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.alexscaves.heavy_bone\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.alexscaves.atlatitan\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.alexscaves.relicheirus\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.alexscaves.tremorsaurus\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki alexscaves:heavy_bone\"}}]"
	]
	quest.14B743B4EE0A5A7B.title: "Стародавні кістки"
	quest.14CE780DAEDBACDE.quest_desc: [
		"Вам самим теж не треба лізти на кожне дерево: зрубайте &eнижню колоду сокирою&r — і все дерево впаде. Сокира зношується за кожну колоду."
		""
		" • &aприсядьте&r, щоб зрубати лише одну колоду;"
		" • зрубані будинки з колод без листя не падають — дерево має мати листя;"
		" • дерева понад 200 колод рубайте по частинах."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.oak_log\", \"color\": \"aqua\"}, {\"text\": \" ×64\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecraft.oak_log\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Порада:&r з &aзачаруванням «Непорушність»&r сокира проживе довше; найкращі сокири — з драконячої сталі й кобольдського заліза."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:oak_log\"}}]"
	]
	quest.14CE780DAEDBACDE.title: "Рубати дерево цілком"
	quest.150F7B10715DC46E.quest_desc: [
		"&aЦифровий видобувач&r копає під собою все, що ви скажете в фільтрах, у радіусі до 32 блоків, і складає в скриню. Без жодної кирки."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.digital_miner\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.mekanism.digital_miner\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: mek data\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanism:digital_miner\"}}]"
	]
	quest.150F7B10715DC46E.title: "Цифровий видобувач"
	quest.1550F30143B976FA.quest_desc: [
		"Лавові моря Незеру живі: дев'ять видів риб. Для лави потрібна &aлавова вудка&r — з незеритових уламків, стрижнів іфрита й ланцюгів."
		""
		"Улов корисний: блейзриба дає порох іфрита, світлосардина — світлопил, обсидіанова риба — обсидіан, а з риби-ока, ножиць і пороху іфрита виходить &aоко Енду&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.netherdepthsupgrade.lava_fishing_rod\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.netherdepthsupgrade.eyeball_fish\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.netherdepthsupgrade.eyeball_fish\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.netherdepthsupgrade.eyeball_fish\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki netherdepthsupgrade:lava_fishing_rod\"}}]"
	]
	quest.1550F30143B976FA.title: "Рибалка в лаві"
	quest.15A00B67B6842B83.quest_desc: [ ]
	quest.15A00B67B6842B83.title: "Точні механізми"
	quest.15A0C063E3AFF4E9.quest_desc: [
		"&6Митар Гаврило&r, збирач мита:"
		"&o«Я збирав мито на мосту через ущелину. Аж поки під мостом не оселився троль. Тепер він збирає мито. Зі мною включно.»&r"
		"&o«Тролі кам'яніють на сонці — так кажуть. Але цей виходить тільки вночі, а вдень спить у печері.»&r"
		"&fПодолайте троля. Вони живуть у печерах лісів, гір і снігів; вдень сонце б'є по них."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.gold_ingot\", \"color\": \"aqua\"}, {\"text\": \" ×12\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×12\", \"color\": \"gray\"}, {\"text\": \", 300 досвіду, скриня здобичі, 110 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.iceandfire.troll\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:iceandfire:troll\"}}]"
	]
	quest.15A0C063E3AFF4E9.title: "Міст троля"
	quest.15A615A877798006.quest_desc: [
		"&6Капітан Остап Чорновус&r, капітан без корабля &8(доручення 3 з 3)&r:"
		"&o««Буревісник» пішов на дно не через шторм. Його втягнув під воду старійшина — величезна риба з одним оком, що живе в підводному храмі.»&r"
		"&o«Поки він живий, жоден корабель тут не пройде. Я дам вам усе, що маю, — тільки закінчіть те, чого не зміг я.»&r"
		"&fПереможіть старійшину-вартового в підводному храмі."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"block.minecraft.conduit\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×20\", \"color\": \"gray\"}, {\"text\": \", 500 досвіду, скриня здобичі, 180 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.elder_guardian\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:elder_guardian\"}}]"
	]
	quest.15A615A877798006.title: "Старійшина глибин"
	quest.15AA39284E74D774.quest_desc: [
		"&aБестіарій&r — книга про всіх міфічних істот. Сторінки (&aрукописи&r) знаходять у скринях; додайте їх у книгу на ковадлі."
		""
		"&cДракони дуже небезпечні.&r Молодого дракона ще можна здолати в залізі, дорослого — лише в найкращому спорядженні і з зіллями вогнестійкості."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.iceandfire.bestiary\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.iceandfire.bestiary\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Порада:&r відкрийте Бестіарій перед кожним новим звіром — там написано, чого він боїться."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki iceandfire:bestiary\"}}]"
	]
	quest.15AA39284E74D774.title: "Бестіарій"
	quest.15D3F3415C3EBCAD.quest_desc: [
		"Ватажок — найсильніший гоблін табору, з булавою й охороною. Шаман лікує його кулями зцілення — бийте шамана першим."
		"Нагорода: &aгоблінські злитки&r, зброя і багато монет."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.goblins_tyranny.leader_goblin\", \"color\": \"red\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.goblins_tyranny.shaman_goblin\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r центр великого табору гоблінів."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r алмазна броня, щит, лук"
		"&6Порада:&r &aпастки-бочки&r в таборі вибухають — не бийтеся біля них."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:goblins_tyranny:leader_goblin\"}}]"
	]
	quest.15D3F3415C3EBCAD.title: "Ватажок гоблінів"
	quest.15F2F41165352878.quest_desc: [
		"&6Мотря&r, вдова-пекарка:"
		"&o«Після нападу розбійників у селі лишилося семеро дітей без батьків. Я взяла їх до себе — а хліба печу на трьох.»&r"
		"&o«Моє поле спалили. Купити пшениці нема за що, а просити в сусідів соромно — у них і самих порожньо.»&r"
		"&fПринесіть мені сорок вісім снопів пшениці — на місяць вистачить, а там своє поле підніметься."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"block.minecraft.cake\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.bread\", \"color\": \"aqua\"}, {\"text\": \" ×16\", \"color\": \"gray\"}, {\"text\": \", 90 досвіду, 35 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.wheat\", \"color\": \"aqua\"}, {\"text\": \" ×48\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecraft.wheat\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.twilightforest.kobold\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:wheat\"}}]"
	]
	quest.15F2F41165352878.title: "Хліб для сиріт"
	quest.15FAC0D539CF130C.quest_desc: [
		"&6Мирослава&r, травниця з печер:"
		"&o«Я варю протиотруту від павучих укусів. Іронія в тому, що для неї потрібні... павучі очі. Дванадцять на одну партію.»&r"
		"&o«Але в печерах я сліпа, як кріт, а павуки бачать у темряві чудово. Нечесна гра.»&r"
		"&fПринесіть дванадцять павучих очей."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.potion\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.fermented_spider_eye\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", 150 досвіду, 60 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.spider_eye\", \"color\": \"aqua\"}, {\"text\": \" ×12\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.spider_eye\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.iceandfire.dread_scuttler\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.minecraft.cave_spider\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.minecraft.spider\", \"color\": \"white\"}, {\"text\": \" і ще 5\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:spider_eye\"}}]"
	]
	quest.15FAC0D539CF130C.title: "Павуча королева"
	quest.160AA71586F06BBE.quest_desc: [
		"&aМоа&r — великий небесний птах, який літає кілька стрибків поспіль. Висидіть яйце моа в &aінкубаторі&r (паливо — амброзієві смолоскипи) і вигодуйте пташеня &aпелюстками ехора&r (з хижих квітів-ехорів)."
		"Сині моа стрибають тричі, білі — чотири рази, чорні — вісім."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.aether.incubator\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.aether.incubator\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Де:&r перше яйце — нагорода цього завдання, інші трапляються у скринях підземель Етеру."
		"&6Складність:&r &c★&8★★★★&r — легко"
		"&6Порада:&r сідло потрібне — дорослого моа осідлайте, як коня."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki aether:incubator\"}}]"
	]
	quest.160AA71586F06BBE.title: "Свій моа"
	quest.16408663A924D059.quest_desc: [
		"&aТайне ковадло&r покращує броню й зброю &aсферами покращення&r (мана, перезаряджання, сила вогню...) і вписує закляття прямо у зброю."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.irons_spellbooks.arcane_anvil\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.irons_spellbooks.upgrade_orb\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.irons_spellbooks.mana_upgrade_orb\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.irons_spellbooks.arcane_anvil\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.irons_spellbooks.upgrade_orb\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.irons_spellbooks.mana_upgrade_orb\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki irons_spellbooks:arcane_anvil\"}}]"
	]
	quest.16408663A924D059.title: "Тайне ковадло"
	quest.167B1925FDFDBA87.quest_desc: [
		"&aКонтролер&r — серце мережі, &aприводи&r тримають диски, &aтермінал&r показує все, що є. Кабелі несуть канали: один кабель — 8 каналів, щільний — 32."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.ae2.controller\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.ae2.drive\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.item_storage_cell_1k\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.terminal\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.ae2.energy_acceptor\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.fluix_glass_cable\", \"color\": \"aqua\"}, {\"text\": \" ×16\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.ae2.controller\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.ae2.drive\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ae2.item_storage_cell_1k\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Як:"
		"&71.&r Поставте контролер, приєднайте до нього приймач енергії й кабелі."
		"&72.&r Підключіть привід з диском 1k і термінал."
		"&73.&r Покладіть предмети в термінал — вони на диску."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ae2:controller\"}}]"
	]
	quest.167B1925FDFDBA87.title: "ME-мережа"
	quest.1692E0F37F6EF9C5.quest_desc: [
		"Шість привидів-лицарів нападають по черзі з мечами, сокирами й кирками, і кожна хвиля хитріша. Нагорода — &aфантомні шолом і нагрудник&r."
		"У коридорах фортеці — &aскупчення уламків броні&r: з уламків роблять &aлицарський метал&r для найкращої броні лісу."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.twilightforest.knight_phantom\", \"color\": \"red\"}, {\"text\": \" ×6\"}]"
		""
		"&6Де:&r &aФортеця лицарів&r під землею в &aТемному лісі&r. Зверху видно лише руїни; вхід — сходи вниз."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r алмазна або вогняна броня, щит, зілля сили"
		"&6Як знайти:&r Магічна мапа (значок шолома) або Компас дослідника → «knight_stronghold»."
		"&6Порада:&r у фортеці ходять &aгобліни з ланцюгами&r — вони б'ють крізь щит, тримайте дистанцію."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:twilightforest:knight_phantom\"}}]"
	]
	quest.1692E0F37F6EF9C5.title: "Фантоми лицарів"
	quest.16985E828456BE28.quest_desc: [ ]
	quest.16985E828456BE28.title: "Бурштин із мушкою"
	quest.16BDC13AE064569E.quest_desc: [
		"&6Вчений Аркадій&r, астроном:"
		"&o«Я досліджую зорі. Більшість падає з неба, але є одна, що народжується в смерті Візера — триголового чудовиська з черепів.»&r"
		"&o«Ця зірка — серце маяка, що дає людям силу. Я хочу побачити її світло зблизька, хоча б раз.»&r"
		"&fПодолайте Візера й принесіть зірку Незеру. Викликайте його далеко від дому — і під землею він слабший у маневрі."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"block.minecraft.beacon\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.diamond\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", 800 досвіду, скриня здобичі, 300 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.nether_star\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:nether_star\"}}]"
	]
	quest.16BDC13AE064569E.title: "Темна зірка"
	quest.16BF35D0C86DB3DE.quest_desc: [
		"&6Отець Мирон&r, мандрівний священник:"
		"&o«Я йшов від села до села, поки не знайшов цю каплицю в руїнах. Тут колись молилися сотні людей, а тепер ночами ходять мертві.»&r"
		"&o«Мертві не винні, що вони мертві. Але їм не можна блукати серед живих. Моя віра сильна, а руки слабкі.»&r"
		"&fУпокойте п'ятнадцятьох зомбі. Хай Бог прийме їх душі."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.golden_apple\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.experience_bottle\", \"color\": \"aqua\"}, {\"text\": \" ×8\", \"color\": \"gray\"}, {\"text\": \", 180 досвіду, 70 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.zombie\", \"color\": \"red\"}, {\"text\": \" ×15\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:minecraft:zombie\"}}]"
	]
	quest.16BF35D0C86DB3DE.title: "Мовчазна каплиця"
	quest.16CF56C1A34F57C5.quest_desc: [ ]
	quest.16CF56C1A34F57C5.title: "Мед на весілля"
	quest.16FB9F389E51E07B.quest_desc: [
		"У кожному лісі Незеру росте свій фрукт: &3ківано&r (химерний ліс, вогнестійкість), &cпітая&r (багряний ліс, знімає візер), &6рамбутан&r (пустища, регенерація), &5жаботикаба&r (базальтові дельти, знімає ефекти), &eрука Будди&r (пісок душ, нічний зір)."
		""
		"Ножем на дошці ківано ріжеться на скибки й дає шкірку — з неї броня й знаряддя, які самі переплавляють здобуте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.netherexotics.kiwano\", \"color\": \"aqua\"}, {\"text\": \" ×3\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.netherexotics.rambutan\", \"color\": \"aqua\"}, {\"text\": \" ×3\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki netherexotics:kiwano\"}}]"
	]
	quest.16FB9F389E51E07B.title: "Фрукти Незеру"
	quest.175253F3A02AF69E.quest_desc: [
		"Триголова &aгідра&r сидить у печері серед лави. Голови кусають і плюються вогнем; відрубана голова відростає, поки тіло ціле. Бийте голову, коли паща відкрита."
		"Нагорода: &eвогняна кров&r — у збірці вона взаємозамінна з кров'ю вогняного дракона. З неї і вогняних сліз роблять вогняні злитки."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.twilightforest.hydra\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aЛігво гідри&r у центрі &aВогняного болота&r (озера лави й вогняні гриби)."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r 3–4 зілля вогнестійкості, лук, повна залізна броня або краща"
		"&6Як знайти:&r Магічна мапа (значок гідри) або Компас дослідника → «hydra_lair»."
		"&6Порада:&r тримайтеся ближче до стін печери: там менше шансів упасти в лаву після удару."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:twilightforest:hydra\"}}]"
	]
	quest.175253F3A02AF69E.title: "Гідра"
	quest.178871A350B35809.quest_desc: [
		"У селах трапляються &eдошки завдань&r (Bountiful): на них висять замовлення — принести речі чи перемогти мобів — за винагороду."
		"Завдання оновлюються з часом, тож до дошки варто повертатися."
		""
		"А ще в спорудах світу трапляються &eмандрівники з дорученнями&r — із золотим &6«!»&r над головою. Про них — розділ «Доручення»."
		""
		"Позначте квест виконаним, коли знайдете першу дошку."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:writable_book\"}}]"
	]
	quest.178871A350B35809.title: "Дошки завдань"
	quest.178B34D3803D3C16.quest_desc: [
		"&aQIO&r — сховище на квантових дисках: масив дисків, панель доступу, імпортери й експортери. Як ME-мережа, але без кабелів — усе через частоту."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.qio_drive_array\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.qio_dashboard\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.mekanism.qio_drive_base\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.mekanism.portable_qio_dashboard\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.mekanism.qio_drive_array\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"mekanism: mek data\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.mekanism.qio_dashboard\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.mekanism.qio_drive_base\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanism:qio_drive_array\"}}]"
	]
	quest.178B34D3803D3C16.title: "Квантове сховище QIO"
	quest.179A7F98C194B097.quest_desc: [
		"&6Вовчиця Ганна&r, мисливиця Сутінкового лісу:"
		"&o«Я пройшла крізь портал рік тому і досі не знайшла шляху назад. Тут добре — але одна змія розміром з річку не дає ходити далі її подвір'я.»&r"
		"&o«Наґа живе на кам'яному дворі серед лісу. Її луска міцніша за залізо — якщо принесете, пошию собі обладунок і піду додому.»&r"
		"&fПодолайте наґу й принесіть шість її лусок. Двір наґи — квадратна кам'яна арена, магічна мапа показує її значок."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.diamond\", \"color\": \"aqua\"}, {\"text\": \" ×3\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×15\", \"color\": \"gray\"}, {\"text\": \", 320 досвіду, скриня здобичі, 120 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.twilightforest.naga_scale\", \"color\": \"aqua\"}, {\"text\": \" ×6\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.twilightforest.naga_scale\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.twilightforest.naga\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki twilightforest:naga_scale\"}}]"
	]
	quest.179A7F98C194B097.title: "Луска наґи"
	quest.17C171B972451303.quest_desc: [
		"&6Плакальниця Ярина&r, жінка, що не вміє плакати:"
		"&o«Коли загинув мій чоловік, я не зронила жодної сльози. Відтоді на мені прокляття: я не можу ні плакати, ні сміятися.»&r"
		"&o«Знахар сказав: сльози ґаста повернуть мені серце. Ґасти плачуть, коли помирають, — над морем лави, де їхні крики чути на милі.»&r"
		"&fПринесіть три сльози ґаста. Відбивайте їхні вогняні кулі ударом — і вони впадуть від власного вогню. Сльози падають над лавою, будьте швидкі."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.golden_apple\", \"color\": \"aqua\"}, {\"text\": \" ×2\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×12\", \"color\": \"gray\"}, {\"text\": \", 240 досвіду, 90 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.ghast_tear\", \"color\": \"aqua\"}, {\"text\": \" ×3\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.ghast_tear\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Create: дробарка\", \"color\": \"white\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.minecraft.ghast\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.twilightforest.carminite_ghastguard\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.twilightforest.carminite_ghastling\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:ghast_tear\"}}]"
	]
	quest.17C171B972451303.title: "Сльози ґаста"
	quest.17D0656FAD6AEFB4.quest_desc: [
		"&aТермальна випарювальна вежа&r (до 4×4×18) випаровує морську воду на розсіл і літій. Літій потрібен для термоядерного палива."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.thermal_evaporation_controller\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.thermal_evaporation_valve\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.mekanism.thermal_evaporation_block\", \"color\": \"aqua\"}, {\"text\": \" ×32\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.mekanism.thermal_evaporation_controller\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.mekanism.thermal_evaporation_valve\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.mekanism.thermal_evaporation_block\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki mekanism:thermal_evaporation_controller\"}}]"
	]
	quest.17D0656FAD6AEFB4.title: "Соляна вежа"
	quest.17FFF5CD503E185C.quest_desc: [
		"Динозаври дають:"
		" • &aжорстку шкіру&r — броня первісної людини; у збірці вона &eпідходить замість шкіри&r скрізь, а прес Create робить з неї 3 шкіри;"
		" • &aтяжкі кістки&r — палиця й списи; вони &eвзаємозамінні з драконячими кістками&r;"
		" • &aм'ясо&r і &aяйця&r — з яйця можна вивести свого динозавра."
		"&aБурштин&r у печерах — Mekanism перетворює його на слиз."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.alexscaves.tough_hide\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.alexscaves.heavy_bone\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.alexscaves.tough_hide\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.alexscaves.grottoceratops\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.alexscaves.heavy_bone\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.alexscaves.atlatitan\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.alexscaves.relicheirus\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.alexscaves.tremorsaurus\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki alexscaves:tough_hide\"}}]"
	]
	quest.17FFF5CD503E185C.title: "Здобич динозаврів"
	quest.1845461FE739127F.quest_desc: [
		"Гоблінські інженери майструють &aпрототип броні&r. Здобудьте його і вдоскональте на &aінженерному верстаті&r інженерним брухтом — так отримаєте посилену броню."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.goblins_tyranny.goblins_prototype_chestplate\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Порада:&r &aглітерон&r — блискучий звірок гоблінів — теж носить броню; її кують на тому ж верстаті."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki goblins_tyranny:goblins_prototype_chestplate\"}}]"
	]
	quest.1845461FE739127F.title: "Прототип інженера"
	quest.18C25A9BAEDC017D.quest_desc: [ ]
	quest.18C25A9BAEDC017D.title: "Темна зірка"
	quest.18C990156988DB4F.quest_desc: [
		"Збудуйте перший корабель і вийдіть у море. Корабель — це ваша плавуча база: у трюмі є скрині, а на палубі поміститься друг."
		"&eКерування:&r W/S — вітрило й швидкість, A/D — кермо. Вітер змінюється; стежте за прапорцем на щоглі."
		""
		"&6Порада:&r візьміть на корабель &aнамет&r — і ви матимете дім у будь-якій бухті."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki smallships:oak_cog\"}}]"
	]
	quest.18C990156988DB4F.title: "Свій корабель"
	quest.18EA9EEB2F3019C5.quest_desc: [ ]
	quest.18EA9EEB2F3019C5.title: "Дракон Енду"
	quest.19155CB614BB5BBB.quest_desc: [
		"Диски ростуть учетверо: 1k, 4k, 16k, 64k, 256k. Компонент диска 256k — один із найдорожчих предметів AE2."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.item_storage_cell_16k\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.item_storage_cell_64k\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ae2.item_storage_cell_16k\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ae2.item_storage_cell_64k\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ae2:item_storage_cell_16k\"}}]"
	]
	quest.19155CB614BB5BBB.title: "Більші диски"
	quest.19409746A6FD9BCC.quest_desc: [
		"&aСачок&r ловить дрібних тварин — метеликів, світлячків, равликів, ящірок — і переносить їх живими. Так заселяють сад чи зоопарк біля бази."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.naturalist.capture_net\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.naturalist.capture_net\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Порада:&r світлячки світяться вночі над болотами й луками; метелики запилюють квіти й саджанці."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki naturalist:capture_net\"}}]"
	]
	quest.19409746A6FD9BCC.title: "Сачок для звірів"
	quest.19662D7C24479FE2.quest_desc: [
		"Fish of Thieves населяє води рибами з характером: &aсплештейли&r, &aпондії&r, &aайлгопери&r, &aштормові риби&r, що клюють лише в грозу, і рідкісні &aдревньолуські&r."
		"&aГачки&r Hybrid Aquatic у другій руці пришвидшують риболовлю вдень (колючий) чи вночі (світний), а &aмагнітний&r — частіше дає скарби."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.fishofthieves.splashtail\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.fishofthieves.pondie\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.fishofthieves.islehopper\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.fishofthieves.splashtail\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.fishofthieves.splashtail\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.fishofthieves.pondie\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.fishofthieves.pondie\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.fishofthieves.islehopper\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.fishofthieves.islehopper\", \"color\": \"white\"}]"
		""
		"&6Порада:&r у &aморській пошті&r (Компас дослідника → «seapost») можна поповнити запаси й знайти наживку."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki fishofthieves:splashtail\"}}]"
	]
	quest.19662D7C24479FE2.title: "Риби семи морів"
	quest.1977A2F5CCCCECFA.quest_desc: [
		"&aЖорна&r мелють зерно на борошно й руду на подрібнену руду. Подрібнена руда після промивки дає більше злитків, ніж сира."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.millstone\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.millstone\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:millstone\"}}]"
	]
	quest.1977A2F5CCCCECFA.title: "Жорна й дроблення"
	quest.197B1013DBBCFA4B.quest_desc: [ ]
	quest.197B1013DBBCFA4B.title: "Рідкісні чорнила"
	quest.19CA5557CF2E3052.quest_desc: [
		"У світі змінюються &eпори року&r (Serene Seasons): весна, літо, осінь, зима. Взимку частина культур не росте, а листя змінює колір."
		""
		"&aКалендар&r показує поточну пору й день. Наведіть у JEI на насіння — у підказці видно, в які сезони воно росте."
		"&6Порада:&r теплиці (культури під дахом зі скла) ростуть цілий рік."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.sereneseasons.calendar\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.sereneseasons.calendar\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki sereneseasons:calendar\"}}]"
	]
	quest.19CA5557CF2E3052.title: "Пори року"
	quest.19DEA2F58FA143A2.quest_desc: [
		"&6Король-вигнанець Мстислав&r, король без королівства &8(доручення 1 з 5)&r:"
		"&o«Колись я був королем. Тепер у мене троє вірних людей, один кінь і жодного меча, що не зламався б об першого розбійника.»&r"
		"&o«Перш ніж просити в когось більшого, я маю озброїти тих, хто лишився зі мною. Три залізні мечі — небагато для королівства, але це початок.»&r"
		"&fПринесіть три залізні мечі. Я заплачу тим, що врятував зі скарбниці."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", 80 досвіду, 40 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.iron_sword\", \"color\": \"aqua\"}, {\"text\": \" ×3\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.minecraft.iron_sword\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"apotheosis: sized upgrade recipe, верстак\", \"color\": \"white\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.guardvillagers.guard\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.minecolonies.chiefbarbarian\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:iron_sword\"}}]"
	]
	quest.19DEA2F58FA143A2.title: "Зброя для дружини"
	quest.1A097EB5195DD26E.quest_desc: [
		"&6Тарас&r, мандрівний бард &8(доручення 3 з 3)&r:"
		"&o«Я склав баладу про вас! Про те, як ви знайшли мені інструмент, а потім співучий кристал... Ну, трохи прикрасив, звісно: там ще є дракон.»&r"
		"&o«Щоб її чули й без мене, мені потрібен програвач. Запишу баладу на платівку — і вона житиме довше за мене.»&r"
		"&fПринесіть програвач."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.music_disc_otherside\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×10\", \"color\": \"gray\"}, {\"text\": \", 180 досвіду, 70 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.jukebox\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecraft.jukebox\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:jukebox\"}}]"
	]
	quest.1A097EB5195DD26E.title: "Сцена для барда"
	quest.1A655C74CC018367.quest_desc: [
		"&6Корній&r, картограф-невдаха:"
		"&o«Я картограф. Точніше, був ним, поки не з'ясувалося, що всі мої мапи — неправильні. Я малював їх із чужих розповідей, бо боюся вийти за ворота.»&r"
		"&o«Купці подали на мене в суд. Мені потрібні справжні мапи — з цих країв. Хоч три, щоб показати суддям.»&r"
		"&fНамалюйте три мапи — порожню мапу візьміть у руки, ходіть, і вона сама промалюється. Принесіть мені три заповнені."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.compass\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.spyglass\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.paper\", \"color\": \"aqua\"}, {\"text\": \" ×16\", \"color\": \"gray\"}, {\"text\": \", 140 досвіду, 50 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.filled_map\", \"color\": \"aqua\"}, {\"text\": \" ×3\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:filled_map\"}}]"
	]
	quest.1A655C74CC018367.title: "Мапа в нікуди"
	quest.1A80E0B75FE45763.quest_desc: [
		"&6Панас&r, дзвонар &8(доручення 1 з 3)&r:"
		"&o«Сто років наш дзвін скликав село на свята й на пожежі. Тиждень тому розбійники зняли його з дзвіниці — кажуть, мідь дорого продається в місті.»&r"
		"&o«Без дзвона старі не чують, коли біда. А я — дзвонар без дзвона, то й не знаю, навіщо прокидаюся.»&r"
		"&fНовий дзвін можна виміняти в жителів інших сіл чи знайти на їхніх майданах. Принесіть мені будь-який — підвішу, освятимо."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×10\", \"color\": \"gray\"}, {\"text\": \", 120 досвіду, скриня здобичі, 40 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.bell\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:bell\"}}]"
	]
	quest.1A80E0B75FE45763.title: "Вкрадений дзвін"
	quest.1A860B113ED91254.quest_desc: [
		"Посеред океану дрейфують кораблі: фрегати, галеони, корвети корсарів і корабель-привид із нежиттю. Зачистіть палубу, і трюм ваш."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Знайти споруду: \", \"color\": \"gray\"}, {\"translate\": \"wilds_wiki.structure.dungeons_arise.undead_pirate_ship\", \"color\": \"gold\"}]"
		""
		"&6Де:&r відкритий океан, далеко від берега."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r лук, щит, зілля підводного дихання (якщо впадете за борт)"
		"&6Як знайти:&r Компас дослідника → «undead_pirate_ship», «victory_frigate», «unicorn_galleon», «corsair_corvette»."
		"&6Порада:&r підпливайте з навітряного боку і стріляйте з гармат, поки екіпаж не вибіг на палубу."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:skeleton_skull\"}}]"
	]
	quest.1A860B113ED91254.title: "Піратський корабель"
	quest.1AA805516D7E7EE7.quest_desc: [
		"&6Тарас&r, мандрівний бард &8(доручення 1 з 3)&r:"
		"&o«Я співав по корчмах від моря до гір, поки в останній не програв свою лютню в кості. Ну, не програв — її в мене вкрали, поки я спав, і продали заїжджим купцям.»&r"
		"&o«Без інструмента я ніхто: ні хліба, ні ночівлі. Нову лютню мені не скласти, а от нотний блок... з нього можна видобути звук не гірший.»&r"
		"&fЗнайдіть чи змайструйте мені нотний блок — дерево й червоний пил, нічого складного для вмілих рук."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.music_disc_cat\", \"color\": \"aqua\"}, {\"text\": \"\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×4\", \"color\": \"gray\"}, {\"text\": \", 100 досвіду, 40 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.note_block\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecraft.note_block\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:note_block\"}}]"
	]
	quest.1AA805516D7E7EE7.title: "Загублена лютня"
	quest.1AEB4D1DDAB1D650.quest_desc: [
		"&aДикі&r (Wilden) — звірі, зіткані з джерела: мисливці, вартові, переслідувачі. Їхні роги, шипи й крила потрібні для сильних рецептів."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.wilden_horn\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.wilden_spike\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.wilden_wing\", \"color\": \"aqua\"}, {\"text\": \" ×2\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ars_nouveau.wilden_horn\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.ars_nouveau.wilden_hunter\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ars_nouveau.wilden_spike\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.ars_nouveau.wilden_guardian\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ars_nouveau.wilden_wing\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.ars_nouveau.wilden_stalker\", \"color\": \"white\"}]"
		""
		"&6Де:&r лігва диких — у лісах і горах (Компас дослідника: «Лігво дикого...»)"
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:wilden_horn\"}}]"
	]
	quest.1AEB4D1DDAB1D650.title: "Дикі"
	quest.1B27A9A24C6E41BE.quest_desc: [
		"&6Галина&r, пастушка &8(доручення 2 з 2)&r:"
		"&o«Вовків більше нема, але стара кошара — сама діра на дірі. Наступні хижаки пролізуть так само.»&r"
		"&o«Двадцять чотири прольоти дубового паркану — і жоден вовк не підкопається.»&r"
		"&fПринесіть двадцять чотири дубові паркани."
		""
		"[\"\", {\"text\": \"Обіцяна плата: \", \"color\": \"gold\"}, {\"translate\": \"item.minecraft.lead\", \"color\": \"aqua\"}, {\"text\": \" ×2\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.white_wool\", \"color\": \"aqua\"}, {\"text\": \" ×16\", \"color\": \"gray\"}, {\"text\": \", \", \"color\": \"gray\"}, {\"translate\": \"item.minecraft.emerald\", \"color\": \"aqua\"}, {\"text\": \" ×6\", \"color\": \"gray\"}, {\"text\": \", 100 досвіду, 40 очок шляху\", \"color\": \"gray\"}]"
		"&7Плату видає замовник: поверніться до нього, коли виконаєте."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecraft.oak_fence\", \"color\": \"aqua\"}, {\"text\": \" ×24\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecraft.oak_fence\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:oak_fence\"}}]"
	]
	quest.1B27A9A24C6E41BE.title: "Нова кошара"
	quest.1B55A44445E9790E.quest_desc: [ ]
	quest.1B55A44445E9790E.title: "Стрижні іфритів"
	quest.1B7E6174F0EAD301.quest_desc: [
		"Знайдіть попелясті пустища й кварцові рівнини — два з восьми біомів Incendium. Кожен небезпечний по-своєму:"
		" • &7Попелясті пустища&r — тут стоїть Заборонений замок;"
		" • &eПекельні дюни&r — пустельні іфрити;"
		" • &fКварцові рівнини&r — застигла лава, Санктум і Кварцова кухня;"
		" • &aОтруйне звалище&r — радіація й отруйні слизні;"
		" • &6Вулканічні дельти&r — давні уламки просто на поверхні."
		""
		"Біом показує мінімапа й F3; вікі (O) має статтю про кожен."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Побувати в біомі: \", \"color\": \"gray\"}, {\"translate\": \"biome.incendium.ash_barrens\", \"color\": \"green\"}]"
		"[\"\", {\"text\": \"• Побувати в біомі: \", \"color\": \"gray\"}, {\"translate\": \"biome.incendium.quartz_flats\", \"color\": \"green\"}]"
		""
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Як знайти:&r Компас природи (Nature's Compass) знайде біом за назвою."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:crimson_nylium\"}}]"
	]
	quest.1B7E6174F0EAD301.title: "Вісім нових біомів"
	quest.1BD29F9EBE206381.quest_desc: [
		"Ця книга веде вас крізь увесь світ збірки: від першого верстата до драконів і машин."
		""
		"Відкрийте її клавішею &aJ&r (або кнопкою з книгою в інвентарі). Ліворуч — розділи, кожен квест — короткий гайд: що зробити, де шукати, навіщо."
		"Квести, які ви хочете бачити на екрані, закріпіть: відкрийте квест і натисніть кнопку з шпилькою."
		""
		"&6Як:"
		"&71.&r Натисніть &aJ&r."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:book\"}}]"
	]
	quest.1BD29F9EBE206381.quest_subtitle: "Клавіша J"
	quest.1BD29F9EBE206381.title: "Книга квестів"
	quest.1C219BA2A7F29E2F.quest_desc: [
		"&aРитуальна жаровня&r виконує ритуали з табличок: світанок, політ, урожай, відновлення, дощ... Поставте табличку на жаровню й подайте джерело."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.ars_nouveau.ritual_brazier\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.ritual_sunrise\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.ritual_flight\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.ars_nouveau.ritual_brazier\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ars_nouveau.ritual_sunrise\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ars_nouveau.ritual_flight\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:ritual_brazier\"}}]"
	]
	quest.1C219BA2A7F29E2F.title: "Ритуали"
	quest.1C3126CB24BA3232.quest_desc: [ ]
	quest.1C3126CB24BA3232.title: "Сцена для барда"
	quest.1C89EB51D23F6C42.quest_desc: [
		"Поселенцям потрібні &aОселі&r (у кожній — ліжка) і їжа. &aЇдальня&r з кухарем годує всіх; голодні поселенці працюють повільно і хворіють."
		"&dЗв'язок світу:&r їжа Farmer's Delight та інших модів кухні добре підходить поселенцям."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecolonies.blockhutcitizen\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.minecolonies.blockhutcook\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.minecolonies.blockhutcitizen\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.minecolonies.blockhutcook\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecolonies:blockhutcitizen\"}}]"
	]
	quest.1C89EB51D23F6C42.title: "Оселі й їдальня"
	quest.1CB07DC2B5AAB67F.quest_desc: [
		"&aДзеркало&r зі сховища міста Енду переносить до &aмагнетиту&r: клацніть дзеркалом по магнетиту, заправте його небулітом — і повертайтеся додому будь-коли."
		""
		"Зачарування «Міжвимірність» дозволяє переноситися навіть з іншого виміру."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.enderscape.mirror\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki enderscape:mirror\"}}]"
	]
	quest.1CB07DC2B5AAB67F.title: "Дзеркало"
	quest.1CF1DCB1CC1D0A6D.quest_desc: [
		"Ліч ховається за щитами і кидає вогняні кулі. &eВідбивайте кулі мечем назад&r — кожне влучання збиває щит. Потім він кличе копії й зомбі, а наприкінці б'ється врукопашну."
		"Нагорода: три &aскіпетри&r (Сутінків, зомбі, викрадання життя) і золоті обладунки."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.twilightforest.lich\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aВежа ліча&r — висока вежа з кам'яної цегли в Сутінковому лісі; нагорі тронна зала."
		"&6Складність:&r &c★★★&8★★&r — небезпечно"
		"&6Спорядження:&r залізо чи краще, лук зі стрілами для копій, зілля зцілення"
		"&6Як знайти:&r Магічна мапа (значок черепа) або Компас дослідника → «lich_tower»."
		"&6Порада:&r справжній ліч один — у нього щити. Копії падають від одного удару."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:twilightforest:lich\"}}]"
	]
	quest.1CF1DCB1CC1D0A6D.title: "Сутінковий ліч"
	quest.1D12A470F162C870.quest_desc: [ ]
	quest.1D12A470F162C870.title: "Звір облоги"
	quest.1D286D1EBB388212.quest_desc: [
		"Easy Villagers дозволяє підняти селянина: присядьте й клацніть по ньому порожньою рукою. Селянина в кишені можна посадити в блок:"
		" • &aторговець&r — торгівля в одному блоці; &aавтоторговець&r — сам міняє з воронки;"
		" • &aфермер&r — вирощує культури; &aрозплідник&r — народжує нових селян;"
		" • &aперетворювач&r — лікує зомбі-селян; &aзалізна ферма&r — дає залізо."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.easy_villagers.trader\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.easy_villagers.trader\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Порада:&r так селян легко перевезти в колонію чи свою базу без доріг і човнів."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki easy_villagers:trader\"}}]"
	]
	quest.1D286D1EBB388212.title: "Селянин у кишені"
	quest.1D5AB9A762B32352.quest_desc: [
		"Вітаємо у &6Wilds \\& Wanderers&r! Це великий світ із драконами, динозаврами, магією, машинами й десятками підземель."
		""
		"&eГоловні клавіші:&r &aJ&r — квести, &aO&r — вікі, &aK&r — навички, &aM&r — мапа, &aB&r — ранець, &aG&r — аксесуари, &aH&r — журнал доручень, &aHome&r — браузер."
		""
		" • &aR&r над предметом у JEI (праворуч в інвентарі) — як його скрафтити; &aU&r — де він використовується."
		" • Наведіть приціл на блок чи моба — зверху з'явиться підказка &aJade&r."
		" • Над будь-яким механізмом Create затисніть &aW&r — відкриється анімований посібник &aPonder&r."
		""
		"Розділ «Перші кроки» по черзі показує кожен інтерфейс. Щоб виконати цей квест, натисніть галочку праворуч."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki minecraft:compass\"}}]"
	]
	quest.1D5AB9A762B32352.quest_subtitle: "Прочитайте мене першим"
	quest.1D5AB9A762B32352.title: "Початок мандрівки"
	quest.1D696DEEF922B491.quest_desc: [
		"Applied Mekanistics додає &aхімічні диски&r: гази й рідкі хімікати Mekanism зберігаються в тій самій мережі."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.appmek.chemical_storage_cell_1k\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.appmek.chemical_storage_cell_1k\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki appmek:chemical_storage_cell_1k\"}}]"
	]
	quest.1D696DEEF922B491.title: "AE2 і хімія Mekanism"
	quest.1D9FEE7CF036927F.quest_desc: [
		"&aШина імпорту&r затягує предмети з машин і скринь у мережу, &aшина експорту&r віддає, &aшина сховища&r показує вміст скрині як частину мережі. Так мережа з'єднується з печами й машинами Create чи Mekanism."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.import_bus\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.export_bus\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.storage_bus\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ae2.import_bus\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ae2.export_bus\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ae2.storage_bus\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ae2:import_bus\"}}]"
	]
	quest.1D9FEE7CF036927F.title: "Шини"
	quest.1DB2FA86AFBD563B.quest_desc: [
		"&aСцилла&r — морська владарка бурі з Катаклізму. Б'є блискавками, хвилями й списом-тризубом. Захист від блискавки й вода довкола роблять бій важким — беріть зілля й щит. Нагорода — &aесенція бурі&r і її зброя."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.cataclysm.scylla\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aАкрополь&r — храм на острові серед океану."
		"&6Складність:&r &c★★★★★&8&r — смертельно"
		"&6Спорядження:&r незеритова броня, громовідводи навколо поля бою не завадять"
		"&6Як знайти:&r &aОко бурі&r (призмарин, громовідвід, алмази, око Енду) або Компас дослідника → «acropolis»."
		"&6Порада:&r не бийтеся у воді: хвилі збивають з ніг."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:cataclysm:scylla\"}}]"
	]
	quest.1DB2FA86AFBD563B.title: "Сцилла"
	quest.1DDC0C4ED2079852.quest_desc: [ ]
	quest.1DDC0C4ED2079852.title: "Підземелля скелетів"
	quest.1DF674E467619582.quest_desc: [ ]
	quest.1DF674E467619582.title: "Міст троля"
	quest.1E310B523930CF1F.quest_desc: [
		"Найпотужніше джерело сили: бак із водою, під ним пальники іфритів, збоку — &aпарові двигуни&r. Чим більший бак і більше пальників — тим вищий рівень котла."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.steam_engine\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.create.fluid_tank\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.create.steam_engine\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.fluid_tank\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"&6Як:"
		"&71.&r Збудуйте бак з 4+ блоків, наповніть водою помпою."
		"&72.&r Під баком — пальники іфритів з паливом."
		"&73.&r Двигун прикріпіть до стінки бака, перед ним — вал."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki create:steam_engine\"}}]"
	]
	quest.1E310B523930CF1F.title: "Паровий двигун"
	quest.1E576DF52769FB90.quest_desc: [ ]
	quest.1E576DF52769FB90.title: "Той, хто кличе"
	quest.1EDC12F3B3E54499.quest_desc: [
		"&aВисікач&r штампує пресами друковані плати й складає з них три процесори: &aлогічний&r (золото), &aрозрахунковий&r (кварц), &aінженерний&r (алмаз)."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.ae2.inscriber\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.silicon\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.logic_processor\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.calculation_processor\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ae2.engineering_processor\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.ae2.inscriber\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ae2.silicon\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Mekanism: подрібнювач, Mekanism: збагачувач, доменна піч\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ae2.logic_processor\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"AE2: висікач\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ae2:inscriber\"}}]"
	]
	quest.1EDC12F3B3E54499.title: "Висікач і процесори"
	quest.1F2890B34D4C0D30.quest_desc: [
		"&aРуни&r — основа магічного спорядження кожної школи: вогняна, крижана, блискавична, світла, природи, енду, крові, закликання."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.irons_spellbooks.blank_rune\", \"color\": \"aqua\"}, {\"text\": \" ×4\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.irons_spellbooks.fire_rune\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.irons_spellbooks.ice_rune\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.irons_spellbooks.blank_rune\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"падає з: \", \"color\": \"gray\"}, {\"translate\": \"entity.irons_spellbooks.dead_king\", \"color\": \"white\"}, {\"text\": \", \"}, {\"translate\": \"entity.irons_spellbooks.fire_boss\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.irons_spellbooks.fire_rune\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.irons_spellbooks.ice_rune\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki irons_spellbooks:blank_rune\"}}]"
	]
	quest.1F2890B34D4C0D30.title: "Руни шкіл"
	quest.1F494230CFE55225.quest_desc: [ ]
	quest.1F494230CFE55225.title: "Загублена лютня"
	quest.1F6601F83CC123DE.quest_desc: [
		"&aКамера насичення&r вливає джерело в аметист чи лазурит — виходить &aкамінь джерела&r, основа майже всіх магічних речей Ars."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.ars_nouveau.imbuement_chamber\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.source_gem\", \"color\": \"aqua\"}, {\"text\": \" ×8\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"block.ars_nouveau.imbuement_chamber\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ars_nouveau.source_gem\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"Ars: камера насичення, верстак\", \"color\": \"white\"}]"
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki ars_nouveau:imbuement_chamber\"}}]"
	]
	quest.1F6601F83CC123DE.title: "Камінь джерела"
	quest.1F7CF4639F4C3D2F.quest_desc: [
		"Два кільця з &aквантових кілець&r і &aкамерами квантового зв'язку&r з'єднують мережі будь-де — навіть у різних вимірах."
		""
		"&eЗавдання:"
