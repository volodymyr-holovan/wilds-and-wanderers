		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.ae2.crafting_unit\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"block.ae2.4k_crafting_storage\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
		"&6Де взяти:"
		"[\"\", {\"translate\": \"item.ae2.pattern_encoding_terminal\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"item.ae2.blank_pattern\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.ae2.pattern_provider\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
