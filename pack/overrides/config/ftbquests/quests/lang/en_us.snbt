	]
	quest.1FC00F951778BFCB.title: "Бур і жатка"
	quest.1FE73C1622B549CC.quest_desc: [
		"Майстер каменю чекає на вершині кам'яного шпиля. Щоб дістатися до нього, треба вибігти нагору його випробуванням, поки він здіймає колони й кидає брили. Нагорода — &aрукавиця, що розколює землю&r."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Перемогти: \", \"color\": \"gray\"}, {\"translate\": \"entity.mowziesmobs.sculptor\", \"color\": \"red\"}, {\"text\": \"\"}]"
		""
		"&6Де:&r &aМонастир&r Скульптора — кам'яний храм у горах."
		"&6Складність:&r &c★★★★&8★&r — дуже небезпечно"
		"&6Спорядження:&r легка броня (тут важлива спритність), зілля стрибків"
		"&6Як знайти:&r Компас дослідника → «mowziesmobs:monastery»."
		"&6Порада:&r падіння — найчастіша смерть тут; поставте поруч точку відродження."
		""
		"[\"\", {\"text\": \"➜ Відкрити у вікі\", \"color\": \"dark_aqua\", \"underlined\": true, \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/wiki entity:mowziesmobs:sculptor\"}}]"
	]
	quest.1FE73C1622B549CC.title: "Скульптор"
	quest.1FFB73BC2F7FCF54.quest_desc: [
		"Дригмі, віхі й віхляк — разом вони дають здобич мобів без убивств, зілля й нескінченні рослини."
		""
		"&eЗавдання:"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.drygmy_charm\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.whirlisprig_charm\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		"[\"\", {\"text\": \"• Мати в інвентарі: \", \"color\": \"gray\"}, {\"translate\": \"item.ars_nouveau.wixie_charm\", \"color\": \"aqua\"}, {\"text\": \"\"}]"
		""
