		"[\"\", {\"translate\": \"block.create.mechanical_drill\", \"color\": \"aqua\"}]"
		"[\"\", {\"text\": \"   \"}, {\"text\": \"робиться: \", \"color\": \"gray\"}, {\"text\": \"верстак\", \"color\": \"white\"}]"
		"[\"\", {\"translate\": \"block.create.mechanical_harvester\", \"color\": \"aqua\"}]"
